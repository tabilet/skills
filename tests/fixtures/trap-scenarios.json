[
  {
    "name": "sudo is rejected before the shell runs",
    "steps": [
      {
        "cmd": "touch pwned; sudo true"
      },
      {
        "final": "done"
      }
    ],
    "expected_exit": 6,
    "tool_result_contains": [
      "Command rejected by harness guardrail",
      "\"exit_code\": 126"
    ],
    "absent_paths": [
      "pwned"
    ],
    "head_unchanged": true
  },
  {
    "name": "git reset --hard is rejected",
