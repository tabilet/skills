        def table_row_adverse(line, header=False):
            # Iteration history is not a verdict, but a row for the final or a
            # later iteration, or a cell that states a reversal, is. A header
            # (the row before a delimiter row) holds labels: it is still checked
            # for counters and reversals, but its labels raise no warning.
            cells = [cell.strip() for cell in line.strip().strip('|').split('|')]
            if all(not cell or _TABLE_DELIMITER_CELL.fullmatch(cell) for cell in cells):
                return False
            if header:
                text = ' '.join(cells)
                # A label is short and unpunctuated; a cell of four or more
                # words, or one ending as a sentence ("Withheld."), states something.
                sentence = any(len(cell.split()) >= 4 or re.search(r'\w[.!?]$', cell) for cell in cells)
                return (counter_conflict(text) or adverse_review_wording(text, final_iteration, True, True)
                        or unrecognized_review_sentence(text, True, warn=sentence))
            if counter_conflict(' '.join(cells[1:])):
                return True
            rest = ' '.join(cells[1:])
            first = re.fullmatch(r'(?:iteration\s+)?([1-9][0-9]*)', cells[0], re.I)
            verdict = re.match(r'\s*(PASS(?:ED)?|FAIL\w*|pending|incomplete|blocked)\b\W*', rest, re.I)
