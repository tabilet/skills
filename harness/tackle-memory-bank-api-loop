def _table_cells(line: str) -> list[str]:
    """Split a Markdown table row, honoring escaped pipe characters."""

    cells = []
    current = []
    index = 0
    while index < len(line):
        char = line[index]
        if char == "\\" and index + 1 < len(line) and line[index + 1] == "|":
            current.append("|")
            index += 2
            continue
        if char == "|":
            cells.append("".join(current).strip())
            current = []
        else:
            current.append(char)
        index += 1
    cells.append("".join(current).strip())
    if cells and not cells[0]:
        cells.pop(0)
    if cells and not cells[-1]:
        cells.pop()
    return cells


def unfenced_lines(text: str):
    """Yield source lines outside fenced blocks, retaining their line numbers."""
    fence_char = ""
    fence_length = 0
    for line_number, line in enumerate(text.splitlines(), 1):
        stripped = line.lstrip(" ")
        indent = len(line) - len(stripped)
        fence = re.match(r"(`{3,}|~{3,})", stripped) if indent <= 3 else None
        if fence:
            token = fence.group(1)
            if not fence_char:
                fence_char = token[0]
                fence_length = len(token)
            elif (token[0] == fence_char and len(token) >= fence_length
                  and not stripped[len(token):].strip()):
                fence_char = ""
                fence_length = 0
            continue
        if not fence_char and indent <= 3:
            yield line_number, stripped


def table_rows(text: str) -> list[dict]:
    rows = []
    for line_number, stripped in unfenced_lines(text):
        if not stripped.startswith("|"):
            continue
        cells = _table_cells(stripped)
        if len(cells) < 2:
            continue
        rows.append({"cells": cells, "line": line_number})
    return rows


def status_rows(status: str) -> list[dict]:
    """Read state-bearing rows from Markdown tables outside fenced blocks."""
    rows = []
    for row in table_rows(status):
        cells = row["cells"]
        state = STATE_MARKERS.get(cells[1])
        if state:
            rows.append(
                {
                    "item": cells[0],
                    "state": state,
                    "cells": cells,
                    "line": row["line"],
                }
            )
    return rows


def actionable_rows(status: str) -> list[dict]:
    return [row for row in status_rows(status) if row["state"] in ACTIONABLE_STATES]


def blocked_rows(status: str) -> list[dict]:
    return [row for row in status_rows(status) if row["state"] == "blocked"]


def status_marker_problems(status: str) -> list[str]:
    """Reject malformed state cells without interpreting unrelated prose tables."""
    problems = []
    in_task_table = False
    previous_line = 0
    for row in table_rows(status):
        cells = row["cells"]
        if row["line"] != previous_line + 1:
            in_task_table = False
        previous_line = row["line"]
        state = cells[1]
        if state.lower() == "state":
            in_task_table = True
            continue
        if all(re.fullmatch(r":?-+:?", cell) for cell in cells):
            continue
        # Full task tables validate every state cell, including blank/textual
        # states. Headerless rows with a task-shaped marker are checked too.
        if (in_task_table or re.search(r"\[[^\]]*\]", state)) and state not in STATE_MARKERS:
            problems.append(f"line {row['line']}: unknown or non-backticked state marker")
    return problems


def fenced_document(section: str) -> str:
    """Unwrap one literal Markdown document without interpreting its headings."""
    lines = section.strip().splitlines(keepends=True)
    opening = re.fullmatch(r"(`{3,}|~{3,})markdown", lines[0].strip()) if lines else None
    if not opening or len(lines) < 3:
        raise ValueError("expected one fenced markdown document")
    fence = opening.group(1)
    closing = re.compile(re.escape(fence[0]) + "{" + str(len(fence)) + r",}\s*")
    if not closing.fullmatch(lines[-1]) or any(closing.fullmatch(line) for line in lines[1:-1]):
        raise ValueError("document fence closes early or is missing")
    return "".join(lines[1:-1])


def retired_record(text: str, name: str) -> dict:
    """Validate the portable retirement envelope; original documents stay literal."""
    if not re.fullmatch(r"status-[A-Z](?:0[1-9]|[1-9][0-9])\.md", name):
        raise ValueError("invalid retired status ID; use 01 through 99")
    milestone_id = name.removeprefix("status-").removesuffix(".md")
    lines = text.splitlines(keepends=True)
    headings = [(n, line[3:]) for n, line in unfenced_lines(text) if line.startswith("## ")]
    if [title for _, title in headings] != ["Milestone specification", "Status record"]:
        raise ValueError("expected Milestone specification and Status record sections")
    metadata = {}
    for _, line in unfenced_lines("".join(lines[:headings[0][0] - 1])):
        match = re.fullmatch(r"\*\*([\w ]+)\.\*\* (.+)", line)
        if match:
            key, value = match.groups()
            if key in metadata:
                raise ValueError(f"duplicate retirement field: {key}")
            metadata[key] = value.strip()
    required = (
        "Milestone", "Outcome", "Retired", "Source status", "Source specification",
        "Evidence", "Worktree", "Review", "Review iterations", "Verification", "Consolidated into",
    )
    if any(not metadata.get(key) for key in required):
        raise ValueError("missing retirement metadata")
    if metadata["Milestone"] != milestone_id:
        raise ValueError("retired milestone ID does not match its filename")
    if metadata["Source status"] not in {f"tabilet/memory-bank/{name}", f"memory-bank/{name}"}:
        raise ValueError("source status path does not match the retired ID")
    if not re.fullmatch(r"(?:tabilet/)?memory-bank/milestone\.md#\S+", metadata["Source specification"]):
        raise ValueError("missing original milestone specification anchor")
    if metadata["Outcome"] not in {"completed", "cancelled", "superseded"}:
        raise ValueError("invalid retirement outcome")
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", metadata["Retired"]):
        raise ValueError("retirement date must use YYYY-MM-DD")
    datetime.date.fromisoformat(metadata["Retired"])
    if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64}|unversioned)", metadata["Evidence"]):
        raise ValueError("evidence must be a full commit or unversioned")
    if metadata["Worktree"] not in {"clean", "includes uncommitted changes", "unversioned"}:
        raise ValueError("invalid worktree provenance")
    if (metadata["Evidence"] == "unversioned") != (metadata["Worktree"] == "unversioned"):
        raise ValueError("inconsistent unversioned provenance")
    if metadata["Review"] != "passed" or not re.fullmatch(r"(?:[1-9]|10)", metadata["Review iterations"]):
        raise ValueError("retirement requires a passed review within 10 iterations")
    if metadata["Outcome"] != "completed" and not metadata.get("Disposition"):
        raise ValueError("cancellation or supersession needs its authorized disposition")
    if metadata["Outcome"] == "superseded" and not metadata.get("Successor"):
        raise ValueError("supersession needs its accepted successor")
    specification = fenced_document("".join(lines[headings[0][0]:headings[1][0] - 1]))
    status = fenced_document("".join(lines[headings[1][0]:]))
    if not specification.strip() or not status.strip():
        raise ValueError("retired source documents are empty")
    spec_headings = [line for _, line in unfenced_lines(specification) if line.startswith("## ")]
    if len(spec_headings) != 1 or not re.match(
        r"## " + re.escape(milestone_id) + r"(?:\s|$)", spec_headings[0]
    ):
        raise ValueError("retired specification does not match its milestone ID")
    rows = status_rows(status)
    if problems := status_marker_problems(status):
        raise ValueError("retired task has an " + "; ".join(problems))
    if not rows or any(row["state"] in {"pending", "in_progress", "blocked"} for row in rows):
        raise ValueError("retired status must contain only closed task rows")
    for row in rows:
        if row["state"] == "historical" and not re.search(
            r"\bsuccessor\b\s*:?\s+\S", " ".join(row["cells"][2:]), re.I
        ):
            raise ValueError("closed-historical row has no named successor")
    return {"metadata": metadata, "specification": specification, "status": status}


def history_snapshot(repo: pathlib.Path) -> dict:
    history = repo / "tabilet" / "docs" / "history"
    records, digests, problems = {}, {}, []
    paths = sorted(history.glob("status-*.md"))
    for path in paths:
        try:
            if path.is_symlink() or not re.fullmatch(r"status-[A-Z][0-9]{2}\.md", path.name):
                raise ValueError("invalid retired filename or symlink")
            raw = path.read_bytes()
            records[path.name] = retired_record(raw.decode("utf-8"), path.name)
            digests[path.name] = hashlib.sha256(raw).hexdigest()
        except (ValueError, OSError) as exc:
            problems.append(f"tabilet/docs/history/{path.name}: {exc}")
    index_path = history / "index.md"
    index = index_path.read_text(encoding="utf-8") if index_path.is_file() else ""
    entries = {}
    for row in table_rows(index):
        cells = row["cells"]
        if not re.fullmatch(r"[A-Z][0-9]{2}", cells[0]):
            continue
        name = f"status-{cells[0]}.md"
        if name in entries:
            problems.append(f"duplicate history index ID: {cells[0]}")
        entries[name] = cells
        if name not in records:
            problems.append(f"history index record is missing or invalid: {name}")
    milestone_path = repo / "tabilet" / "memory-bank" / "milestone.md"
    milestone = milestone_path.read_text(encoding="utf-8") if milestone_path.is_file() else ""
    milestone_lines = list(unfenced_lines(milestone))
    spec_ids = {
        match.group(1) for _, line in milestone_lines
        if (match := re.match(r"^## ([A-Z][0-9]{2})(?:\s|$)", line))
    }
    index_ids = set()
    for row in table_rows(milestone):
        first = row["cells"][0].strip("` ")
        linked_id = re.fullmatch(r"\[([A-Z][0-9]{2})\]\([^)]*\)", first)
        index_ids.add(linked_id.group(1) if linked_id else first)
    live = {p.name for p in status_files(repo)}
    for milestone_id in spec_ids | index_ids:
        if re.fullmatch(r"[A-Z][0-9]{2}", milestone_id):
            name = f"status-{milestone_id}.md"
            if name not in live and name not in records:
                problems.append(f"active milestone has no status record: {milestone_id}")
    for name, record in records.items():
        meta = record["metadata"]
        cells = entries.get(name, [])
        if len(cells) != 5 or cells[1:3] != [meta["Outcome"], meta["Retired"]] or not re.fullmatch(
            r"\[[^\]]+\]\(" + re.escape(name) + r"\)", cells[3]
        ):
            problems.append(f"missing or inconsistent history index entry: {name}")
        if name in live:
            problems.append(f"duplicate active/retired ID: {meta['Milestone']}")
        if meta["Milestone"] in spec_ids:
            problems.append(f"retired specification remains active: {meta['Milestone']}")
        if meta["Milestone"] in index_ids:
            problems.append(f"retired index row remains active: {meta['Milestone']}")
    history_links = re.findall(
        r"\[[^\]]+\]\(\.\./docs/history/index\.md\)",
        "\n".join(line for _, line in milestone_lines),
    )
    if records and len(history_links) != 1:
        problems.append("milestone.md must have exactly one history-index link")
    journal_path = history / "knowledge.md"
    journal = journal_path.read_bytes() if journal_path.is_file() else b""
    return {
        "records": records, "digests": digests, "entries": entries,
        "journal": journal, "problems": problems,
    }


def milestone_specifications(repo: pathlib.Path) -> dict[str, str | None]:
    path = repo / "tabilet" / "memory-bank" / "milestone.md"
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    lines = text.splitlines(keepends=True)
    headings = [(n, line) for n, line in unfenced_lines(text) if line.startswith("## ")]
    specifications = {}
    for index, (start, heading) in enumerate(headings):
        match = re.match(r"## ([A-Z][0-9]{2})(?:\s|$)", heading)
        if match:
            end = headings[index + 1][0] - 1 if index + 1 < len(headings) else len(lines)
            name = f"status-{match.group(1)}.md"
            # A duplicate is ambiguous, not permission to silently choose one.
            specifications[name] = None if name in specifications else "".join(lines[start - 1:end])
    return specifications


def row_snapshot(repo: pathlib.Path) -> dict:
    states, cells, documents = {}, {}, {}
    history = history_snapshot(repo)
    # Validate required instructions again after each run; the model may have
    # removed or damaged them since the startup checks.
    for relative in ("AGENTS.md", "tabilet/memory-bank/milestone.md"):
        try:
            (repo / relative).read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            history["problems"].append(f"required project instructions unavailable: {relative}: {exc}")
    for path in sorted((repo / "tabilet" / "memory-bank").glob("status-*.md")):
        if path.is_symlink() or not re.fullmatch(r"status-[A-Z](?:0[1-9]|[1-9][0-9])\.md", path.name):
            history["problems"].append(f"invalid active status filename or symlink: {path.name}")
    documents.update({name: record["status"] for name, record in history["records"].items()})
    active = {p.name for p in status_files(repo)}
    documents.update({p.name: p.read_text(encoding="utf-8") for p in status_files(repo)})
    for name, document in documents.items():
        if name in active:
            if not status_rows(document):
                history["problems"].append(f"active status has no recognized task rows: {name}")
            history["problems"].extend(f"{name}: {problem}" for problem in status_marker_problems(document))
        occurrences: dict[str, int] = {}
        for row in status_rows(document):
            item = row["item"]
            occurrences[item] = occurrences.get(item, 0) + 1
            key = (name, item, occurrences[item])
            states[key] = row["state"]
            cells[key] = row["cells"]
    return {
        "files": set(documents), "states": states, "cells": cells,
        "documents": documents, "active": active, "history": history,
        "specifications": milestone_specifications(repo),
    }


def rows_in_state(repo: pathlib.Path, state: str) -> list[dict]:
    matches = []
    for path in status_files(repo):
        occurrences: dict[str, int] = {}
        for row in status_rows(path.read_text(encoding="utf-8")):
            item = row["item"]
            occurrences[item] = occurrences.get(item, 0) + 1
            if row["state"] == state:
                matches.append(
                    {
                        "file": path.name,
                        "item": item,
                        "line": row["line"],
                        "key": (path.name, item, occurrences[item]),
                    }
                )
    return matches


def validate_row_transition(
    before: dict, after: dict, required_key: tuple[str, str, int] | None = None
) -> list[str]:
    problems = list(after.get("history", {}).get("problems", []))
    old_history = before.get("history", {})
    new_history = after.get("history", {})
    for name, digest in old_history.get("digests", {}).items():
        if new_history.get("digests", {}).get(name) != digest:
            problems.append(f"previously retired record was changed or removed: {name}")
    for name, entry in old_history.get("entries", {}).items():
        if new_history.get("entries", {}).get(name) != entry:
            problems.append(f"previous history index entry was changed or removed: {name}")
    if not new_history.get("journal", b"").startswith(old_history.get("journal", b"")):
        problems.append("retired knowledge history was rewritten or removed")
    retired = set(new_history.get("records", {})) - set(old_history.get("records", {}))
    for name in retired - before["files"]:
        problems.append(f"new retired record has no pre-existing active owner: {name}")
    appended_knowledge = new_history.get("journal", b"")[len(old_history.get("journal", b"")):]
    for name in retired & before["files"]:
        original_spec = before.get("specifications", {}).get(name)
        retained_spec = new_history["records"][name]["specification"]
        if not original_spec:
            problems.append(f"retirement lacks an unambiguous original specification: {name}")
        elif original_spec.strip() not in retained_spec and original_spec.strip().encode() not in appended_knowledge:
            problems.append(f"retirement discarded original milestone specification: {name}")
    missing_files = before["files"] - after["files"]
    if missing_files:
        problems.append("status files were removed: " + ", ".join(sorted(missing_files)))

    transitions = []
    for key, old_state in before["states"].items():
        if key not in after["states"]:
            problems.append(f"status row was removed or renamed: {key[0]} / {key[1]!r}")
            continue
        new_state = after["states"][key]
        if new_state != old_state:
            transitions.append((key, old_state, new_state))
        elif key[0] in retired and before.get("cells", {}).get(key) != after.get("cells", {}).get(key):
            problems.append(f"retirement changed an earlier row or its notes: {key[0]} / {key[1]!r}")

    for key, state in after["states"].items():
        if key not in before["states"] and state != "pending":
            problems.append(
                f"new status row is not pending: {key[0]} / {key[1]!r} is {state}"
            )

    if len(transitions) != 1:
        problems.append(f"expected exactly one existing row state transition, found {len(transitions)}")
    else:
        key, old_state, new_state = transitions[0]
        if old_state not in ACTIONABLE_STATES or new_state not in RUN_TERMINAL_STATES:
            problems.append(
                f"invalid row transition in {key[0]} for {key[1]!r}: "
                f"{old_state} -> {new_state}"
            )
        if required_key is not None and key != required_key:
            problems.append(
                "the pre-existing in-progress row was not closed: "
                f"expected {required_key[0]} / {required_key[1]!r}"
            )
        for name in retired:
            if name != key[0]:
                problems.append(f"retirement is outside the current task's milestone: {name}")
        # Packaging preserves the original status prose and earlier rows. Only
        # the selected row may change; closure evidence can be appended.
        if key[0] in retired:
            original = before["documents"][key[0]]
            rows = status_rows(original)
            occurrences = 0
            selected_line = None
            for row in rows:
                if row["item"] == key[1]:
                    occurrences += 1
                    if occurrences == key[2]:
                        selected_line = row["line"]
            remaining = iter(after["documents"][key[0]].splitlines())
            for number, line in enumerate(original.splitlines(), 1):
                if number == selected_line:
                    continue
                if not any(candidate == line for candidate in remaining):
                    problems.append(f"retirement discarded original status content: {key[0]}")
                    break
    return problems


def lane_summary(repo: pathlib.Path) -> list[dict]:
    summary = []
    for path in status_files(repo):
        rows = status_rows(path.read_text(encoding="utf-8"))
        summary.append(
            {
                "file": path.name,
                "actionable": sum(row["state"] in ACTIONABLE_STATES for row in rows),
                "in_progress": sum(row["state"] == "in_progress" for row in rows),
                "blocked": sum(row["state"] == "blocked" for row in rows),
                "historical": sum(row["state"] == "historical" for row in rows),
            }
        )
    return summary


def lane_table(summary: list[dict]) -> str:
    rows = [
        "| Status file | Actionable rows | In progress | Blocked | Historical |",
        "|---|---|---|---|---|",
    ]
    for lane in summary:
        rows.append(
            f"| tabilet/memory-bank/{lane['file']} | {lane['actionable']} | "
            f"{lane['in_progress']} | {lane['blocked']} | {lane['historical']} |"
        )
    return "\n".join(rows)


def git_clean(repo: pathlib.Path) -> bool:
    proc = git_local(["status", "--porcelain"], repo)
    return proc.stdout.strip() == ""


def git_status_short(repo: pathlib.Path) -> str:
    return git_local(["status", "--short"], repo).stdout


def git_head(repo: pathlib.Path) -> str:
    proc = git_local(["rev-parse", "HEAD"], repo)
    if proc.returncode != 0:
        fail(proc.stderr.strip() or "Unable to read git HEAD.", 13)
    return proc.stdout.strip()


def git_branch(repo: pathlib.Path) -> str:
    proc = git_local(["symbolic-ref", "--quiet", "--short", "HEAD"], repo)
    return proc.stdout.strip() if proc.returncode == 0 else "(detached)"


def git_is_ancestor(repo: pathlib.Path, before: str, after: str) -> bool:
    return git_local(["merge-base", "--is-ancestor", before, after], repo).returncode == 0


def post_run_gates(
    repo: pathlib.Path,
    before: str,
    before_branch: str,
    before_rows: dict,
    after_rows: dict,
    required_key: tuple[str, str, int] | None,
) -> dict:
    """Return the first failed standalone post-commit gate, in legacy order."""

    if not git_clean(repo):
        return {"gate": "git_clean", "exit_code": 5, "row_problems": []}
    after = git_head(repo)
    if before == after:
        return {"gate": "new_commit", "exit_code": 6, "row_problems": [], "after": after}
    if git_branch(repo) != before_branch or not git_is_ancestor(repo, before, after):
        return {"gate": "commit_ancestry", "exit_code": 9, "row_problems": [], "after": after}
    row_problems = validate_row_transition(before_rows, after_rows, required_key)
    if row_problems:
        return {
            "gate": "row_transition", "exit_code": 8,
            "row_problems": row_problems, "after": after,
        }
    return {"gate": None, "exit_code": 0, "row_problems": [], "after": after}


def extract_json(text: str) -> dict:
    stripped = text.strip()
    fenced = re.fullmatch(r"```(?:json)?\s*\n?(.*?)\n?```", stripped, re.DOTALL)
    if fenced:
        stripped = fenced.group(1).strip()
    decoder = json.JSONDecoder()
    try:
        value = json.loads(stripped)
    except json.JSONDecodeError as original:
        value = None
        for index, char in enumerate(stripped):
            if char != "{":
                continue
            try:
                value, _ = decoder.raw_decode(stripped[index:])
                break
            except json.JSONDecodeError:
                continue
        if value is None:
            raise original
    if not isinstance(value, dict):
        raise ValueError("response JSON must be an object")
    return value


def _retry_delay(exc: urllib.error.HTTPError, attempt: int) -> float:
    retry_after = exc.headers.get("Retry-After", "") if exc.headers else ""
    try:
        return min(30.0, max(0.0, float(retry_after)))
    except ValueError:
        return min(30.0, float(2**attempt))


def _post_json(
    url: str,
    headers: dict,
    payload: dict,
    label: str,
    timeout: int = 120,
    max_retries: int = 2,
    before_attempt=None,
) -> dict:
    data = json.dumps(payload).encode("utf-8")
    for attempt in range(max_retries + 1):
        if before_attempt is not None:
            before_attempt()
        req = urllib.request.Request(url, data=data, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    fail(f"{label} response exceeded {MAX_RESPONSE_BYTES} bytes.", 22)
                try:
                    body = json.loads(raw.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                    fail(f"{label} returned invalid JSON: {exc}", 22)
                if not isinstance(body, dict):
                    fail(f"{label} returned a JSON value that was not an object.", 22)
                return body
        except urllib.error.HTTPError as exc:
            retry_delay = (
                _retry_delay(exc, attempt)
                if exc.code in TRANSIENT_HTTP_CODES and attempt < max_retries
                else None
            )
            detail = exc.read(MAX_RESPONSE_BYTES).decode("utf-8", "replace")
            exc.close()
            if retry_delay is not None:
                print(
                    f"{label} HTTP {exc.code}; retrying in {retry_delay:g}s "
                    f"({attempt + 1}/{max_retries}).",
                    file=sys.stderr,
                )
                time.sleep(retry_delay)
                continue
            fail(f"{label} HTTP {exc.code}: {detail}", 20)
        except (urllib.error.URLError, TimeoutError) as exc:
            if attempt < max_retries:
                delay = min(30.0, float(2**attempt))
                print(
                    f"{label} request failed; retrying in {delay:g}s "
                    f"({attempt + 1}/{max_retries}): {exc}",
                    file=sys.stderr,
                )
                time.sleep(delay)
                continue
            fail(f"{label} request failed: {exc}", 21)
    fail(f"{label} request exhausted retries.", 21)


def call_openai(
    api_base: str,
    api_key: str,
    model: str,
    messages: list[dict],
    temperature: float | None,
    max_tokens: int,
    timeout: int = 120,
    max_retries: int = 2,
    before_attempt=None,
) -> dict:
    url = api_base.rstrip("/") + "/chat/completions"
    payload = {
        "model": model,
        "messages": messages,
        "max_tokens": max_tokens,
    }
    if temperature is not None:
        payload["temperature"] = temperature
    headers = {"Content-Type": "application/json"}
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    if before_attempt is None:
        body = _post_json(url, headers, payload, "OpenAI API", timeout, max_retries)
    else:
        body = _post_json(
            url, headers, payload, "OpenAI API", timeout, max_retries,
            before_attempt=before_attempt,
        )
    try:
        choice = body["choices"][0]
        message = choice["message"]
        content = message.get("content") or ""
        if not isinstance(content, str):
            fail("Chat Completions response content was not text.", 22)
        return {
            "content": content,
            "stop_reason": choice.get("finish_reason"),
            "refusal": message.get("refusal"),
            "usage": body.get("usage") or {},
        }
    except (AttributeError, KeyError, IndexError, TypeError):
        fail("LLM API response did not match Chat Completions shape:\n" + json.dumps(body, indent=2), 22)


def call_anthropic(
    api_base: str,
    api_key: str,
    model: str,
    messages: list[dict],
    temperature: float | None,
    max_tokens: int,
    timeout: int = 120,
    max_retries: int = 2,
    before_attempt=None,
) -> dict:
    url = api_base.rstrip("/") + "/messages"
    system_parts = [m["content"] for m in messages if m["role"] == "system"]
    chat = [{"role": m["role"], "content": m["content"]} for m in messages if m["role"] != "system"]
    payload = {
        "model": model,
        "max_tokens": max_tokens,
        "messages": chat,
    }
    # Sampling parameters are omitted unless asked for. Current Claude models
    # (Opus 4.7 and later, Sonnet 5, Fable 5) reject temperature/top_p/top_k
    # with HTTP 400, so sending a default would break every current model.
    if temperature is not None:
        payload["temperature"] = temperature
    if system_parts:
        payload["system"] = "\n\n".join(system_parts)

    headers = {
        "Content-Type": "application/json",
        "anthropic-version": "2023-06-01",
    }
    if api_key:
        headers["x-api-key"] = api_key

    if before_attempt is None:
        body = _post_json(url, headers, payload, "Anthropic API", timeout, max_retries)
    else:
        body = _post_json(
            url, headers, payload, "Anthropic API", timeout, max_retries,
            before_attempt=before_attempt,
        )
    try:
        blocks = body["content"]
        texts = [b.get("text", "") for b in blocks if b.get("type") == "text"]
        return {
            "content": "".join(texts),
            "stop_reason": body.get("stop_reason"),
            "refusal": body.get("stop_reason") == "refusal",
            "usage": body.get("usage") or {},
        }
    except (AttributeError, KeyError, IndexError, TypeError):
        fail("Anthropic API response did not match Messages shape:\n" + json.dumps(body, indent=2), 22)


def call_llm(
    provider: str,
    api_base: str,
    api_key: str,
    model: str,
    messages: list[dict],
    temperature: float | None,
    max_tokens: int,
    timeout: int = 120,
    max_retries: int = 2,
    before_attempt=None,
) -> dict:
    if provider == "anthropic":
        if before_attempt is None:
            return call_anthropic(
                api_base, api_key, model, messages, temperature, max_tokens, timeout, max_retries,
            )
        return call_anthropic(
            api_base, api_key, model, messages, temperature, max_tokens, timeout, max_retries,
            before_attempt=before_attempt,
        )
    if provider == "openai":
        if before_attempt is None:
            return call_openai(
                api_base, api_key, model, messages, temperature, max_tokens, timeout, max_retries,
            )
        return call_openai(
            api_base, api_key, model, messages, temperature, max_tokens, timeout, max_retries,
            before_attempt=before_attempt,
        )
    fail(f"Unknown LLM provider: {provider!r}. Use 'openai' or 'anthropic'.", 2)


def initial_user_message(
    repo: pathlib.Path,
    run: int,
    max_runs: int,
    summary: list[dict],
    in_progress: dict | None,
) -> str:
    if in_progress:
        selection = (
            "Resume exactly the existing in-progress row at "
            f"tabilet/memory-bank/{in_progress['file']}:{in_progress['line']}.\n"
        )
    else:
        selection = (
            "No row is currently in progress. Select one dependency-ready "
            "pending row and mark it `[~]` before implementation.\n"
        )
    return (
        f"Repository: {repo}\n"
        f"Run: {run}/{max_runs}\n"
        "\n"
        "Embedded instruction:\n"
        "\n"
        f"{EMBEDDED_TASK}\n"
        "Status lanes in this repository:\n"
        "\n"
        f"{lane_table(summary)}\n"
        "\n"
        "Start by reading AGENTS.md and the memory bank. Read\n"
        "tabilet/memory-bank/milestone.md for the lane meanings and milestone priority\n"
        "before choosing a row. "
        f"{selection}"
        "Use the JSON command protocol. Work on exactly\n"
        "one actionable row in one status lane file.\n"
    )


def message_chars(messages: list[dict]) -> int:
    return sum(len(m.get("content", "")) for m in messages)


def usage_line(usage: dict) -> str:
    fields = []
    for key, value in usage.items():
        if isinstance(value, (int, float, str, bool)) or value is None:
            fields.append(f"{key}={value}")
    return ", ".join(fields)


def one_agent_run(
    args: argparse.Namespace,
    repo: pathlib.Path,
    run: int,
    summary: list[dict],
    in_progress: dict | None,
    executor=shell_tool,
    system_prompt: str = SYSTEM_PROMPT,
    user_message: str | None = None,
    before_model_turn=None,
    before_provider_attempt=None,
    before_command=None,
    after_command=None,
) -> dict[str, object]:
    messages = [
        {"role": "system", "content": system_prompt},
        {
            "role": "user",
            "content": user_message if user_message is not None else initial_user_message(
                repo, run, args.max_runs, summary, in_progress
            ),
        },
    ]

    for turn in range(1, args.max_turns + 1):
        history_size = message_chars(messages)
        if history_size > args.max_history_chars:
            fail(
                f"Conversation reached {history_size} characters, above "
                f"MAX_HISTORY_CHARS={args.max_history_chars}.",
                31,
            )
        displayed_turn = turn + getattr(args, "controller_turn_offset", 0)
        print(f"  LLM turn {displayed_turn}/{args.max_turns}")
        if before_model_turn is not None:
            before_model_turn()
        llm_args = (
            args.provider,
            args.api_base,
            args.api_key,
            args.model,
            messages,
            args.temperature,
            args.max_tokens,
            args.api_timeout,
            args.max_retries,
        )
        if before_provider_attempt is None:
            response = call_llm(*llm_args)
        else:
            response = call_llm(*llm_args, before_attempt=before_provider_attempt)
        content = response["content"]
        stop_reason = response.get("stop_reason")
        usage = usage_line(response.get("usage") or {})
        if usage:
            print(f"  LLM usage: {usage}")
        if response.get("refusal"):
            fail(f"Model refused the request (stop reason: {stop_reason or 'unknown'}).", 23)
        if not content.strip():
            fail(f"Model returned no text (stop reason: {stop_reason or 'unknown'}).", 23)

        try:
            command = extract_json(content)
        except Exception as exc:
            messages.append({"role": "assistant", "content": content})
            messages.append(
                {
                    "role": "user",
                    "content": (
                        f"Your response was not valid JSON: {exc}. Return exactly one JSON object."
                        + (
                            " Your previous response reached the provider token limit; keep the command shorter."
                            if stop_reason in {"length", "max_tokens"}
                            else ""
                        )
                    ),
                }
            )
            continue

        messages.append({"role": "assistant", "content": json.dumps(command)})

        if isinstance(command.get("final"), str):
            print(command["final"])
            return command

        if command.get("tool") != "run_shell" or not isinstance(command.get("cmd"), str):
            messages.append(
                {
                    "role": "user",
                    "content": "Invalid command. Use {\"tool\":\"run_shell\",\"cmd\":\"...\",\"why\":\"...\"} or {\"final\":\"...\"}.",
                }
            )
            continue

        cmd = command["cmd"]
        why = command.get("why", "")
        print(f"  shell: {cmd}" + (f"  # {why}" if why else ""))
        if before_command is not None:
            before_command()
        result = executor(
            repo,
            cmd,
            args.tool_timeout,
            args.max_tool_output,
            args.allow_dangerous,
            args.tool_env,
        )
        if after_command is not None:
            after_command(cmd, result)
        messages.append(
            {
                "role": "user",
                "content": "Tool result:\n```json\n" + json.dumps(result, ensure_ascii=False, indent=2) + "\n```",
            }
        )

    fail(f"Model exceeded max turns ({args.max_turns}) without finishing.", 30)


class AuditRun:
    """Best-effort recorder: optional imports and failures never change row gates."""

    def __init__(
        self, args, repo, operation, git_ref, worktree_state, *,
        invocation_kind="api_runner", instruction_set_name="tackle-memory-bank-api-loop",
        host_agent="tackle-memory-bank-api-loop",
    ):
        self.connection = None
        self.run_id = None
        self.workspace_id = None
        self.repo = repo
        self.operation = operation
        self.git_ref = git_ref
        self.closed = False
        self.failure = None
        self.observed_commits = set()
        self.capture = args.audit_capture
        self.invocation_kind = invocation_kind
        self.instruction_set_name = instruction_set_name
        self.host_agent = host_agent
        if not args.audit_db:
            return
        try:
            try:
                import sqlite3  # noqa: F401 -- optional; some Python builds omit it
            except ImportError as exc:
                raise RuntimeError(
                    "Python's sqlite3 module is unavailable; the audit needs a Python "
                    "built with SQLite 3.24.0 or later"
                ) from exc
            import tabilet_audit
            import tabilet_index
            if (getattr(tabilet_audit, "TOOLKIT_INTERFACE", None) != 1
                    or getattr(tabilet_index, "TOOLKIT_INTERFACE", None) != 1):
                raise RuntimeError("incompatible audit toolkit modules; reinstall the toolkit files together")
            self.recorder = tabilet_audit
            if git_ref is None:
                head = git_local(["rev-parse", "HEAD"], repo)
                git_ref = head.stdout.strip() if head.returncode == 0 else None
                self.git_ref = git_ref
            self.connection = self.recorder.open_database(args.audit_db, project_roots=[repo])
            self.workspace_id = self.recorder.ensure_workspace(self.connection, repo, branch=git_branch(repo))
            self.run_id = self.recorder.start_run(
                self.connection, self.workspace_id, operation, capture_mode=self.capture,
                git_head=git_ref, worktree_state=worktree_state,
            )
            instruction_text = getattr(args, "audit_instruction_text", EMBEDDED_TASK)
            resource = {"name": self.instruction_set_name,
                        "sha256": hashlib.sha256(instruction_text.encode("utf-8")).hexdigest()}
            self.recorder.record_provenance(self.connection, self.run_id, {
                "invocation_kind": self.invocation_kind,
                "instruction_set_name": self.instruction_set_name,
                "instruction_set_version": None,
                "host_agent": self.host_agent,
                "host_version": None,
                "provider": args.provider,
                "model": args.model,
                "capture_method": "automatic",
                "fingerprint_fidelity": "partial",
                "resources": [resource],
                "aggregate_sha256": hashlib.sha256(self.recorder.canonical_json([resource]).encode("utf-8")).hexdigest(),
            })
            self.emit("run_started", details={"git_head": git_ref, "worktree_state": worktree_state})
            self.message("host", f"operation={operation} repository={repo}", source="host", fidelity="summarized")
        except Exception as exc:
            self.gap("initialize recorder", exc)
            if self.connection is not None:
                self.connection.close()
                self.connection = None

    def gap(self, stage, exc):
        self.failure = str(exc)
        print(f"Audit gap: unable to {stage}: {exc}", file=sys.stderr)

    def __enter__(self):
        return self

    def __exit__(self, kind, value, traceback):
        if not self.closed:
            result = "interrupted" if kind and issubclass(kind, KeyboardInterrupt) else "failed" if kind else "unknown"
            self.emit("run_interrupted" if result == "interrupted" else "run_failed",
                      details={"reason": str(value) if value is not None else "terminal evidence unavailable"})
            self.finish(result)
        return False

    def emit(self, event_type, *, subject=None, details=None):
        if self.connection is None or self.closed:
            return
        timestamp = self.recorder.utc_now()
        event = {"schema": "tabilet.audit.event/v1", "event_id": str(uuid.uuid4()),
                 "run_id": self.run_id, "workspace_id": self.workspace_id, "operation": self.operation,
                 "event_type": event_type, "recorded_at": timestamp, "occurred_at": timestamp,
                 "subject": subject or {}, "details": {**(details or {}), "schema": "tabilet.audit.details/v1"}}
        try:
            self.recorder.append_event(self.connection, event)
        except Exception as exc:
            self.gap(f"record {event_type}", exc)

    def message(self, role, text, *, source, fidelity):
        if self.connection is None or self.closed or self.capture != "relevant":
            return
        try:
            evidence, bounded = self.recorder.bounded_message_evidence(text)
            self.recorder.capture_message(
                self.connection, self.run_id, role, evidence,
                capture_source=source, fidelity="incomplete" if bounded else fidelity,
                redaction_note="automatic bounded extract; source exceeded 1024 characters" if bounded else None,
            )
        except Exception as exc:
            self.gap("record message", exc)

    def observe_commits(self):
        if self.connection is None or self.closed or self.failure:
            return
        try:
            head = git_local(["rev-parse", "HEAD"], self.repo)
            if head.returncode:
                return
            current = head.stdout.strip()
            if current == self.git_ref:
                return
            history = git_local(["rev-list", "--reverse", f"{self.git_ref}..{current}"], self.repo) if self.git_ref else None
            commits = history.stdout.splitlines() if history and history.returncode == 0 else [current]
            for commit in commits:
                if commit not in self.observed_commits:
                    self.emit("commit_observed", details={"commit_sha": commit})
                    self.observed_commits.add(commit)
        except Exception as exc:
            self.gap("observe commits", exc)

    def finish(self, result):
        if self.closed:
            return
        try:
            if self.connection is not None:
                self.observe_commits()
                if self.failure:
                    self.emit("audit_gap", details={"error": self.failure})
                try:
                    if self.capture == "metadata":
                        self.recorder.record_coverage(self.connection, {
                            "coverage_id": f"{self.run_id}:coverage",
                            "run_id": self.run_id,
                            "scope": "api_runner_conversation",
                            "coverage": "not_requested",
                            "content_state": "none",
                            "capture_method": "automatic",
                        })
                    else:
                        counts = {"exact_count": 0, "redacted_count": 0, "summarized_count": 0, "incomplete_count": 0}
                        rows = self.connection.execute("SELECT fidelity FROM captured_messages WHERE run_id=?", (self.run_id,)).fetchall()
                        for row in rows:
                            counts[row[0] + "_count"] += 1
                        self.recorder.record_coverage(self.connection, {
                            "coverage_id": f"{self.run_id}:coverage",
                            "run_id": self.run_id,
                            "scope": "api_runner_conversation",
                            "coverage": "partial" if rows else "missing",
                            "content_state": "available" if rows else "none",
                            "capture_method": "automatic",
                            **counts,
                        })
                except Exception as exc:
                    self.gap("record capture coverage", exc)
                try:
                    self.recorder.finish_run(self.connection, self.run_id, result)
                except Exception as exc:
                    self.gap("record run result", exc)
                try:
                    import tabilet_index
                    tabilet_index.sync(self.connection, self.repo)
                except Exception as exc:
                    print(f"Index gap: {exc}", file=sys.stderr)
        finally:
            self.closed = True
            if self.connection is not None:
                try:
                    self.connection.close()
                except Exception as exc:
                    self.gap("close recorder", exc)


def positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"expected an integer, got {value!r}") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError(f"expected a positive integer, got {parsed}")
    return parsed


def nonnegative_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"expected an integer, got {value!r}") from exc
    if parsed < 0:
        raise argparse.ArgumentTypeError(f"expected a non-negative integer, got {parsed}")
    return parsed


def temperature_value(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"expected a number, got {value!r}") from exc
    if not math.isfinite(parsed):
        raise argparse.ArgumentTypeError(f"expected a finite number, got {value!r}")
    return parsed


def environment_names(value: str) -> list[str]:
    names = [name.strip() for name in value.split(",") if name.strip()]
    invalid = [name for name in names if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name)]
    if invalid:
        raise argparse.ArgumentTypeError("invalid environment variable name(s): " + ", ".join(invalid))
    forbidden = sorted(set(names) & PROVIDER_SECRET_ENV)
    if forbidden:
        raise argparse.ArgumentTypeError(
            "provider credential variables cannot be forwarded: " + ", ".join(forbidden)
        )
    return names


def parse_args(argv=None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run memory-bank tasks through an OpenAI-compatible or Anthropic LLM API.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent(
            """\
            Examples:

              One-row run:

                ALLOW_UNSANDBOXED_SHELL=1 LLM_MODEL=gpt-5.6 OPENAI_API_KEY=... MAX_RUNS=1 tackle-memory-bank-api-loop .

              Loop run:

                ALLOW_UNSANDBOXED_SHELL=1 LLM_MODEL=gpt-5.6 OPENAI_API_KEY=... MAX_RUNS=5 tackle-memory-bank-api-loop .

              OpenRouter-style:

                LLM_API_BASE=https://openrouter.ai/api/v1 \\
                LLM_API_KEY=... \\
                LLM_MODEL=openai/gpt-5.6 \\
                ALLOW_UNSANDBOXED_SHELL=1 \\
                MAX_RUNS=1 tackle-memory-bank-api-loop .

              Local OpenAI-compatible server:

                LLM_API_BASE=http://localhost:1234/v1 \\
                LLM_MODEL=local-model-name \\
                ALLOW_UNSANDBOXED_SHELL=1 \\
                MAX_RUNS=1 tackle-memory-bank-api-loop .

              Anthropic:

                LLM_PROVIDER=anthropic \\
                LLM_MODEL=claude-opus-5 \\
                ANTHROPIC_API_KEY=... \\
                ALLOW_UNSANDBOXED_SHELL=1 \\
                MAX_RUNS=1 tackle-memory-bank-api-loop .

            Environment:

              LLM_PROVIDER                       'openai' (default) or 'anthropic'.
              LLM_MODEL or OPENAI_MODEL          Model name.
              LLM_API_KEY                        API key (works for any provider).
              OPENAI_API_KEY                     OpenAI key fallback when provider=openai.
              ANTHROPIC_API_KEY                  Anthropic key fallback when provider=anthropic.
              LLM_API_BASE or OPENAI_BASE_URL    API base URL. Defaults:
                                                   openai     -> https://api.openai.com/v1
                                                   anthropic  -> https://api.anthropic.com/v1
              MAX_RUNS                           Maximum row iterations. Default: 20.
              MAX_TURNS                          Maximum LLM turns per row. Default: 60.
              TOOL_TIMEOUT                       Shell command timeout seconds. Default: 300.
              MAX_TOOL_OUTPUT                    Max shell output returned to model. Default: 24000.
              LLM_MAX_TOKENS                     Max response tokens. Default: 16000.
              LLM_API_TIMEOUT                    API request timeout seconds. Default: 120.
              LLM_MAX_RETRIES                    Retries after transient failures. Default: 2.
              MAX_HISTORY_CHARS                  Conversation character limit. Default: 500000.
              LLM_TEMPERATURE                    Sampling temperature. Unset by default:
                                                 current Claude models reject it.
              TOOL_ENV_ALLOW                     Comma-separated extra variables for shell tools.
              ALLOW_UNSANDBOXED_SHELL=1          Acknowledge model-controlled host shell access.
              ALLOW_DANGEROUS_COMMANDS=1         Disable the command guardrail.
              TABILET_AUDIT_DB                  Opt-in external SQLite audit database path.
              TABILET_AUDIT_CAPTURE             'metadata' (default) or 'relevant'.
              TABILET_AUDIT_ARCHIVES            Obsolete; new snapshot capture is deferred.
            """
        ),
    )
    parser.add_argument("repo", nargs="?", default=".", help="Repository path. Default: current directory.")
    parser.add_argument("--provider", default=os.environ.get("LLM_PROVIDER", "openai"), choices=["openai", "anthropic"])
    parser.add_argument("--model", default=os.environ.get("LLM_MODEL") or os.environ.get("OPENAI_MODEL"))
    parser.add_argument("--api-base", default=os.environ.get("LLM_API_BASE") or os.environ.get("OPENAI_BASE_URL") or "")
    parser.add_argument("--api-key", default="")
    parser.add_argument("--max-runs", type=positive_int, default=os.environ.get("MAX_RUNS", "20"))
    parser.add_argument("--max-turns", type=positive_int, default=os.environ.get("MAX_TURNS", "60"))
    parser.add_argument("--tool-timeout", type=positive_int, default=os.environ.get("TOOL_TIMEOUT", "300"))
    parser.add_argument("--max-tool-output", type=positive_int, default=os.environ.get("MAX_TOOL_OUTPUT", "24000"))
    parser.add_argument("--max-tokens", type=positive_int, default=os.environ.get("LLM_MAX_TOKENS", "16000"))
    parser.add_argument("--api-timeout", type=positive_int, default=os.environ.get("LLM_API_TIMEOUT", "120"))
    parser.add_argument("--max-retries", type=nonnegative_int, default=os.environ.get("LLM_MAX_RETRIES", "2"))
    parser.add_argument("--max-history-chars", type=positive_int, default=os.environ.get("MAX_HISTORY_CHARS", "500000"))
    env_temp = os.environ.get("LLM_TEMPERATURE")
    parser.add_argument("--temperature", type=temperature_value, default=env_temp)
    parser.add_argument("--tool-env-allow", type=environment_names, default=os.environ.get("TOOL_ENV_ALLOW", ""))
    parser.add_argument(
        "--allow-unsandboxed-shell",
        action="store_true",
        default=os.environ.get("ALLOW_UNSANDBOXED_SHELL") == "1",
    )
    parser.add_argument("--allow-dangerous", action="store_true", default=os.environ.get("ALLOW_DANGEROUS_COMMANDS") == "1")
    parser.add_argument(
        "--audit-db",
        default=os.environ.get("TABILET_AUDIT_DB") or None,
        help="Enable the external SQLite audit recorder at this path.",
    )
    parser.add_argument(
        "--audit-capture",
        choices=["metadata", "relevant"],
        default=os.environ.get("TABILET_AUDIT_CAPTURE", "metadata"),
        help="Message capture mode when auditing is enabled.",
    )
    parser.add_argument(
        "--audit-archives",
        action="store_true",
        default=os.environ.get("TABILET_AUDIT_ARCHIVES") == "1",
        help="Obsolete: use tabilet-audit index sync for current Markdown lookup.",
    )
    args = parser.parse_args(argv)
    if args.audit_archives:
        parser.error("New snapshot capture is deferred; use tabilet-audit index sync PROJECT.")
    if args.audit_capture not in {"metadata", "relevant"}:
        parser.error("TABILET_AUDIT_CAPTURE must be metadata or relevant")

    if args.provider not in {"openai", "anthropic"}:
        parser.error("LLM_PROVIDER must be 'openai' or 'anthropic'")

    if not args.api_base:
        args.api_base = (
            "https://api.anthropic.com/v1" if args.provider == "anthropic" else "https://api.openai.com/v1"
        )
    if not args.api_key:
        if args.provider == "anthropic":
            args.api_key = os.environ.get("LLM_API_KEY") or os.environ.get("ANTHROPIC_API_KEY") or ""
        else:
            args.api_key = os.environ.get("LLM_API_KEY") or os.environ.get("OPENAI_API_KEY") or ""
    args.tool_env = tool_environment(args.tool_env_allow)

    return args


def main() -> None:
    args = parse_args()
    if not args.model:
        fail("Set LLM_MODEL or pass --model.", 2)

    repo = pathlib.Path(args.repo).expanduser().resolve()
    legacy = any((repo / name).exists() or (repo / name).is_symlink() for name in
                 ("GOAL.md", "memory-bank", "evolution", "docs/history"))
    docs = repo / "docs"
    legacy = legacy or (docs.is_dir() and any(docs.glob("archive-[A-Z][0-9][0-9].md")))
    if legacy:
        fail("v1.5.0 or mixed project layout detected. Preview and apply the explicit migration with "
             "skills/memory-bank-upgrade/migrate-v1.5-to-v2.py PROJECT before running v2.", 11)
    if not (repo / "AGENTS.md").is_file():
        fail(f"AGENTS.md not found in {repo}", 10)
    if not (repo / "tabilet" / "memory-bank").is_dir():
        fail(f"tabilet/memory-bank/ not found in {repo}", 11)
    if not (repo / "tabilet" / "memory-bank" / "milestone.md").is_file():
        fail(f"tabilet/memory-bank/milestone.md not found in {repo}", 11)
    if not status_files(repo) and not (repo / "tabilet" / "docs" / "history" / "index.md").is_file():
        fail(
            f"No status lane files matching tabilet/memory-bank/{STATUS_GLOB} in {repo}.\n"
            "Status files are named tabilet/memory-bank/status-<LANE><NN>.md, such as\n"
            "status-M01.md or status-A02.md. See tabilet/memory-bank/milestone.md for the\n"
            "status ID pattern.",
            11,
        )
    root_proc = git_local(["rev-parse", "--show-toplevel"], repo)
    if root_proc.returncode != 0:
        fail(f"{repo} is not inside a git worktree.", 12)
    git_root = pathlib.Path(root_proc.stdout.strip()).resolve()
    if git_root != repo:
        fail(f"Target must be the git worktree root: got {repo}, expected {git_root}", 12)

    try:
        with project_lock(repo):
            run_locked_loop(args, repo)
    except ProjectLockUnavailable as exc:
        message = (
            "Another Tabilet launcher already holds the project lock; wait for it to "
            f"finish before starting a second run ({exc})."
        )
        fail(message, 19)
    except ProjectLockError as exc:
        fail(str(exc), 26)
    except UnsafeGitConfiguration as exc:
        fail(
            "Repository Git configuration is unsafe for host operations: "
            f"{exc}. Remove or disable the active local filter/attribute driver "
            "before running the harness.",
            27,
        )


def run_locked_loop(args: argparse.Namespace, repo: pathlib.Path) -> None:

    endpoint = "/messages" if args.provider == "anthropic" else "/chat/completions"
    print(f"Repo: {repo}")
    print(f"Provider: {args.provider}")
    print(f"Model: {args.model}")
    print(f"API: {args.api_base.rstrip('/')}{endpoint}")

    for run in range(1, args.max_runs + 1):
        try:
            before_rows = row_snapshot(repo)
        except (OSError, UnicodeError) as exc:
            fail(f"Unable to read required status/history state: {exc}", 11)
        state_problems = before_rows["history"]["problems"]
        if not before_rows["files"]:
            state_problems.append("no active status files or valid retired milestones")
        if state_problems:
            fail("Invalid memory-bank status/history state:\n  " + "\n  ".join(state_problems), 11)
        summary = lane_summary(repo)
        in_progress_rows = rows_in_state(repo, "in_progress")
        if len(in_progress_rows) > 1:
            detail = ", ".join(
                f"tabilet/memory-bank/{row['file']}:{row['line']}" for row in in_progress_rows
            )
            fail(
                "More than one general memory-bank row is in progress. Retain exactly "
                f"one `[~]` row before launching: {detail}",
                15,
            )
        in_progress = in_progress_rows[0] if in_progress_rows else None
        actionable = sum(lane["actionable"] for lane in summary)
        blocked = sum(lane["blocked"] for lane in summary)
        blocked_lanes = [lane for lane in summary if lane["blocked"]]

        if not actionable:
            if blocked:
                audit = AuditRun(
                    args,
                    repo,
                    "next",
                    None,
                    "clean" if git_clean(repo) else "dirty",
                )
                audit.emit(
                    "run_blocked",
                    details={"reason": "only blocked memory-bank rows remain", "blocked": blocked},
                )
                audit.finish("blocked")
                print("Only blocked memory-bank rows remain. Stopping for human review.", file=sys.stderr)
                for lane in blocked_lanes:
                    print(f"  tabilet/memory-bank/{lane['file']}: {lane['blocked']} blocked row(s)", file=sys.stderr)
                raise SystemExit(3)
            print("No actionable memory-bank rows remain.")
            return
        if blocked:
            print(f"Warning: {blocked} blocked row(s) remain; continuing with actionable lanes.", file=sys.stderr)
            for lane in blocked_lanes:
                print(f"  tabilet/memory-bank/{lane['file']}: {lane['blocked']} blocked row(s)", file=sys.stderr)
        if not args.allow_unsandboxed_shell:
            fail(
                "Actionable work requires model-controlled host shell access. "
                "Re-run with --allow-unsandboxed-shell or "
                "ALLOW_UNSANDBOXED_SHELL=1, preferably inside a disposable sandbox.",
                14,
            )
        if run == 1:
            print(
                "WARNING: model commands are not sandboxed and can access host files "
                "and the network. The command denylist is only a guardrail.",
                file=sys.stderr,
            )
        if not git_clean(repo):
            print("Worktree is dirty before run. Stopping.", file=sys.stderr)
            print(git_status_short(repo), file=sys.stderr)
            raise SystemExit(4)

        before = git_head(repo)
        before_branch = git_branch(repo)
        audit = AuditRun(
            args,
            repo,
            "next",
            before,
            "clean" if git_clean(repo) else "dirty",
        )
        with audit:
            observed_subject = {}
            if in_progress:
                observed_subject = {
                    "milestone_id": in_progress["file"].removeprefix("status-").removesuffix(".md"),
                    "task_label": in_progress["item"],
                    "status_path": f"tabilet/memory-bank/{in_progress['file']}",
                    "old_state": "in_progress",
                }
            audit.emit(
                "task_observed",
                subject=observed_subject,
                details={"summary": summary, "in_progress": in_progress,
                         "explorer": {"schema": "tabilet.audit.explorer/v1", "phase": "request",
                                      "artifact_refs": ([{"namespace": "task", "identifier": in_progress["item"],
                                                          "relationship": "observed", "path": f"tabilet/memory-bank/{in_progress['file']}"}]
                                                         if in_progress else [])}},
            )
            print(f"Run {run}/{args.max_runs}: asking LLM to tackle one row.")
            started = time.time()
            try:
                run_result = one_agent_run(args, repo, run, summary, in_progress)
            except KeyboardInterrupt:
                audit.emit("run_interrupted", details={"reason": "keyboard interrupt"})
                audit.finish("interrupted")
                raise
            except SystemExit as exc:
                audit.emit("run_failed", details={"exit_code": exc.code})
                audit.finish("failed")
                raise
            audit.observe_commits()
            if isinstance(run_result, dict) and isinstance(run_result.get("final"), str):
                audit.message("assistant", run_result["final"], source="host", fidelity="exact")
            print(f"Run duration: {time.time() - started:.1f}s")

            try:
                after_rows = row_snapshot(repo)
            except (OSError, UnicodeError) as exc:
                fail(f"Unable to read status/history after the run: {exc}", 8)
            candidate = next(
                (
                    (key, before_rows["states"][key], after_rows["states"][key])
                    for key in before_rows["states"]
                    if before_rows["states"][key] != after_rows["states"].get(key)
                ),
                None,
            )
            transition = candidate
            transition_recorded = False

            def record_transition():
                nonlocal transition_recorded
                if not transition or transition_recorded:
                    return
                key, old_state, new_state = transition
                audit.emit(
                    "task_transition",
                    subject={
                        "milestone_id": key[0].removeprefix("status-").removesuffix(".md"),
                        "task_label": key[1],
                        "status_path": f"tabilet/memory-bank/{key[0]}",
                        "old_state": old_state,
                        "new_state": new_state,
                    },
                    details={"schema": "tabilet.audit.details/v1",
                             "explorer": {"schema": "tabilet.audit.explorer/v1", "phase": "applied",
                                          "artifact_refs": [{"namespace": "task", "identifier": key[1],
                                                              "relationship": "changed", "path": f"tabilet/memory-bank/{key[0]}",
                                                              "old_state": old_state, "new_state": new_state}]}},
                )
                transition_recorded = True

            gates = post_run_gates(
                repo,
                before,
                before_branch,
                before_rows,
                after_rows,
                in_progress["key"] if in_progress else None,
            )
            if gates["exit_code"] == 5:
                record_transition()
                audit.emit("verification_observed", details={"checks": ["git_clean"], "success": False})
                audit.emit("run_failed", details={"reason": "uncommitted changes after model run"})
                audit.finish("failed")
                print("LLM left uncommitted changes. Stopping.", file=sys.stderr)
                print(git_status_short(repo), file=sys.stderr)
                raise SystemExit(5)
            after = gates.get("after")
            if gates["exit_code"] == 6:
                audit.emit("verification_observed", details={"checks": ["new_commit"], "success": False})
                audit.emit("run_failed", details={"reason": "model made no commit"})
                audit.finish("failed")
                print("LLM made no commit. Stopping to avoid a spin loop.", file=sys.stderr)
                raise SystemExit(6)
            if gates["exit_code"] == 9:
                record_transition()
                audit.emit("verification_observed", details={"checks": ["commit_ancestry"], "success": False})
                audit.emit("run_failed", details={"reason": "history rewrite or branch change"})
                audit.finish("failed")
                print("LLM rewrote history or moved to another branch. Stopping.", file=sys.stderr)
                raise SystemExit(9)
            row_problems = gates["row_problems"]
            if row_problems:
                audit.emit(
                    "verification_observed",
                    details={"checks": ["row_transition"], "success": False, "problems": row_problems},
                )
                audit.emit("run_failed", details={"reason": "invalid row transition", "problems": row_problems})
                audit.finish("failed")
                print("LLM violated the one-row transition contract. Stopping.", file=sys.stderr)
                for problem in row_problems:
                    print(f"  {problem}", file=sys.stderr)
                raise SystemExit(8)
            record_transition()
            audit.emit(
                "verification_observed",
                details={"checks": ["git_clean", "commit_ancestry", "row_transition"], "success": True},
            )
            outcome = {"completed": "completed", "blocked": "blocked", "cancelled": "cancelled"}.get(transition[2], "unknown") if transition else "unknown"
            if transition and transition[2] == "historical":
                audit.emit("superseded", details={"notes": after_rows["cells"].get(transition[0], [])})
            audit.finish(outcome)
            if not status_files(repo):
                print("All milestones are retired. No actionable memory-bank rows remain.")
                return

    print(f"Reached MAX_RUNS={args.max_runs}. Stopping.")
    raise SystemExit(7)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except KeyboardInterrupt:
        raise SystemExit(130)
    except Exception as exc:
        fail(f"Unexpected harness failure: {type(exc).__name__}: {exc}", 1)
