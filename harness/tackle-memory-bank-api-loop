                    refers = bool(re.match(r'\W*(?:it|this|that|these|those|they)\b', bare, re.I)
                                  or (mentioned and re.search(r'\b(?:it|they|them)\b', bare, re.I))
                                  or _REFERENCE_SUBJECT.search(bare)
                                  or ((seeded or mentioned) and _bare_verdict(bare)))
