class UnsafeGitConfiguration(ValueError):
    """A host Git operation could invoke a repository-controlled command."""


def _git_environment() -> dict[str, str]:
    """Keep Git away from inherited Git overrides and user/system config."""

    allowed = {
        "PATH", "HOME", "LANG", "LC_ALL", "LC_CTYPE", "TMPDIR", "SYSTEMROOT",
    }
    env = {name: os.environ[name] for name in allowed if name in os.environ}
    env.setdefault("PATH", os.defpath)
    env.setdefault("HOME", str(pathlib.Path.home()))
    env.update({
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_NO_LAZY_FETCH": "1",
        "GIT_ATTR_NOSYSTEM": "1",
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_PAGER": "cat",
        "PAGER": "cat",
        "GIT_EDITOR": "true",
        "GIT_SEQUENCE_EDITOR": "true",
    })
    return env


@functools.lru_cache(maxsize=1)
def _global_excludes_file() -> str | None:
    """Read the user's real global core.excludesFile once, outside the sandbox.

    GIT_CONFIG_GLOBAL=os.devnull below blocks the user's whole global config
    from every host Git call, primarily so a global alias cannot silently
    redefine one of the built-in subcommands this harness relies on. That
    blanket block also hides the user's own ignore patterns, so an editor swap
    file or .DS_Store the user already excludes globally shows up as
    "untracked" and fails the clean-worktree gate. Forward just this one
    path-valued setting explicitly instead of trusting global config wholesale.
    """
    executable = shutil.which("git")
    if not executable:
        return None
    try:
        result = subprocess.run(
            [executable, "config", "--global", "--get", "core.excludesFile"],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    value = result.stdout.strip()
    return value or None


@functools.lru_cache(maxsize=None)
def _identity_config(repo: str) -> tuple[str, ...]:
    """Read the user's real committer identity for this repo, outside the sandbox.

    GIT_CONFIG_GLOBAL=os.devnull below hides ~/.gitconfig (and any repo-local
    override) from every host Git call, so commit-tree has no user.name or
    user.email to use and falls back to guessing one from the OS account and
    hostname. That guess may not be the identity the user actually configured,
    and can fail outright ("unable to auto-detect email address") on a host
    whose hostname does not look like a domain, such as inside a container.
    Read with plain `git config --get`, which already prefers a repo-local
    value over a global one, so a per-repo identity is respected too.
    """
    executable = shutil.which("git")
    if not executable:
        return ()
    overrides = []
    for key in ("user.name", "user.email"):
        try:
            result = subprocess.run(
                [executable, "config", "--get", key],
                cwd=repo, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5,
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        value = result.stdout.strip()
        if value:
            overrides.append(f"{key}={value}")
    return tuple(overrides)


