                            return True
                        if warn:
                            review_warnings.append(f'unrecognized review wording: "{_printable_excerpt(bare)}"')
                    elif (short or claim == 'verdict') and not re.fullmatch(_POSITIVE_CLAIM, bare, re.I):
                        # Otherwise a short clause with no subject of its own
                        # still states the result ("Withheld.").
                        if strict:
                            return True
