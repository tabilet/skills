                                    r'with|without|because|while|so|if|unless|pending|the|a|an|this|that|its|it|'
                                    r'all|every|each|some|any|no|most|many|more|other|'
                                    r'is|are|was|were|be|been|being|has|have|had)\b')
                        follows = (r'(?=\s*$|\s*[,;:(]|\s+(?:to|by|from|in|on|at|for|with|as|after|before|during|under|'
                                   r'into|and|or|but|again|already|now|later|cleanly|successfully|unchanged|intact)\b)')
