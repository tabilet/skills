                        re.search(marker_cell, line)
                        or (delimiter_row(number + 1) and re.search(marker_cell, by_number.get(number + 2, ''))))
                    task_header_delimiter = (task_table and delimiter_row(number)
                                             and re.match(r'^\s*\|\s*(?:Task|Item)\s*\|', by_number.get(number - 1, ''), re.I)
                                             and not re.search(marker_cell, by_number.get(number - 1, '')))
                    table_row = re.fullmatch(r'\s*\|.*\|\s*', line)
                    if task_start or (task_table and table_row and (re.search(marker_cell, line) or task_header_delimiter)):
                        # The task table does not end the continuation: its rows
                        # are checked for milestone review reversals and counters
                        # on both paths, and prose after it still continues the pass.
                        if lenient and adverse_paragraph():
                            return True
                        task_table = True
                        if task_row_conflict(line):
                            return True
                        continue
                    task_table = False
                    field = re.fullmatch(r'\*\*(Milestone|Outcome|Retired|Source status|Source specification|'
                                         r'Evidence|Worktree|Review iterations|Review limit|Review limit approval|'
                                         r'Verification|Consolidated into|Disposition|Successor|Legacy closure|Marker correction)'
                                         r'\.\*\* (.+)', line.strip(), re.I)
                    if field:
                        if lenient and adverse_paragraph():
                            return True
                        if (field[1].lower() == 'marker correction'
                                and not re.fullmatch(RECOGNIZED_PROSE['marker_correction'], field[2])):
                            return True
                        continue
                    reaffirmation = re.fullmatch(RECOGNIZED_PROSE['reaffirmation'].format(
                        iterations=re.escape(iterations), limit=re.escape(recorded_limit)), line.strip(), re.I)
                    task_review = re.fullmatch(RECOGNIZED_PROSE['task_review_fail'], line.strip(), re.I)
                    if (line.strip() == RECOGNIZED_PROSE['standalone_intake'] or reaffirmation or task_review):
                        continue
                    if not lenient:
                        return True
                    if line.lstrip().startswith('|'):
                        if adverse_paragraph() or table_row_adverse(line, delimiter_row(number + 1)):
                            return True
                    elif re.match(r'^#{1,6}\s', line.lstrip()):
                        if adverse_paragraph():
                            return True
                    else:
                        # A bold field label names a section, not a result subject.
                        paragraph.append(re.sub(r'^\*\*[\w ]+[.:]\*\*\s*', '', line.strip()))
                    continue
                numbered = re.search(final_pass, line, re.I)
                plain = re.fullmatch(r'(?:\*\*Review\.\*\*\s*|Review\s*:\s*|Review\s+)passed\.?',
                                     line.strip(), re.I)
                if numbered or plain:
                    if numbered and line[numbered.end():].strip() and (
                            not lenient or adverse_review_wording(line[numbered.end():], final_iteration, True, True)
                            or unrecognized_review_sentence(line[numbered.end():], True)):
                        return True
                    after_final_pass = True
            return bool(after_final_pass and lenient and adverse_paragraph())
        envelope_context = [(line, True, True, True, False, number)
                            for number, line in envelope_unfenced]
        review_scan = [(line, trusted, in_review or preamble, False, preamble, number)
                          for number, (line, trusted, in_review, preamble) in status_lines.items()]
        status_fields = [(line, trusted, True, False, preamble, number)
                         for number, (line, trusted, _, preamble) in status_lines.items()]
        def ambiguous_prose_reference(source):
            parts = []
            previous = None
            def ambiguous():
                joined = ' '.join(parts)
                return bool(re.search(r'\breview\s+(?:result|verdict|outcome|decision)\b', joined, re.I)
                            and (not lenient or adverse_review_wording(joined, final_iteration)))
            for line, trusted, relevant, _, _, number in source:
                stripped = line.strip()
                boundary = (not trusted or not relevant or not stripped or
                            re.match(r'^(?:#{1,6}\s|\||\*\*[\w ]+[.:]\*\*|[A-Za-z ]+:)', stripped))
                if (previous is not None and number != previous + 1) or boundary:
                    if ambiguous():
                        return True
                    parts.clear()
                previous = number
                if not boundary:
                    parts.append(stripped)
            return ambiguous()
        if ambiguous_prose_reference(envelope_context) or ambiguous_prose_reference(status_fields):
            review_conflicts.append('ambiguous recorded review-result reference')
        if (ambiguous_pass_continuation(envelope_context, code_line_numbers(''.join(lines[:metadata_end])))
                or ambiguous_pass_continuation(review_scan, code_line_numbers(documents['status']))):
            review_conflicts.append('unrecognized continuation after recorded review pass')
        # Other structured metadata can contain review-result claims too. Its
        # field name does not make those claims verification of acceptance.
        # Flag unrecognized result references even when another field says pass.
        later_counter = any(trusted_status and in_review and re.fullmatch(
            r'Persisted iteration count:\s*' + re.escape(iterations) + r'/' + re.escape(recorded_limit)
            + r'(?:,\s*passed)?\.(?:\s+Task completion alone does not establish acceptance\.'
              r'(?:\s+Record exact source, observed checks, findings and downstream handoff before completion\.)?)?',
            status_line.strip(), re.I)
            for status_line, trusted_status, in_review, _ in status_lines.values())
        field_pattern = re.compile(r'(?:\*\*([\w ]+)\.\*\*|\*\*([\w ]+):\*\*|'
                                   r'([A-Za-z ]+):)\s*(.*)')
        def structured_paragraphs(source, raw_lines):
            # Combine a field's adjacent Markdown paragraph lines before
            # interpreting its contents. Preserve the original bytes in the
            # record; this normalized view is used only for validation.
            index = 0
            while index < len(source):
                line, trusted, relevant, _, preamble, number = source[index]
                field = field_pattern.fullmatch(line.strip()) if trusted and relevant else None
                index += 1
                if not field:
                    continue
                name = next(value for value in field.group(1, 2, 3) if value).lower()
                parts = [field[4]]
                while index < len(source):
                    following, next_trusted, next_relevant, _, _, next_number = source[index]
                    # A nested list marker can be indented four or more spaces
                    # and omitted by unfenced_lines. Include it only after an
                    # adjacent list item; standalone indented code stays out.
                    while (number + 1 < next_number and number < len(raw_lines)
                           and re.match(r'^[-*+]\s', parts[-1])
                           and re.match(r'^ {4,}[-*+]\s', raw_lines[number])):
                        parts.append(raw_lines[number].strip())
                        number += 1
                    stripped = following.strip()
                    if (next_number != number + 1 or not next_trusted or not next_relevant or not stripped or
                            field_pattern.fullmatch(stripped) or re.match(
                                r'^(?:#{1,6}\s|\||`{3,}|~{3,})', stripped)):
                        break
                    parts.append(stripped)
                    number = next_number
                    index += 1
                else:
                    # The field ended the kept lines. Indented nested items that
                    # follow an adjacent list item are still part of it.
                    while (number < len(raw_lines) and re.match(r'^[-*+]\s', parts[-1])
                           and re.match(r'^ {4,}[-*+]\s', raw_lines[number])):
                        parts.append(raw_lines[number].strip())
                        number += 1
                yield name, ' '.join(part for part in parts if part).strip(), preamble
        for field_name, field_value, preamble in (
                list(structured_paragraphs(envelope_context, lines[:metadata_end]))
                + list(structured_paragraphs(status_fields, documents['status'].splitlines()))):
            if field_name in {'review', 'review iterations', 'review limit', 'review limit approval'}:
                continue
            if field_name in {'review result', 'review verdict', 'review outcome', 'review decision'}:
                if not re.fullmatch(r'passed\.?', field_value, re.I):
                    review_conflicts.append('ambiguous review-result claim in structured metadata')
                continue
            earlier_pending = (preamble and field_name == 'state'
                               and re.fullmatch(RECOGNIZED_PROSE['earlier_pending'], field_value, re.I))
            if earlier_pending and later_counter:
                continue
            old_prefix_risk = r'\b(?:not|no|never|unless|if|except|conditional)\b'
            for passing in re.finditer(
                    r'\breview\s+(?:passed|completed|accepted|approved|succeeded|successful|clean)\b',
                    field_value, re.I):
                suffix = field_value[passing.end():].strip()
                claim_sentence = re.split(r'(?<=[.;!?])\s', suffix, maxsplit=1)[0]
                accepted_suffix = (suffix in {'', '.', '. No publication is claimed.'} or re.fullmatch(
                    r'\.\s*Persisted review count\s+' + re.escape(iterations) + r'/'
                    + re.escape(recorded_limit) + r'\.', suffix, re.I)
                    or (lenient and consistent_counters(claim_sentence)
                        and not adverse_review_wording(field_value[passing.start():], final_iteration, True)))
                before = re.split(r'[.;]\s', field_value[:passing.start()])[-1]
                risky_prefix = (
                    _negated(before) or bool(re.search(
                        r'\b(?:unless|except|if|conditional\w*|once|until)\b\s+(?:\w+\s+){0,5}$', before, re.I))
                    if lenient else bool(re.search(old_prefix_risk, field_value[:passing.start()], re.I)))
                if not accepted_suffix or risky_prefix:
                    review_conflicts.append('ambiguous review-result claim in structured metadata')
            if field_name in {'state', 'status', 'verification', 'outcome', 'result', 'acceptance',
                              'closure', 'review gate', 'disposition'}:
                # Claim fields are read on both paths; a literal record warns on
                # wording a correction-backed one would never accept.
                # The formal retirement outcome is metadata, not a review claim.
                if field_name == 'outcome' and re.fullmatch(r'(?:completed|cancelled|superseded)\.?', field_value):
                    continue
                # Result, Review gate and Outcome exist to state the verdict:
                # any value there that is neither recognized nor a plain
                # positive result warns, or blocks a correction-backed record.
                verdict_field = 'verdict' if field_name in {'result', 'review gate', 'outcome'} else True
                if unrecognized_review_sentence(field_value, warn=lenient, claim=verdict_field, strict=not lenient):
                    review_conflicts.append('ambiguous review-result claim in structured metadata')
            elif lenient and counter_conflict(field_value):
                review_conflicts.append('ambiguous review-result claim in structured metadata')
            colon_result = re.search(r'(?:^|[.;]\s+)review\s*:\s*(.*)', field_value, re.I)
            if colon_result and not (
                    re.fullmatch(r'passed\.?', colon_result[1].strip(), re.I)
                    or (lenient and re.match(r'passed\b', colon_result[1].strip(), re.I)
                        and consistent_counters(colon_result[1])
                        and not adverse_review_wording(colon_result[1], final_iteration, True))):
                review_conflicts.append('ambiguous review-result claim in structured metadata')
            claims = list(re.finditer(r'\breview\s+([1-9][0-9]*)/([1-9][0-9]*)\b', field_value, re.I))
            for position, numbered in enumerate(claims):
                end = claims[position + 1].start() if position + 1 < len(claims) else len(field_value)
                if lenient and names_other_milestone(field_value[:numbered.start()]):
                    continue
                result = field_value[numbered.end():end].strip()
                same = numbered[1] == iterations and numbered[2] == recorded_limit
                verdict = re.match(r'[,:;(—–\s-]*(?:(?:was|is)\s+)?(PASS(?:ED)?|FAIL(?:ED)?|NOT\s+PASSED|PENDING|INCOMPLETE)\b',
                                   result, re.I)
                benign = lenient and not adverse_review_wording(field_value[numbered.start():end], final_iteration)
                if same:
                    supported = bool(
                        re.fullmatch(r',?\s*passed(?:\s+with\s+no\s+P1/P2)?\.?', result, re.I)
                        or re.fullmatch(RECOGNIZED_PROSE['retired_without_commits'], result, re.I)
                        or (benign and ((not verdict and not re.match(r'\s*(?:[:,(—–-]|(?:was|is)\b)', result))
                                        or (verdict and verdict[1].upper() in {'PASS', 'PASSED'}
                                            and consistent_counters(result))))
                    )
                else:
                    # An earlier iteration may have failed or be cited; a pass
                    # recorded at another iteration or limit is inconsistent.
                    supported = bool(benign and numbered[2] == recorded_limit
                                     and int(numbered[1]) < final_iteration
                                     and not (verdict and verdict[1].upper() in {'PASS', 'PASSED'}))
                stale_counter = (preamble and field_name == 'state' and later_counter and same
                    and re.fullmatch(r',\s*passed\.\s*Persisted review count 0/10\.', result, re.I))
                prefix = field_value[:numbered.start()]
                clause = re.split(r'[.;]\s', prefix)[-1]
                risky_prefix = (
                    _negated(clause) or bool(re.search(
                        r'\b(?:unless|except|if|conditional\w*|once|until)\b\s+(?:\w+\s+){0,5}$', clause, re.I))
                    if lenient else bool(re.search(old_prefix_risk, prefix, re.I)))
                if (not supported and not stale_counter) or risky_prefix:
                    review_conflicts.append('ambiguous review-result claim in structured metadata')
            if re.search(r'\b(?:review\s+(?:result|verdict|outcome|decision|was|is|has|had|'
                         r'failed|fail|pending|not)|(?:result|verdict|outcome|decision)\s+of\s+'
                         r'(?:the\s+)?review)\b', field_value, re.I) and (
                             not lenient or adverse_review_wording(field_value, final_iteration)):
                review_conflicts.append('ambiguous review-result claim in structured metadata')
        if review_conflicts and corrected_pass:
            raise ValueError('conflicting recorded review result; a correction cannot supply acceptance')
    source_spec = metadata.get('Source specification', '')
    anchor = re.fullmatch(r'((?:tabilet/)?memory-bank/milestone\.md#\S+)(?: \([^\n]+\))?', source_spec)
    if anchor:
        metadata['Source specification'] = anchor[1]
    specification, status = documents['specification'], documents['status']
    spec_headings = [line for _, line in unfenced_lines(specification) if re.match(r'^#{2,3} ', line)]
    explicit = [op for op in operations if op['kind'] == 'identify-specification']
    first = spec_headings[0] if spec_headings else ''
    if explicit and explicit[0]['heading'] != first:
        raise ValueError('specification identification does not match its source heading')
    own_heading = re.match(r'^#{2,3} ' + re.escape(identity) + r'(?:\s|$)', first)
    if not own_heading:
        # A combined legacy milestone names its parts without padding (M1 for
        # M01). Only the record's own ID in that form also identifies it.
        unpadded = re.sub(r'^([A-Z])0+(?=[0-9])', r'\1', identity)
        own_ids = '|'.join(re.escape(own) for own in dict.fromkeys((identity, unpadded)))
        if (len(explicit) != 1 or explicit[0]['heading'] != first
                or re.match(r'^#{2,3} ' + ROOT_ID + r'(?:\s|$)', first)
                or not re.search(r'(?<![A-Za-z0-9])(?:' + own_ids + r')(?![A-Za-z0-9])', specification)):
            raise ValueError('historical specification identity is missing or ambiguous')
    elif any(re.match(r'^#{' + str(first.index(' ')) + r'} ' + ROOT_ID + r'(?:\s|$)', heading)
             for heading in spec_headings[1:]):
        raise ValueError('ambiguous historical milestone specifications')
    task_status = status
    legacy = []
    task_lines = task_status.splitlines(keepends=True)
    for row in status_table_rows(status):
        if row['cells'][1] == '`[x]`':
            cells = re.split(r'(?<!\\)\|', task_lines[row['line'] - 1], maxsplit=3)
            cells[2] = cells[2].replace('`[x]`', '`[+]`', 1)
            task_lines[row['line'] - 1] = '|'.join(cells)
            legacy.append(row['line'])
    task_status = ''.join(task_lines)
    validation_status = task_status
    for op in operations:
        if op['kind'] == 'historical-successor':
            rows = status_rows(task_status)
            matches = [row for row in rows if row['item'] == op['item'] and row['state'] == 'historical']
            successors = [row for row in rows if row['item'] == op['successor'] and row['state'] == 'completed']
            if len(matches) != 1 or len(successors) != 1:
                raise ValueError('missing or ambiguous completed historical successor')
            adapted = validation_status.splitlines(keepends=True)
            n = matches[0]['line'] - 1
            adapted[n] = adapted[n].rstrip('\r\n').rstrip('|').rstrip() + '; Accepted successor: ' + op['successor'] + ' |\n'
            validation_status = ''.join(adapted)
    task_status = validation_status
    # Strict envelope checks are reused on an interpreted copy only. The caller
    # receives the complete literal documents and metadata as separate evidence.
    fence = '`' * (max([3] + [len(m[0]) for m in re.finditer(r'`+', validation_status)]) + 1)
    blockers = [op['message'] for op in operations if op['kind'] == 'blocker']
    blockers.extend(approval_conflicts)
    blockers.extend(dict.fromkeys(outcome_conflicts))
    blockers.extend(dict.fromkeys(review_conflicts))
    validation_metadata = dict(metadata)
    if correction:
        # Incomplete recovered records remain searchable, with explicit gaps.
        # Validation placeholders never become recorded facts or acceptance.
        defaults = {'Milestone': identity, 'Outcome': 'completed', 'Retired': '1970-01-01',
                    'Source status': 'tabilet/memory-bank/' + name,
                    'Source specification': 'tabilet/memory-bank/milestone.md#' + identity.lower(),
                    'Evidence': 'unversioned', 'Worktree': 'unversioned', 'Review': 'passed',
                    'Review iterations': '1', 'Verification': 'not recorded', 'Consolidated into': 'not recorded'}
        for key, value in defaults.items():
            if not metadata.get(key):
                blockers.append('missing historical closure evidence: ' + key)
                metadata[key] = 'unverified' if key == 'Review' else 'not recorded'
                validation_metadata[key] = value
        if metadata['Review'] == 'unverified':
            validation_metadata['Review'] = 'passed'
        if metadata['Evidence'] == 'not recorded':
            validation_metadata['Worktree'] = 'unversioned'
        elif metadata['Worktree'] == 'not recorded':
            validation_metadata['Worktree'] = 'clean'
    normalized = '\n'.join('**' + key + '.** ' + value for key, value in validation_metadata.items())
    normalized += '\n\n## Milestone specification\n\n' + fence + 'markdown\n## ' + identity + ' - Historical specification\n' + fence
    normalized += '\n\n## Status record\n\n' + fence + 'markdown\n' + validation_status
    if not validation_status.endswith('\n'):
        normalized += '\n'
    normalized += fence + '\n'
    try:
        retired_record(normalized, name, allow_unfinished=True)
    except ValueError as exc:
        message = re.sub(r'\bline (\d+):', lambda m: f'line {int(m[1]) + offsets["status"]}:', str(exc))
        raise ValueError(message) from exc
    if legacy and (metadata['Outcome'] != 'completed' or metadata['Review'] != 'passed'):
        raise ValueError('historical `[x]` completion markers require a completed outcome and passed review')
    if any(row['state'] in {'pending', 'in_progress', 'blocked'} for row in status_rows(task_status)):
        blockers.append('retired status contains unfinished task rows')
    if legacy:
        blockers.append('historical `[x]` markers are lookup only')
    # A retained counter is a conflict wherever it appears in a trusted line
    # (bullet, table cell or prose), not only at the start of one.
    counts = [match[1].lower()
              for line, trusted, _, _ in status_lines.values() if trusted
              for match in re.finditer(
                  r'(?:\*\*(?:Review gate iterations|Review iterations)\.\*\*|'
                  r'(?<![\w-])(?:Review gate iterations|Review iterations)\s*:)\s*(not recorded|[0-9]+)\b',
                  line, re.I)]
    if counts and (len(set(counts)) != 1 or counts[0] != metadata['Review iterations'].lower()):
        blockers.append('retained review counter conflicts with retirement metadata')
    try:
        retired_record(text, name)
        strict = True
    except ValueError:
        strict = False
    return {'metadata': metadata, 'literal_metadata': literal_metadata, 'specification': specification,
            'status': status, 'task_status': task_status, 'offsets': offsets, 'sources': sources,
            'legacy_completion_lines': legacy, 'blockers': blockers, 'strict': strict,
            'warnings': list(dict.fromkeys(review_warnings))}


def historical_index_cells(cells: list[str]) -> list[str]:
    """Recover pipes inside a legacy summary's inline code, never identity fields."""
    if len(cells) <= 5:
        return cells
    prefix = cells[4]
    for cell in cells[5:]:
        # Only extra separators inside one-backtick code spans are demonstrated
        # historical syntax. An actual sixth column remains invalid.
        if prefix.count('`') % 2 != 1 or '``' in prefix:
            return cells
        prefix += '|' + cell
    return cells[:4] + [prefix] if prefix.count('`') % 2 == 0 else cells


HISTORY_WARNINGS_SHOWN = 10


def history_snapshot(repo: pathlib.Path) -> dict:
    history = repo / "tabilet" / "docs" / "history"
    records, digests, problems, warnings = {}, {}, [], []
    paths = declared_status_files(history)
    corrections, correction_digest = {}, None
    try:
        corrections, correction_digest = read_history_corrections(repo)
    except (ValueError, OSError) as exc:
        problems.append(f'{HISTORY_CORRECTIONS}: {exc}')
    for path in paths:
        try:
            if path.is_symlink() or not STATUS_NAME.fullmatch(path.name):
                raise ValueError("invalid retired filename or symlink")
            raw = path.read_bytes()
            if len(raw) > HISTORY_INPUT_LIMIT:
                raise ValueError('history record exceeds input limit')
            digests[path.name] = hashlib.sha256(raw).hexdigest()
            record = historical_record(raw.decode('utf-8'), path.name,
                                       corrections.get('tabilet/docs/history/' + path.name))
            records[path.name] = record
            problems.extend(f'tabilet/docs/history/{path.name}: {problem}' for problem in record['blockers'])
            warnings.extend(f'tabilet/docs/history/{path.name}: {warning}' for warning in record['warnings'])
        except (ValueError, OSError) as exc:
            problems.append(f"tabilet/docs/history/{path.name}: {exc}")
    for missing in set(corrections) - {'tabilet/docs/history/' + path.name for path in paths}:
        problems.append('correction record is missing: ' + missing)
    index_path = history / "index.md"
    index = index_path.read_text(encoding="utf-8") if index_path.is_file() else ""
    entries, index_compatibility = {}, []
    for row in table_rows(index):
        cells = historical_index_cells(row["cells"])
        if not re.fullmatch(MILESTONE_ID, cells[0]):
            continue
        name = next((p.name for p in paths if STATUS_NAME.fullmatch(p.name)
                     and status_identity(p.name) == cells[0]), f"status-{cells[0]}.md")
        if cells != row['cells']:
            index_compatibility.append(name)
        if name in entries:
            problems.append(f"duplicate history index ID: {cells[0]}")
        entries[name] = cells
        if name not in records:
            problems.append(f"history index record is missing or invalid: {name}")
    milestone_path = repo / "tabilet" / "memory-bank" / "milestone.md"
    milestone = milestone_path.read_text(encoding="utf-8") if milestone_path.is_file() else ""
    milestone_lines = list(unfenced_lines(milestone))
    spec_ids = {
        match.group(1) for _, line in milestone_lines
        if (match := re.match(r"^## (" + MILESTONE_ID + r")(?:\s|$)", line))
    }
    index_ids = set()
    for row in table_rows(milestone):
        first = row["cells"][0].strip("` ")
        linked_id = re.fullmatch(r"\[(" + MILESTONE_ID + r")\]\([^)]*\)", first)
        index_ids.add(linked_id.group(1) if linked_id else first)
    live = {p.name for p in status_files(repo)}
    for milestone_id in spec_ids | index_ids:
        if re.fullmatch(MILESTONE_ID, milestone_id):
            name = next((n for n in live | set(records) if status_identity(n) == milestone_id), f"status-{milestone_id}.md")
            if name not in live and name not in records:
                problems.append(f"active milestone has no status record: {milestone_id}")
    for name, record in records.items():
        meta = record["metadata"]
        cells = entries.get(name, [])
        if len(cells) != 5 or cells[1:3] != [meta["Outcome"], meta["Retired"]] or not re.fullmatch(
            r"\[[^\]]+\]\(" + re.escape(name) + r"\)", cells[3]
        ):
            problems.append(f"missing or inconsistent history index entry: {name}")
        if name in live:
            problems.append(f"duplicate active/retired ID: {meta['Milestone']}")
        if meta["Milestone"] in spec_ids:
            problems.append(f"retired specification remains active: {meta['Milestone']}")
        if meta["Milestone"] in index_ids:
            problems.append(f"retired index row remains active: {meta['Milestone']}")
    history_links = re.findall(
        r"\[[^\]]+\]\(\.\./docs/history/index\.md\)",
        "\n".join(line for _, line in milestone_lines),
    )
    if records and len(history_links) != 1:
        problems.append("milestone.md must have exactly one history-index link")
    journal_path = history / "knowledge.md"
    journal = journal_path.read_bytes() if journal_path.is_file() else b""
    return {
        "records": records, "digests": digests, "entries": entries,
        "journal": journal, "problems": problems, "warnings": warnings, "corrections_sha256": correction_digest,
        "corrections": corrections,
        "index_compatibility": index_compatibility,
    }


def root_specifications(text: str) -> dict[str, str | None]:
    lines = text.splitlines(keepends=True)
    headings = [(n, line) for n, line in unfenced_lines(text) if line.startswith("## ")]
    specifications = {}
    for index, (start, heading) in enumerate(headings):
        match = re.match(r"## (" + ROOT_ID + r")(?:\s|$)", heading)
        if match:
            end = headings[index + 1][0] - 1 if index + 1 < len(headings) else len(lines)
            name = f"status-{match.group(1)}.md"
            # A duplicate is ambiguous, not permission to silently choose one.
            specifications[name] = None if name in specifications else "".join(lines[start - 1:end])
    return specifications


def milestone_specifications(repo: pathlib.Path) -> dict[str, str | None]:
    path = repo / "tabilet" / "memory-bank" / "milestone.md"
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    specifications = root_specifications(text)
    for child in status_files(repo):
        if not child.name.startswith("status-"):
            specifications[child.name] = child.read_text(encoding="utf-8")
    return specifications


def row_snapshot(repo: pathlib.Path) -> dict:
    states, cells, documents = {}, {}, {}
    history = history_snapshot(repo)
    # Validate required instructions again after each run; the model may have
    # removed or damaged them since the startup checks.
    for relative in ("AGENTS.md", "tabilet/memory-bank/milestone.md"):
        try:
            (repo / relative).read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            history["problems"].append(f"required project instructions unavailable: {relative}: {exc}")
    for path in declared_status_files(repo / "tabilet" / "memory-bank"):
        if path.is_symlink() or not STATUS_NAME.fullmatch(path.name):
            history["problems"].append(f"invalid active status filename or symlink: {path.name}")
    documents.update({name: record["task_status"] for name, record in history["records"].items()})
    active = {p.name for p in status_files(repo)}
    documents.update({p.name: p.read_text(encoding="utf-8") for p in status_files(repo)})
    families, problems = family_metadata(documents)
    history["problems"].extend(problems)
    for identity, family in families.items():
        if family['kind'] != 'amend':
            continue
        parent = families.get(family['parent'], {})
        if parent.get('file') not in history['records']:
            continue
        try:
            owners = amendment_owners(identity, families, history['records'])
        except ValueError as error:
            history['problems'].append(str(error))
            continue
        for owner in owners:
            name = families[owner]['file']
            record = history['records'].get(name)
            if record and record['metadata']['Outcome'] == 'completed':
                continue
            if (name not in active or not review_passed(documents[name])
                    or any(row['state'] in {'pending','in_progress','blocked'} for row in status_rows(documents[name]))):
                history['problems'].append('retired parent has an unaccepted required amendment owner: ' + owner)
    for name, document in documents.items():
        if name in active:
            if not status_rows(document) and not name.startswith("option-"):
                history["problems"].append(f"active status has no recognized task rows: {name}")
            history["problems"].extend(f"{name}: {problem}" for problem in status_marker_problems(document))
        occurrences: dict[str, int] = {}
        for row in status_rows(document):
            item = row["item"]
            occurrences[item] = occurrences.get(item, 0) + 1
            key = (name, item, occurrences[item])
            states[key] = row["state"]
            cells[key] = row["cells"]
    return {
        "files": set(documents), "states": states, "cells": cells,
        "documents": documents, "active": active, "history": history, "families": families,
        "specifications": milestone_specifications(repo),
    }


def rows_in_state(repo: pathlib.Path, state: str) -> list[dict]:
    matches = []
    for path in status_files(repo):
        occurrences: dict[str, int] = {}
        for row in status_rows(path.read_text(encoding="utf-8")):
            item = row["item"]
            occurrences[item] = occurrences.get(item, 0) + 1
            if row["state"] == state:
                matches.append(
                    {
                        "file": path.name,
                        "item": item,
                        "line": row["line"],
                        "key": (path.name, item, occurrences[item]),
                    }
                )
    return matches


def validate_row_transition(
    before: dict, after: dict, required_key: tuple[str, str, int] | None = None
) -> list[str]:
    problems = list(after.get("history", {}).get("problems", []))
    old_history = before.get("history", {})
    new_history = after.get("history", {})
    if old_history.get('corrections_sha256') != new_history.get('corrections_sha256'):
        problems.append('history corrections changed during execution')
    for name, digest in old_history.get("digests", {}).items():
        if new_history.get("digests", {}).get(name) != digest:
            problems.append(f"previously retired record was changed or removed: {name}")
    for name, entry in old_history.get("entries", {}).items():
        if new_history.get("entries", {}).get(name) != entry:
            problems.append(f"previous history index entry was changed or removed: {name}")
    if not new_history.get("journal", b"").startswith(old_history.get("journal", b"")):
        problems.append("retired knowledge history was rewritten or removed")
    retired = set(new_history.get("records", {})) - set(old_history.get("records", {}))
    # A current API run cannot manufacture authority by writing approval prose.
    # Larger interactive ceilings are readable only as pre-existing history.
    for name in retired:
        metadata = new_history["records"][name]["metadata"]
        if new_history['records'][name].get('strict') is False:
            problems.append('new retirement does not meet the strict contract: ' + name)
        if name in new_history.get('index_compatibility', []):
            problems.append('new retirement index does not meet the strict contract: ' + name)
        if any(value.isdecimal() and int(value) > 10 for value in (
                metadata.get("Review iterations", ""), metadata.get("Review limit", "10"))):
            problems.append(f"new API retirement exceeds the fixed review limit of 10: {name}")
    for name in retired - before["files"]:
        problems.append(f"new retired record has no pre-existing active owner: {name}")
    appended_knowledge = new_history.get("journal", b"")[len(old_history.get("journal", b"")):]
    changed_keys = [key for key, state in before['states'].items()
                    if key in after['states'] and after['states'][key] != state]
    selected = changed_keys[0] if len(changed_keys) == 1 else None
    for name in retired & before["files"]:
        original_spec = before.get("specifications", {}).get(name)
        retained_spec = new_history["records"][name]["specification"]
        if not original_spec:
            problems.append(f"retirement lacks an unambiguous original specification: {name}")
        elif not name.startswith('status-'):
            child_selected = selected if selected and selected[0] == name else None
            if (not retained_source(original_spec, retained_spec, child_selected)
                    or retained_spec.strip() != new_history['records'][name]['status'].strip()):
                problems.append(f"retirement discarded original milestone specification: {name}")
        elif original_spec.strip() not in retained_spec and original_spec.strip().encode() not in appended_knowledge:
            problems.append(f"retirement discarded original milestone specification: {name}")
    missing_files = before["files"] - after["files"]
    if missing_files:
        problems.append("status files were removed: " + ", ".join(sorted(missing_files)))

    transitions = []
    for key, old_state in before["states"].items():
        if key not in after["states"]:
            problems.append(f"status row was removed or renamed: {key[0]} / {key[1]!r}")
            continue
        new_state = after["states"][key]
        if new_state != old_state:
            transitions.append((key, old_state, new_state))
        elif key[0] in retired and before.get("cells", {}).get(key) != after.get("cells", {}).get(key):
            problems.append(f"retirement changed an earlier row or its notes: {key[0]} / {key[1]!r}")

    for key, state in after["states"].items():
        if key not in before["states"] and state != "pending":
            problems.append(
                f"new status row is not pending: {key[0]} / {key[1]!r} is {state}"
            )

    disposition_only = (not transitions and retired and required_key is None
                        and not any(state == 'in_progress' for state in before['states'].values()) and all(
        name.startswith('option-') and not status_rows(before['documents'][name])
        and new_history['records'][name]['metadata']['Outcome'] in {'cancelled','superseded'}
        and retained_source(before['documents'][name], new_history['records'][name]['status'])
        for name in retired))
    if disposition_only:
        return problems
    if len(transitions) != 1:
        problems.append(f"expected exactly one existing row state transition, found {len(transitions)}")
    else:
        key, old_state, new_state = transitions[0]
        if key[0].startswith("option-") and required_key != key:
            problems.append("option execution requires explicit approved selection: " + key[0])
        if old_state not in ACTIONABLE_STATES or new_state not in RUN_TERMINAL_STATES:
            problems.append(
                f"invalid row transition in {key[0]} for {key[1]!r}: "
                f"{old_state} -> {new_state}"
            )
        if required_key is not None and key != required_key:
            problems.append(
                "the pre-existing in-progress row was not closed: "
                f"expected {required_key[0]} / {required_key[1]!r}"
            )
        for name in retired:
            if name != key[0]:
                problems.append(f"retirement is outside the current task's milestone: {name}")
        # Packaging preserves the original status prose and earlier rows. Only
        # the selected row may change; closure evidence can be appended.
        if key[0] in retired:
            original = before["documents"][key[0]]
            rows = status_rows(original)
            occurrences = 0
            selected_line = None
            for row in rows:
                if row["item"] == key[1]:
                    occurrences += 1
                    if occurrences == key[2]:
                        selected_line = row["line"]
            remaining = iter(after["documents"][key[0]].splitlines())
            for number, line in enumerate(original.splitlines(), 1):
                if number == selected_line:
                    continue
                if not any(candidate == line for candidate in remaining):
                    problems.append(f"retirement discarded original status content: {key[0]}")
                    break
    return problems


def lane_summary(repo: pathlib.Path) -> list[dict]:
    summary = []
    for path in status_files(repo):
        if path.name.startswith("option-"):
            continue
        rows = status_rows(path.read_text(encoding="utf-8"))
        summary.append(
            {
                "file": path.name,
                "actionable": sum(row["state"] in ACTIONABLE_STATES for row in rows),
                "in_progress": sum(row["state"] == "in_progress" for row in rows),
                "blocked": sum(row["state"] == "blocked" for row in rows),
                "historical": sum(row["state"] == "historical" for row in rows),
            }
        )
    return summary


def lane_table(summary: list[dict]) -> str:
    rows = [
        "| Status file | Actionable rows | In progress | Blocked | Historical |",
        "|---|---|---|---|---|",
    ]
    for lane in summary:
        rows.append(
            f"| tabilet/memory-bank/{lane['file']} | {lane['actionable']} | "
            f"{lane['in_progress']} | {lane['blocked']} | {lane['historical']} |"
        )
    return "\n".join(rows)


def git_clean(repo: pathlib.Path) -> bool:
    proc = git_local(["status", "--porcelain"], repo)
    return proc.stdout.strip() == ""


def git_status_short(repo: pathlib.Path) -> str:
    return git_local(["status", "--short"], repo).stdout


def git_head(repo: pathlib.Path) -> str:
    proc = git_local(["rev-parse", "HEAD"], repo)
    if proc.returncode != 0:
        fail(proc.stderr.strip() or "Unable to read git HEAD.", 13)
    return proc.stdout.strip()


def git_branch(repo: pathlib.Path) -> str:
    proc = git_local(["symbolic-ref", "--quiet", "--short", "HEAD"], repo)
    return proc.stdout.strip() if proc.returncode == 0 else "(detached)"


def git_is_ancestor(repo: pathlib.Path, before: str, after: str) -> bool:
    return git_local(["merge-base", "--is-ancestor", before, after], repo).returncode == 0


def post_run_gates(
    repo: pathlib.Path,
    before: str,
    before_branch: str,
    before_rows: dict,
    after_rows: dict,
    required_key: tuple[str, str, int] | None,
) -> dict:
    """Return the first failed standalone post-commit gate, in legacy order."""

    if not git_clean(repo):
        return {"gate": "git_clean", "exit_code": 5, "row_problems": []}
    after = git_head(repo)
    if before == after:
        return {"gate": "new_commit", "exit_code": 6, "row_problems": [], "after": after}
    if git_branch(repo) != before_branch or not git_is_ancestor(repo, before, after):
        return {"gate": "commit_ancestry", "exit_code": 9, "row_problems": [], "after": after}
    row_problems = validate_row_transition(before_rows, after_rows, required_key)
    if row_problems:
        return {
            "gate": "row_transition", "exit_code": 8,
            "row_problems": row_problems, "after": after,
        }
    return {"gate": None, "exit_code": 0, "row_problems": [], "after": after}


def extract_json(text: str) -> dict:
    stripped = text.strip()
    fenced = re.fullmatch(r"```(?:json)?\s*\n?(.*?)\n?```", stripped, re.DOTALL)
    if fenced:
        stripped = fenced.group(1).strip()
    decoder = json.JSONDecoder()
    try:
        value = json.loads(stripped)
    except json.JSONDecodeError as original:
        value = None
        for index, char in enumerate(stripped):
            if char != "{":
                continue
            try:
                value, _ = decoder.raw_decode(stripped[index:])
                break
            except json.JSONDecodeError:
                continue
        if value is None:
            raise original
    if not isinstance(value, dict):
        raise ValueError("response JSON must be an object")
    return value


def _backoff(attempt: int) -> float:
    """2, 4, 8 ... seconds with up to one second of jitter, capped at 30."""
    return min(30.0, 2.0 ** (attempt + 1) + random.uniform(0.0, 1.0))


def _retry_delay(exc: urllib.error.HTTPError, attempt: int) -> float:
    retry_after = exc.headers.get("Retry-After", "") if exc.headers else ""
    try:
        return min(30.0, max(0.0, float(retry_after)))
    except ValueError:
        return _backoff(attempt)


def _post_json(
    url: str,
    headers: dict,
    payload: dict,
    label: str,
    timeout: int = 120,
    max_retries: int = 2,
    before_attempt=None,
) -> dict:
    data = json.dumps(payload).encode("utf-8")
    for attempt in range(max_retries + 1):
        if before_attempt is not None:
            before_attempt()
        req = urllib.request.Request(url, data=data, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    fail(f"{label} response exceeded {MAX_RESPONSE_BYTES} bytes.", 22)
                expected = (resp.headers.get("Content-Length") or "").strip()
                if expected.isdigit() and len(raw) < int(expected):
                    # A connection closed early can return the partial body without raising.
                    raise http.client.IncompleteRead(raw, int(expected) - len(raw))
                try:
                    body = json.loads(raw.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                    fail(f"{label} returned invalid JSON: {exc}", 22)
                if not isinstance(body, dict):
                    fail(f"{label} returned a JSON value that was not an object.", 22)
                return body
        except urllib.error.HTTPError as exc:
            retry_delay = (
                _retry_delay(exc, attempt)
                if exc.code in TRANSIENT_HTTP_CODES and attempt < max_retries
                else None
            )
            try:
                detail = exc.read(MAX_RESPONSE_BYTES).decode("utf-8", "replace")
            except (OSError, http.client.HTTPException):
                detail = "(the error body could not be read)"
            exc.close()
            if retry_delay is not None:
                print(
                    f"{label} HTTP {exc.code}; retrying in {retry_delay:g}s "
                    f"({attempt + 1}/{max_retries}).",
                    file=sys.stderr,
                )
                time.sleep(retry_delay)
                continue
            fail(f"{label} HTTP {exc.code}: {detail}", 20)
        except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
            # urllib wraps errors only while sending. A reset, a TLS error, a truncated body or a
            # malformed status line while waiting for or reading the response arrives unwrapped.
            if attempt < max_retries:
                delay = _backoff(attempt)
                print(
                    f"{label} request failed; retrying in {delay:g}s "
                    f"({attempt + 1}/{max_retries}): {exc}",
                    file=sys.stderr,
                )
                time.sleep(delay)
                continue
            fail(f"{label} request failed: {exc}", 21)
    fail(f"{label} request exhausted retries.", 21)


class PrefixedText(str):
    """Message text whose first `cache_prefix` characters are stable across requests.

    It behaves as plain text everywhere (equality, JSON, concatenation), so
    providers that cache automatically see the same bytes as before. Only the
    Anthropic request builder reads `cache_prefix` to place a cache breakpoint
    at the end of the reusable part of a prompt.
    """

    cache_prefix = 0

    def __new__(cls, text: str, cache_prefix: int = 0):
        value = super().__new__(cls, text)
        value.cache_prefix = cache_prefix
        return value


# The smallest cacheable prefix of any current Claude model is 512 tokens
# (about 2,000 characters); a breakpoint on anything shorter caches nothing.
PROMPT_CACHE_MIN_CHARS = 2048
PROMPT_CACHE_MODES = ("auto", "on", "off")
PROMPT_CACHE_TTLS = ("5m", "1h")


def prompt_cache_policy(provider: str, api_base: str, env=None) -> dict | None:
    """Decide whether to send explicit prompt-cache markers.

    Only Claude's Messages API needs them: OpenAI and DeepSeek cache a matching
    prefix automatically, so the harness sends them nothing extra. `auto`
    enables markers for the official Anthropic host only, because a gateway
    may reject a field it does not know; `on` is the explicit opt-in for a
    gateway that supports them; `off` never sends them. Returns None when no
    markers should be sent, otherwise {"ttl": "5m" | "1h"}.
    """

    env = os.environ if env is None else env
    mode = (env.get("LLM_PROMPT_CACHE") or "auto").strip().lower()
    ttl = (env.get("LLM_PROMPT_CACHE_TTL") or "5m").strip().lower()
    if mode not in PROMPT_CACHE_MODES:
        raise ValueError("LLM_PROMPT_CACHE must be auto, on, or off")
    if ttl not in PROMPT_CACHE_TTLS:
        raise ValueError("LLM_PROMPT_CACHE_TTL must be 5m or 1h")
    if provider != "anthropic" or mode == "off":
        return None
    if mode == "auto":
        host = urllib.parse.urlsplit(api_base).hostname or ""
        if host != "api.anthropic.com":
            return None
    return {"ttl": ttl}


def _cache_marker(policy: dict) -> dict:
    marker = {"type": "ephemeral"}
    if policy["ttl"] == "1h":
        marker["ttl"] = "1h"
    return marker


def apply_anthropic_cache(system_parts: list[str], chat: list[dict], policy: dict):
    """Return (system, chat) with up to two cache breakpoints.

    The first marks the end of the reusable prefix: the stable start of the
    first user message when it declares one (which also covers the system
    prompt before it), otherwise the stable part of the system prompt, and only
    when that prefix is long enough to be cacheable. The second marks the last
    block of the newest message, so each turn reuses everything before it. Two
    of the four allowed breakpoints are used, and each turn adds only a couple
    of messages, well inside the 20-block lookback window.
    """

    marker = _cache_marker(policy)
    system_text = "\n\n".join(system_parts)
    system: str | list[dict] = system_text
    chat = [dict(message) for message in chat]

    def blocks(text: str, prefix: int) -> list[dict]:
        if 0 < prefix < len(text):
            return [{"type": "text", "text": text[:prefix]}, {"type": "text", "text": text[prefix:]}]
        return [{"type": "text", "text": text}]

    first = chat[0] if chat and chat[0]["role"] == "user" else None
    first_prefix = getattr(first["content"], "cache_prefix", 0) if first else 0
    system_prefix = getattr(system_parts[0], "cache_prefix", 0) if len(system_parts) == 1 else 0
    if first is not None and 0 < first_prefix < len(first["content"]) and (
        len(system_text) + first_prefix >= PROMPT_CACHE_MIN_CHARS
    ):
        pieces = blocks(first["content"], first_prefix)
        pieces[0]["cache_control"] = marker
        first["content"] = pieces
    elif system_text:
        cut = system_prefix if 0 < system_prefix < len(system_text) else len(system_text)
        if cut >= PROMPT_CACHE_MIN_CHARS:
            pieces = blocks(system_text, cut)
            pieces[0]["cache_control"] = marker
            system = pieces

    if chat:
        last = chat[-1]
        content = last["content"]
        if isinstance(content, str) and content.strip():
            last["content"] = [{"type": "text", "text": str(content), "cache_control": marker}]
        elif isinstance(content, list) and content and content[-1].get("text", "").strip():
            content[-1] = dict(content[-1], cache_control=marker)
    return system, chat


def _token_count(value) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        return None
    return value


def normalize_usage(provider: str, usage) -> dict:
    """Map a provider's usage object to one shape; None means "not reported".

    Fields: input_total (all input tokens, cached or not), cached_read (input
    served from the provider's cache), cache_write (input newly written to it),
    and output. A missing field is None, never 0, so an unreported count is not
    mistaken for a cache miss.
    """

    usage = usage if isinstance(usage, dict) else {}
    output = _token_count(usage.get("output_tokens", usage.get("completion_tokens")))
    if provider == "anthropic":
        # Claude's input_tokens excludes cached tokens; the total adds them back.
        base = _token_count(usage.get("input_tokens"))
        write = _token_count(usage.get("cache_creation_input_tokens"))
        read = _token_count(usage.get("cache_read_input_tokens"))
        total = None if base is None else base + (write or 0) + (read or 0)
        return {"input_total": total, "cached_read": read, "cache_write": write, "output": output}
    details = usage.get("prompt_tokens_details") or usage.get("input_tokens_details")
    details = details if isinstance(details, dict) else {}
    hit = _token_count(usage.get("prompt_cache_hit_tokens"))  # DeepSeek
    miss = _token_count(usage.get("prompt_cache_miss_tokens"))
    cached = hit if hit is not None else _token_count(details.get("cached_tokens"))
    total = _token_count(usage.get("prompt_tokens", usage.get("input_tokens")))
    if total is None and hit is not None and miss is not None:
        total = hit + miss
    return {
        "input_total": total,
        "cached_read": cached,
        "cache_write": _token_count(details.get("cache_write_tokens")),
        "output": output,
    }


USAGE_FIELDS = ("input_total", "cached_read", "cache_write", "output")


def format_usage(normalized: dict) -> str:
    """Render normalized usage, or "" when the provider reported nothing."""

    if all(normalized.get(name) is None for name in USAGE_FIELDS):
        return ""
    labels = {"input_total": "input", "cached_read": "cached", "cache_write": "cache_write", "output": "output"}
    return ", ".join(
        f"{labels[name]}={'unknown' if normalized.get(name) is None else normalized[name]}"
        for name in USAGE_FIELDS
    )


class UsageTotals:
    """Running totals of normalized usage; a field stays None until reported."""

    def __init__(self):
        self.values = dict.fromkeys(USAGE_FIELDS)
        self.turns = 0

    def add(self, normalized: dict) -> None:
        self.turns += 1
        for name in USAGE_FIELDS:
            value = normalized.get(name)
            if value is not None:
                self.values[name] = (self.values[name] or 0) + value


