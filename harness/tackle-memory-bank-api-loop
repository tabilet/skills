                # Only the earlier or final iteration's own verdict word is
                # history; whatever else the row says is still read.
                rest = rest[verdict.end():]
                cells = ['']
            text = ' '.join(cells + [rest]).strip()
            return bool(text) and (adverse_review_wording(text, final_iteration, True, True)
                                   or unrecognized_review_sentence(text, True))
        def task_row_conflict(line):
            # A task row's notes are task evidence, but an explicit milestone
            # review reversal or a conflicting review counter in them is not.
            cells = [cell.strip() for cell in line.strip().strip('|').split('|')]
            text = ' '.join(cell for cell in cells if not re.fullmatch(r'`?\[[ +~!xX-]\]`?', cell))
            plain = _without_format_characters(_TASK_REVIEW.sub('task check', text))
            if counter_conflict(text):
                return True
            if not _MILESTONE_REVIEW_SUBJECT.search(plain):
                return False
            if (adverse_review_wording(plain, final_iteration)
                    or any(not _negated(plain[:found.start()]) for found in _ANY_ADVERSE.finditer(plain))):
                return True
            if not any(re.fullmatch(form, plain.strip(' .'), re.I) for form in RECOGNIZED_REVIEW_SENTENCES):
