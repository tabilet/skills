class ProjectLockUnavailable(Exception):
    """Another Tabilet launcher already owns this project's execution lock."""


class ProjectLockError(OSError):
    """The shared project lock could not be prepared safely."""


@contextlib.contextmanager
def project_lock(repo: pathlib.Path):
    """Hold the shared per-project lock used by Tabilet launchers."""

    if fcntl is None:
        raise ProjectLockError("the shared project lock needs POSIX file locking, which this platform lacks")
    try:
        canonical = pathlib.Path(repo).expanduser().resolve(strict=True)
        state_home = pathlib.Path(os.environ.get("XDG_STATE_HOME", "~/.local/state")).expanduser()
        if not state_home.is_absolute():
            raise ValueError("XDG_STATE_HOME must be an absolute path")
        lock_dir = state_home / "tabilet" / "locks"
        lock_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        if lock_dir.is_symlink() or not lock_dir.is_dir():
            raise OSError(f"unsafe project lock directory: {lock_dir}")
        os.chmod(lock_dir, 0o700)
        key = hashlib.sha256(os.fsencode(str(canonical))).hexdigest()
        lock_path = lock_dir / f"{key}.lock"
        flags = os.O_CREAT | os.O_RDWR
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(lock_path, flags, 0o600)
    except (OSError, ValueError) as exc:
        # Everything above is lock infrastructure, not project state: a
        # read-only or missing HOME, a misconfigured XDG_STATE_HOME, or an
        # unsafe lock path. Give it its own exception so callers can map it to
        # a clean, documented exit instead of an unhandled traceback, without
        # also catching genuine errors raised later from inside the run itself.
        raise ProjectLockError(f"cannot prepare the shared project lock: {exc}") from exc
    try:
        lock_stat = os.fstat(descriptor)
        if not stat.S_ISREG(lock_stat.st_mode):
            raise ProjectLockError(f"project lock is not a regular file: {lock_path}")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ProjectLockUnavailable(str(lock_path)) from exc
        try:
            yield lock_path
        finally:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
    finally:
        os.close(descriptor)


