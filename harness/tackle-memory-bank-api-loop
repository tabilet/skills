def _git_local_raw(
    args: list[str],
    cwd: pathlib.Path,
    timeout: int = 30,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    executable = shutil.which("git")
    if not executable:
        raise OSError("Git executable not found")
    command = [executable]
    for value in _SAFE_GIT_CONFIG:
        command.extend(("-c", value))
    excludes_file = _global_excludes_file()
    if excludes_file is not None:
        command.extend(("-c", f"core.excludesFile={excludes_file}"))
    for override in _identity_config(str(pathlib.Path(cwd).resolve())):
        command.extend(("-c", override))
    # Scope ownership trust to exactly the repository this call targets, rather
    # than depending on the user's global safe.directory (which GIT_CONFIG_GLOBAL
    # below hides anyway). This is what lets a repo owned by another uid inside a
    # container -- a normal case for the sandboxed executor -- pass Git's
    # dubious-ownership check without granting trust to any other repository.
    command.extend(("-c", f"safe.directory={pathlib.Path(cwd).resolve()}"))
    command.append("--no-pager")
    if args and args[0] in {"diff", "log", "show"}:
        tail = args[1:]
        if "--" in tail:
            separator = tail.index("--")
            tail = [*tail[:separator], "--no-ext-diff", "--no-textconv", "--", *tail[separator + 1:]]
        else:
            tail = [*tail, "--no-ext-diff", "--no-textconv"]
        command.extend((args[0], *tail))
    else:
        command.extend(args)
    return subprocess.run(
        command,
        cwd=str(cwd),
        input=input_text,
        text=True,
        encoding="utf-8",
        errors="surrogateescape",
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        env=_git_environment(),
    )


def _git_index_paths(
    repo: pathlib.Path, pathspecs: list[str] | None = None, *, include_ignored: bool = False,
) -> list[str]:
    options_list = [["ls-files", "-z", "--cached", "--others", "--exclude-standard"]]
    if include_ignored:
        # Enumerating every ignored path requires Git to walk into ignored
        # directories it would otherwise prune, which is slow in a repo with a
        # large node_modules/ or .venv/. It is only needed to catch a targeted
        # `git add -f -- <path>` on a path that is both ignored and covered by
        # a local filter; a whole-repo status/diff never runs a filter on an
        # ignored path (it is not tracked and not being added), so callers
        # only set this for an explicit, narrow pathspec, not the whole tree.
        options_list.append(["ls-files", "-z", "--others", "--ignored", "--exclude-standard"])
    paths = []
    for options in options_list:
        proc = _git_local_raw(options + (["--", *pathspecs] if pathspecs else []), repo)
        if proc.returncode:
            raise UnsafeGitConfiguration(proc.stderr.strip() or "unable to inspect Git path inventory")
        paths.extend(value for value in proc.stdout.split("\0") if value)
    return list(dict.fromkeys(paths))


def _active_custom_filters(repo: pathlib.Path, paths: list[str]) -> list[str]:
    if not paths:
        return []
    attributes = _git_local_raw(
        ["check-attr", "-z", "filter", "--stdin"],
        repo,
        input_text="\0".join(paths) + "\0",
    )
    if attributes.returncode:
        raise UnsafeGitConfiguration(attributes.stderr.strip() or "unable to inspect Git attributes")
    fields = attributes.stdout.split("\0")
    drivers = set()
    for index in range(0, len(fields) - 2, 3):
        _, attribute, value = fields[index:index + 3]
        if attribute == "filter" and value not in {"unspecified", "unset", ""}:
            drivers.add(value)

    active = []
    for driver in sorted(drivers):
        for operation in ("clean", "process"):
            config = _git_local_raw(
                ["config", "--includes", "--null", "--get-all",
                 f"filter.{driver}.{operation}"],
                repo,
            )
            if config.returncode not in {0, 1}:
                raise UnsafeGitConfiguration(
                    config.stderr.strip() or "unable to inspect local Git filter configuration"
                )
            if config.returncode == 0 and any(value.strip() for value in config.stdout.split("\0")):
                active.append(f"filter.{driver}.{operation}")
    return active


def git_local(
    args: list[str],
    cwd: pathlib.Path,
    timeout: int = 30,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    """Run a host Git command with hooks, helpers, paging, and signing disabled."""

    if not args or args[0] not in _HOST_GIT_COMMANDS:
        raise UnsafeGitConfiguration("host Git wrapper accepts only its allowlisted built-in commands")
    if args[0] == "commit" and any(
        value == "-S" or value.startswith("-S") or value.startswith("--gpg-sign")
        for value in args[1:]
    ):
        raise UnsafeGitConfiguration("explicit Git signing options are unsupported for host commands")
    if args[0] in {"add", "commit"} and any(value in {"-i", "--interactive", "-p", "--patch"} for value in args[1:]):
        raise UnsafeGitConfiguration("interactive Git staging and commit modes are unsupported for host commands")
    if args[0] in {"show", "log"} and any(value.startswith("--show-signature") for value in args[1:]):
        raise UnsafeGitConfiguration("Git signature verification is unsupported for host commands")
    if args and args[0] in {"add", "diff", "status"}:
        separator = args.index("--") if "--" in args else len(args)
        requested_paths = [value for value in args[separator + 1:] if value] if separator < len(args) else []
        # Git status itself may invoke clean filters while comparing worktree
        # files. Inventory and inspect every path first without calling status.
        candidate_paths = _git_index_paths(cwd)
        if requested_paths:
            # A targeted call (typically `add -f`) can touch a specific path
            # that is both ignored and filtered; check ignored paths only
            # within that narrow, explicit set, not the whole working tree.
            candidate_paths.extend(_git_index_paths(cwd, requested_paths, include_ignored=True))
        candidate_paths.extend(requested_paths)
        active = _active_custom_filters(cwd, candidate_paths)
        if active:
            raise UnsafeGitConfiguration(
                "active custom clean/process filters are unsupported for host Git staging: "
                + ", ".join(active)
            )
    return _git_local_raw(args, cwd, timeout, input_text)


def tool_environment(extra_names: list[str]) -> dict[str, str]:
    """Return a deliberately small environment for model-controlled commands.

    This reduces accidental credential disclosure; it is not process isolation.
    An acknowledged host shell can still read files and inspect the host by other
    means, which is why actionable runs require an explicit opt-in.
    """

    allowed = set(DEFAULT_TOOL_ENV)
    allowed.update(name for name in os.environ if name.startswith("LC_"))
    allowed.update(extra_names)
    allowed -= PROVIDER_SECRET_ENV
    return {name: os.environ[name] for name in allowed if name in os.environ}


def _as_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return value


def _truncate_text(value: str, budget: int, label: str) -> str:
    if len(value) <= budget:
        return value
    marker = f"\n...[{label} truncated]...\n"
    if budget <= len(marker):
        return marker[:budget]
    remaining = budget - len(marker)
    head = (remaining + 1) // 2
    tail = remaining // 2
    return value[:head] + marker + (value[-tail:] if tail else "")


def bounded_output(stdout: str, stderr: str, max_output: int) -> tuple[str, str, bool]:
    """Bound the combined returned streams while preserving both when possible."""

    combined = len(stdout) + len(stderr)
    if combined <= max_output:
        return stdout, stderr, False
    if not stdout:
        return "", _truncate_text(stderr, max_output, "stderr"), True
    if not stderr:
        return _truncate_text(stdout, max_output, "stdout"), "", True

    stdout_budget = max(1, max_output * len(stdout) // combined)
    stderr_budget = max_output - stdout_budget
    if stderr_budget == 0:
        stdout_budget -= 1
        stderr_budget = 1
    return (
        _truncate_text(stdout, stdout_budget, "stdout"),
        _truncate_text(stderr, stderr_budget, "stderr"),
        True,
    )


def shell_tool(
    repo: pathlib.Path,
    cmd: str,
    timeout: int,
    max_output: int,
    allow_dangerous: bool,
    env: dict[str, str] | None = None,
) -> dict:
    if not allow_dangerous and DANGEROUS_RE.search(cmd):
        return {
            "exit_code": 126,
            "stdout": "",
            "stderr": "Command rejected by harness guardrail. Set ALLOW_DANGEROUS_COMMANDS=1 to override.",
            "truncated": False,
        }

    try:
        proc = subprocess.Popen(
            ["bash", "-c", cmd],
            cwd=str(repo),
            stdin=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            errors="replace",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env if env is not None else tool_environment([]),
            start_new_session=True,
        )
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
            exit_code = proc.returncode
        except subprocess.TimeoutExpired as first_timeout:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                stdout, stderr = proc.communicate(timeout=5)
            except subprocess.TimeoutExpired as second_timeout:
                # A descendant can escape the process group while retaining a
                # pipe. Do not let that defeat the harness timeout.
                stdout = second_timeout.output or first_timeout.output or ""
                stderr = second_timeout.stderr or first_timeout.stderr or ""
                for pipe in (proc.stdout, proc.stderr):
                    if pipe is not None:
                        pipe.close()
                try:
                    proc.kill()
                except ProcessLookupError:
                    pass
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    pass
            exit_code = 124
            stderr = _as_text(stderr) + f"\nCommand timed out after {timeout}s."
        stdout, stderr, truncated = bounded_output(
            _as_text(stdout), _as_text(stderr), max_output
        )
        return {
            "exit_code": exit_code,
            "stdout": stdout,
            "stderr": stderr,
            "truncated": truncated,
        }
    except OSError as exc:
        return {
            "exit_code": 127,
            "stdout": "",
            "stderr": f"Unable to launch shell command: {exc}",
            "truncated": False,
        }


# Root IDs remain compatible; children share one sequence across both kinds.
ROOT_ID = r"[A-Z](?:0[1-9]|[1-9][0-9]+)"
MILESTONE_ID = ROOT_ID + r"(?:-(?:0[1-9]|[1-9][0-9]))?"
STATUS_NAME = re.compile(
    r"(?:(?=status-" + ROOT_ID + r"\.md$)|"
    r"(?=(?:amend|option)-" + ROOT_ID + r"-(?:0[1-9]|[1-9][0-9])\.md$))"
    r"(?:status|amend|option)-(" + MILESTONE_ID + r")\.md$"
)


def status_identity(name: str) -> str:
    match = STATUS_NAME.fullmatch(name)
    if not match:
        raise ValueError("invalid status filename: " + name)
    return match[1]


def declared_status_files(directory: pathlib.Path) -> list[pathlib.Path]:
    return sorted(p for p in directory.glob("*.md")
                  if p.name.startswith(("status-", "amend-", "option-")))


def milestone_path(repo: pathlib.Path, identity: str) -> pathlib.Path:
    matches = [p for p in status_files(repo) if status_identity(p.name) == identity]
    if len(matches) != 1:
        raise ValueError("missing or ambiguous active milestone: " + identity)
    return matches[0]


def approved_status_path(milestone: dict) -> str:
    identity = milestone.get("id")
    matches = [p for p in milestone.get("closure_paths", [])
               if isinstance(p, str) and pathlib.PurePosixPath(p).parent == pathlib.PurePosixPath("tabilet/memory-bank")
               and STATUS_NAME.fullmatch(pathlib.PurePosixPath(p).name)
               and status_identity(pathlib.PurePosixPath(p).name) == identity]
    if len(matches) != 1:
        raise ValueError("closure scope omits or duplicates its status file: " + str(identity))
    return matches[0]


def family_metadata(documents: dict) -> tuple[dict, list[str]]:
    families, problems = {}, []
    for name, document in documents.items():
        identity = status_identity(name)
        kind = name.split("-", 1)[0]
        parent = identity.split("-", 1)[0] if kind != "status" else None
        if identity in families:
            problems.append("duplicate milestone identity across file kinds: " + identity)
        families[identity] = {"kind": kind, "parent": parent, "file": name}
        if parent:
            declared = [m[1] for _, line in unfenced_lines(document)
                        if (m := re.fullmatch(r"(?:Parent:|\*\*Parent:\*\*)\s+(\S+)\s*", line))]
            if declared != [parent]:
                problems.append("child must declare exactly Parent: " + parent + " in " + name)
    for identity, family in families.items():
        if family["parent"] and family["parent"] not in families:
            problems.append("orphan child milestone: " + identity)
    return families, problems


def milestone_reference_ids(text: str) -> set[str]:
    """Resolve bare IDs and IDs inside local record filenames/Markdown links."""
    return set(re.findall(r"(?<![A-Za-z0-9_])" + MILESTONE_ID + r"(?![A-Za-z0-9_-])", text))


def amendment_owners(identity: str, families: dict, records: dict, seen=frozenset()) -> set[str]:
    """Resolve required ownership, keeping disposition separate from delivery."""
    if identity in seen:
        raise ValueError('cyclic amendment supersession: ' + identity)
    family = families.get(identity)
    if not family:
        raise ValueError('missing amendment successor: ' + identity)
    record = records.get(family['file'])
    if not record or record['metadata']['Outcome'] == 'completed':
        return {identity}
    metadata = record['metadata']
    if metadata['Outcome'] == 'cancelled':
        return set() if family['kind'] == 'amend' else {identity}
    targets = milestone_reference_ids(metadata['Successor'])
    if len(targets) != 1:
        raise ValueError('ambiguous amendment successor: ' + identity)
    successor = next(iter(targets))
    target = families.get(successor)
    if not target:
        raise ValueError('missing amendment successor: ' + identity)
    if target['kind'] == 'option':
        return set()  # Explicit owner reclassification; parent acceptance remains.
    return amendment_owners(successor, families, records, seen | {identity})


def review_passed(document: str) -> bool:
    values = [m[1] for _, line in unfenced_lines(document)
              if (m := re.fullmatch(r"\*\*Review gate\.\*\* (.+)", line.strip()))]
    return values == ['passed']


def retained_source(original: str, retained: str, selected: tuple | None = None) -> bool:
    """Preserve source lines in order, allowing only the selected task row to change."""
    skipped = None
    if selected:
        occurrence = 0
        for row in status_rows(original):
            if row['item'] == selected[1]:
                occurrence += 1
                if occurrence == selected[2]:
                    skipped = row['line']
                    break
    remaining = iter(retained.splitlines())
    return all(number == skipped or any(value == line for value in remaining)
               for number, line in enumerate(original.splitlines(), 1))


def status_files(repo: pathlib.Path) -> list[pathlib.Path]:
    return [p for p in declared_status_files(repo / "tabilet" / "memory-bank")
            if STATUS_NAME.fullmatch(p.name)]


def _table_cells(line: str) -> list[str]:
    """Split a Markdown table row, honoring escaped pipe characters."""

    cells = []
    current = []
    index = 0
    while index < len(line):
        char = line[index]
        if char == "\\" and index + 1 < len(line) and line[index + 1] == "|":
            current.append("|")
            index += 2
            continue
        if char == "|":
            cells.append("".join(current).strip())
            current = []
        else:
            current.append(char)
        index += 1
    cells.append("".join(current).strip())
    if cells and not cells[0]:
        cells.pop(0)
    if cells and not cells[-1]:
        cells.pop()
    return cells


def _scan_fences(text: str):
    """Yield (line number, de-indented line, indent, inside-or-marker) for each line."""
    fence_char = ""
    fence_length = 0
    for line_number, line in enumerate(text.splitlines(), 1):
        stripped = line.lstrip(" ")
        indent = len(line) - len(stripped)
        fence = re.match(r"(`{3,}|~{3,})", stripped) if indent <= 3 else None
        if fence:
            token = fence.group(1)
            if not fence_char:
                fence_char = token[0]
                fence_length = len(token)
            elif (token[0] == fence_char and len(token) >= fence_length
                  and not stripped[len(token):].strip()):
                fence_char = ""
                fence_length = 0
            yield line_number, stripped, indent, True
            continue
        yield line_number, stripped, indent, bool(fence_char)


def unfenced_lines(text: str):
    """Yield source lines outside fenced blocks, retaining their line numbers."""
    for line_number, stripped, indent, fenced in _scan_fences(text):
        if not fenced and indent <= 3:
            yield line_number, stripped


def code_line_numbers(text: str) -> set[int]:
    """Line numbers of fenced and indented code, which readers skip without ending a paragraph's context."""
    return {line_number for line_number, _, indent, fenced in _scan_fences(text) if fenced or indent > 3}


def fenced_line_numbers(text: str) -> set[int]:
    """Line numbers of fence markers and fenced content, which readers ignore."""
    return {line_number for line_number, _, _, fenced in _scan_fences(text) if fenced}


def table_rows(text: str) -> list[dict]:
    rows = []
    for line_number, stripped in unfenced_lines(text):
        if not stripped.startswith("|"):
            continue
        cells = _table_cells(stripped)
        if len(cells) < 2:
            continue
        rows.append({"cells": cells, "line": line_number})
    return rows


def status_table_rows(status: str):
    """Exclude review-iteration tables, whose State is not a task marker."""
    in_review_table = False
    previous_line = 0
    for row in table_rows(status):
        if row["line"] != previous_line + 1:
            in_review_table = False
        previous_line = row["line"]
        cells = row["cells"]
        if cells[1].lower() == "state":
            in_review_table = cells[0].lower() == "iteration"
        elif [cell.lower() for cell in cells] == ['#', 'finding', 'severity', 'disposition']:
            in_review_table = True
        if not in_review_table:
            yield row


def status_rows(status: str) -> list[dict]:
    """Read state-bearing rows from Markdown tables outside fenced blocks."""
    rows = []
    for row in status_table_rows(status):
        cells = row["cells"]
        state = STATE_MARKERS.get(cells[1])
        if state:
            rows.append(
                {
                    "item": cells[0],
                    "state": state,
                    "cells": cells,
                    "line": row["line"],
                }
            )
    return rows


def actionable_rows(status: str) -> list[dict]:
    return [row for row in status_rows(status) if row["state"] in ACTIONABLE_STATES]


def blocked_rows(status: str) -> list[dict]:
    return [row for row in status_rows(status) if row["state"] == "blocked"]


def status_marker_problems(status: str) -> list[str]:
    """Reject malformed state cells without interpreting unrelated prose tables."""
    problems = []
    in_task_table = False
    previous_line = 0
    for row in status_table_rows(status):
        cells = row["cells"]
        if row["line"] != previous_line + 1:
            in_task_table = False
        previous_line = row["line"]
        state = cells[1]
        if state.lower() == "state":
            in_task_table = True
            continue
        if all(re.fullmatch(r":?-+:?", cell) for cell in cells):
            continue
        # Full task tables validate every state cell, including blank/textual
        # states. Headerless rows with a task-shaped marker are checked too.
        if (in_task_table or re.search(r"\[[^\]]*\]", state)) and state not in STATE_MARKERS:
            problems.append(f"line {row['line']}: unknown or non-backticked state marker")
    return problems


def fenced_document(section: str) -> str:
    """Unwrap one literal Markdown document without interpreting its headings."""
    lines = section.strip().splitlines(keepends=True)
    opening = re.fullmatch(r"(`{3,}|~{3,})markdown", lines[0].strip()) if lines else None
    if not opening or len(lines) < 3:
        raise ValueError("expected one fenced markdown document")
    fence = opening.group(1)
    closing = re.compile(re.escape(fence[0]) + "{" + str(len(fence)) + r",}\s*")
    if not closing.fullmatch(lines[-1]) or any(closing.fullmatch(line) for line in lines[1:-1]):
        raise ValueError("document fence closes early or is missing")
    return "".join(lines[1:-1])


def retired_record(text: str, name: str, *, allow_unfinished: bool = False,
                   historical: bool = False) -> dict:
    """Validate the portable retirement envelope; original documents stay literal."""
    if not STATUS_NAME.fullmatch(name):
        raise ValueError("invalid retired status ID or child suffix")
    milestone_id = status_identity(name)
    lines = text.splitlines(keepends=True)
    headings = [(n, line[3:]) for n, line in unfenced_lines(text) if line.startswith("## ")]
    if historical:
        aliases = {"Status", "Status document", "Full status document", "Final status"}
        headings = [(n, "Status record" if title in aliases else title) for n, title in headings]
    if [title for _, title in headings] != ["Milestone specification", "Status record"]:
        raise ValueError("expected Milestone specification and Status record sections")
    metadata = {}
    for _, line in unfenced_lines("".join(lines[:headings[0][0] - 1])):
        match = re.fullmatch(r"\*\*([\w ]+)\.\*\* (.+)", line)
        if match:
            key, value = match.groups()
            if key in metadata:
                raise ValueError(f"duplicate retirement field: {key}")
            metadata[key] = value.strip()
    required = (
        "Milestone", "Outcome", "Retired", "Source status", "Source specification",
        "Evidence", "Worktree", "Review", "Review iterations", "Verification", "Consolidated into",
    )
    if any(not metadata.get(key) for key in required):
        raise ValueError("missing retirement metadata")
    if metadata["Milestone"] != milestone_id:
        raise ValueError("retired milestone ID does not match its filename")
    if metadata["Source status"] not in {f"tabilet/memory-bank/{name}", f"memory-bank/{name}"}:
        raise ValueError("source status path does not match the retired ID")
    if not (re.fullmatch(r"(?:tabilet/)?memory-bank/milestone\.md#\S+", metadata["Source specification"])
            or (not name.startswith("status-") and metadata["Source specification"] == f"tabilet/memory-bank/{name}")):
        raise ValueError("missing original milestone specification anchor")
    if metadata["Outcome"] not in {"completed", "cancelled", "superseded"}:
        raise ValueError("invalid retirement outcome")
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", metadata["Retired"]):
        raise ValueError("retirement date must use YYYY-MM-DD")
    datetime.date.fromisoformat(metadata["Retired"])
    if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64}|unversioned)", metadata["Evidence"]):
        raise ValueError("evidence must be a full commit or unversioned")
    if metadata["Worktree"] not in {"clean", "includes uncommitted changes", "unversioned"}:
        raise ValueError("invalid worktree provenance")
    if (metadata["Evidence"] == "unversioned") != (metadata["Worktree"] == "unversioned"):
        raise ValueError("inconsistent unversioned provenance")
    specification = fenced_document("".join(lines[headings[0][0]:headings[1][0] - 1]))
    status = fenced_document("".join(lines[headings[1][0]:]))
    rowless_disposition = (name.startswith('option-') and metadata['Outcome'] in {'cancelled','superseded'}
                           and not status_rows(status))
    if rowless_disposition and metadata['Review'] == 'not applicable' and metadata['Review iterations'] == '0':
        pass
    elif metadata["Review"] == "legacy":
        # A milestone closed before the persisted review gate records no count;
        # it must say so rather than invent one, and only completed work qualifies.
        if (metadata["Review iterations"] != "not recorded" or not metadata.get("Legacy closure")
                or metadata["Outcome"] != "completed"):
            raise ValueError("legacy retirement requires a completed outcome, "
                             "'not recorded' iterations, and a Legacy closure note")
    else:
        # Historical interactive goals may have a human-approved review ceiling.
        # This is record validation, never authority to extend API execution.
        review_limit = metadata.get("Review limit", "10")
        if not re.fullmatch(r"[1-9][0-9]*", review_limit):
            raise ValueError("retirement review limit must be a positive integer")
        if int(review_limit) > 10 and not metadata.get("Review limit approval", "").strip():
            raise ValueError("retirement above the default review limit needs approval provenance")
        if (metadata["Review"] != "passed"
                or not re.fullmatch(r"[1-9][0-9]*", metadata["Review iterations"])
                or int(metadata["Review iterations"]) > int(review_limit)):
            raise ValueError("retirement requires a passed review within its recorded limit (default 10)")
    if metadata["Outcome"] != "completed" and not metadata.get("Disposition"):
        raise ValueError("cancellation or supersession needs its authorized disposition")
    if metadata["Outcome"] == "superseded" and not metadata.get("Successor"):
        raise ValueError("supersession needs its accepted successor")
    if not specification.strip() or not status.strip():
        raise ValueError("retired source documents are empty")
    spec_headings = [line for _, line in unfenced_lines(specification)
                     if re.match(r"^#{2,3} " if historical else r"^## ", line)]
    spec_pattern = (r"#{2,3} " if historical else r"## ") + re.escape(milestone_id) + r"(?:\s|$)"
    if (not spec_headings or (name.startswith("status-") and len(spec_headings) != 1)) or not re.match(
        spec_pattern, spec_headings[0]
    ):
        raise ValueError("retired specification does not match its milestone ID")
    rows = status_rows(status)
    if problems := status_marker_problems(status):
        raise ValueError("retired task has an " + "; ".join(problems))
    # Lookup may preserve inconsistent frozen evidence, with diagnostics. Every
    # execution/retirement gate uses the strict default and rejects it.
    if (not rows and not rowless_disposition) or (not allow_unfinished and any(
            row["state"] in {"pending", "in_progress", "blocked"} for row in rows)):
        raise ValueError("retired status must contain only closed task rows")
    for row in rows:
        if row["state"] == "historical" and not re.search(
            r"\bsuccessor\b\s*:?\s+\S", " ".join(row["cells"][2:]), re.I
        ):
            raise ValueError("closed-historical row has no named successor")
    return {"metadata": metadata, "specification": specification, "status": status}


HISTORY_CORRECTIONS = "tabilet/docs/history/corrections.json"
HISTORY_CORRECTIONS_SCHEMA = "tabilet.history-corrections/v1"
HISTORY_INPUT_LIMIT = 4 * 1024 * 1024


def _history_json_pairs(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate correction JSON key: " + key)
        result[key] = value
    return result


def history_corrections(text: str) -> dict:
    """Validate a declarative evidence manifest, never execution authority."""
    if len(text.encode('utf-8')) > HISTORY_INPUT_LIMIT:
        raise ValueError('history corrections exceed input limit')
    value = json.loads(text, object_pairs_hook=_history_json_pairs)
    if (not isinstance(value, dict) or set(value) != {'schema', 'records'}
            or value['schema'] != HISTORY_CORRECTIONS_SCHEMA
            or not isinstance(value['records'], list) or len(value['records']) > 10000):
        raise ValueError('invalid history correction manifest')
    found = {}
    fields = {'Milestone', 'Outcome', 'Retired', 'Source status', 'Source specification',
              'Evidence', 'Worktree', 'Review', 'Review iterations', 'Review limit',
              'Review limit approval', 'Verification', 'Consolidated into'}
    schemas = {
        'expand-evidence-commit': {'recorded', 'resolved'},
        'resolve-evidence-set': {'commits', 'evidence'},
        'identify-specification': {'heading', 'evidence'},
        'historical-successor': {'item', 'successor', 'evidence'},
        'recover-document': {'document', 'content', 'sha256', 'source'},
        'supply-metadata': {'field', 'value', 'evidence'},
        'blocker': {'message', 'evidence'},
    }
    for entry in value['records']:
        if not isinstance(entry, dict) or set(entry) != {'milestone_id', 'record_path', 'record_sha256', 'corrections'}:
            raise ValueError('invalid history correction entry fields')
        path = entry['record_path']
        if (not isinstance(path, str) or pathlib.PurePosixPath(path).parent != pathlib.PurePosixPath('tabilet/docs/history')
                or not STATUS_NAME.fullmatch(pathlib.PurePosixPath(path).name)
                or entry['milestone_id'] != status_identity(pathlib.PurePosixPath(path).name)
                or not isinstance(entry['record_sha256'], str)
                or not re.fullmatch(r'[a-f0-9]{64}', entry['record_sha256'])
                or not isinstance(entry['corrections'], list) or not entry['corrections']):
            raise ValueError('invalid history correction identity or hash')
        if path in found:
            raise ValueError('duplicate history correction record: ' + path)
        seen = set()
        for correction in entry['corrections']:
            if not isinstance(correction, dict):
                raise ValueError('invalid history correction operation')
            kind = correction.get('kind')
            if not isinstance(kind, str) or kind not in schemas or set(correction) != schemas[kind] | {'kind'}:
                raise ValueError('unsupported history correction: ' + str(kind))
            if kind == 'supply-metadata' and (not isinstance(correction['field'], str) or correction['field'] not in fields
                    or not isinstance(correction['value'], str) or not correction['value'].strip()
                    or '\n' in correction['value'] or '\r' in correction['value']):
                raise ValueError('unsupported metadata correction')
            if any(field in correction and not isinstance(correction[field], str) for field in ('field', 'document', 'item')):
                raise ValueError('invalid correction discriminator')
            key = (kind, correction.get('field', correction.get('document', correction.get('item', ''))))
            if key in seen:
                raise ValueError('duplicate or conflicting history correction')
            seen.add(key)
            if kind == 'expand-evidence-commit':
                if (not isinstance(correction['recorded'], str) or not re.fullmatch(r'[a-f0-9]{7,39}', correction['recorded'])
                        or not isinstance(correction['resolved'], str) or not re.fullmatch(r'[a-f0-9]{40}|[a-f0-9]{64}', correction['resolved'])
                        or not correction['resolved'].startswith(correction['recorded'])):
                    raise ValueError('invalid expanded evidence commit')
            elif kind == 'resolve-evidence-set':
                commits = correction['commits']
                if (not isinstance(commits, list) or not commits
                        or any(not isinstance(c, str) or not re.fullmatch(r'[a-f0-9]{40}|[a-f0-9]{64}', c) for c in commits)
                        or len(commits) != len(set(commits))):
                    raise ValueError('invalid evidence commit set')
            elif kind == 'recover-document':
                source = correction['source']
                if (correction['document'] not in {'specification', 'status'} or not isinstance(correction['content'], str)
                        or not isinstance(source, dict) or set(source) != {'commit', 'path', 'start_line', 'end_line', 'source_sha256'}
                        or not isinstance(source['commit'], str) or not re.fullmatch(r'[a-f0-9]{40}|[a-f0-9]{64}', source['commit'])
                        or not isinstance(source['path'], str)
                        or source['path'] not in {path, 'tabilet/memory-bank/milestone.md', 'tabilet/memory-bank/' + pathlib.PurePosixPath(path).name}
                        or type(source['start_line']) is not int or type(source['end_line']) is not int
                        or not 1 <= source['start_line'] <= source['end_line']
                        or not isinstance(source['source_sha256'], str) or not re.fullmatch(r'[a-f0-9]{64}', source['source_sha256'])
                        or correction['sha256'] != hashlib.sha256(correction['content'].encode('utf-8')).hexdigest()
                        or len(correction['content'].splitlines()) != source['end_line'] - source['start_line'] + 1):
                    raise ValueError('invalid recovered document or source hash')
            elif kind in {'identify-specification', 'historical-successor', 'blocker'}:
                if any(not isinstance(correction[field], str) or not correction[field].strip()
                       for field in schemas[kind] - {'evidence'}):
                    raise ValueError('invalid correction text')
            if 'evidence' in correction:
                evidence = correction['evidence']
                if not isinstance(evidence, list) or not evidence:
                    raise ValueError('missing correction evidence')
                for citation in evidence:
                    if (not isinstance(citation, dict) or set(citation) not in (
                            {'start_line', 'end_line', 'quote'},
                            {'start_line', 'end_line', 'quote', 'path', 'commit', 'content', 'sha256'})
                            or type(citation['start_line']) is not int or type(citation['end_line']) is not int
                            or not 1 <= citation['start_line'] <= citation['end_line']
                            or not isinstance(citation['quote'], str) or not citation['quote'].strip()):
                        raise ValueError('invalid correction evidence location')
                    if 'content' in citation:
                        if (not isinstance(citation['path'], str) or citation['path'] not in {'tabilet/docs/history/index.md', 'tabilet/memory-bank/milestone.md'}
                                or not isinstance(citation['commit'], str) or not re.fullmatch(r'[a-f0-9]{40}|[a-f0-9]{64}', citation['commit'])
                                or not isinstance(citation['content'], str)
                                or citation['sha256'] != hashlib.sha256(citation['content'].encode('utf-8')).hexdigest()
                                or len(citation['content'].splitlines()) != citation['end_line'] - citation['start_line'] + 1
                                or citation['quote'] not in citation['content']):
                            raise ValueError('invalid embedded correction evidence')
        if sum(key in seen for key in [('expand-evidence-commit', ''), ('resolve-evidence-set', ''),
                                      ('supply-metadata', 'Evidence')]) > 1:
            raise ValueError('conflicting evidence corrections')
        found[path] = entry
    return found


def read_history_corrections(repo: pathlib.Path) -> tuple[dict, str | None]:
    path = repo / HISTORY_CORRECTIONS
    if not path.exists() and not path.is_symlink():
        return {}, None
    # Opening the bounded regular file without following links also rejects FIFOs.
    for parent in (path, *path.parents):
        if parent == repo:
            break
        if parent.is_symlink():
            raise ValueError('symlink history corrections rejected')
    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0))
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise ValueError('history corrections must be a regular file')
    with os.fdopen(fd, 'rb') as stream:
        raw = stream.read(HISTORY_INPUT_LIMIT + 1)
    return history_corrections(raw.decode('utf-8')), hashlib.sha256(raw).hexdigest()


# Historical prose that the review-ambiguity scan reads as restating a recorded
# decision rather than qualifying it. Recognition is limited to these exact
# forms (see docs/history-corrections.md); any other free-form reference to a
# review result or approval stays ambiguous and blocks acceptance. They are
# collected here so the shared validator carries no unnamed one-record
# exceptions. `{id}`, `{iterations}` and `{limit}` are filled with
# re.escape()d values.
RECOGNIZED_PROSE = {
    'continuation_clause': (
        r'(?:,\s*retaining\s+the\s+existing\s+count\s+and\s+using\s+fresh\s+'
        r'[A-Za-z0-9/ -]+\s+reviews\s+until\s+it\s+passes,\s*then\s+resuming\s+the\s+ordered\s+goal)?'),
    'progress_row': (
        r'\|\s*{id} review iteration limit\s*\|\s*`\[\+\]`\s*\|\s*'
        r'Owner explicitly directed continued {id} review beyond ten, without resetting the counter, '
        r'until a clean review\.\s*\|'),
    'launch_refresh_note': r"The refreshed [A-Za-z0-9_-]+ launch reference after the owner's {id} review continuation",
    'marker_correction': (
        r'[0-9]{4}-[0-9]{2}-[0-9]{2}: the task rows were recorded `\[X\]` '
        r'\(Cancelled\) by mistake; they were completed and now read `\[\+\]`\.'),
    'reaffirmation': r'Whole-milestone review\s+{iterations}/{limit},\s*passed\.',
    'task_review_fail': r'Task review\s+[1-9][0-9]*/[1-9][0-9]*\s+FAIL\.',
    'standalone_intake': 'This is standalone intake, not a continuation of a retired closing gate.',
    'earlier_pending': (
        r'Tasks complete; [A-Za-z0-9.,– -]+ verified, whole-milestone review pending\. '
        r'Persisted review count 0/10(?: \(review intake does not start a gate\))?\.'),
    'retired_without_commits': (
        r'passed\s+\(no\s+P1/P2\);\s+retired\s+[0-9]{4}-[0-9]{2}-[0-9]{2}\.\s+'
        r'Goal run:\s+COMMIT_POLICY\s+none\s+\(owner choice\s+'
        r'[0-9]{4}-[0-9]{2}-[0-9]{2}\),\s+no commits\.'),
}


# Wording that reverses, withdraws or conditions a recorded review result.
# Mentioning a result establishes nothing about it, so a clause is adverse only
# when it names a review-result subject near a predicate that is not negated
# in its own clause and is not attached to an earlier iteration or to a failed
# test. Text that directly continues a recorded pass ("context") also takes a
# leading pronoun as that pass ("It is conditional on ..."). This is a
# vocabulary, not a parser, and only uncorrected records rely on it: a
# correction that supplies acceptance keeps the conservative rule that any
# unrecognized continuation blocks. See docs/history-corrections.md.
_ADVERSE_PHRASE = re.compile(
    r'\b(?:did\s+not\s+pass|not\s+(?:accepted|passed|valid|approved|complete\w*)|not\s+(?:the\s+)?review\s+pass(?:ed)?|'
    r'no\s+longer|rolled\s+back)\b', re.I)
_ADVERSE_STRONG = re.compile(
    r'\b(?:invalidat\w*|revok\w*|withdr(?:aw\w*|ew)|rescind\w*|overturn\w*|retract\w*|reopen\w*|'
    r'void(?:ed|s|ing)?|annul\w*|nullif\w*|set\s+aside)\b', re.I)
_TABLE_DELIMITER_CELL = re.compile(r':?-{2,}:?')
# A reversal word that blocks anywhere in an unrecognized clause about the
# review, however far it is from the subject.
_REVERSAL_ANYWHERE = re.compile(
    r'\b(?:invalidat\w*|revok\w*|withdr(?:aw\w*|ew)|rescind\w*|overturn\w*|retract\w*|reopen\w*|'
    r'void\w*|annul\w*|nullif\w*|set\s+aside|disregard\w*|discard\w*|struck|strike\w*)\b', re.I)
_ADVERSE_WEAK = re.compile(
    r'\b(?:fail(?:ed|s|ure|ures)?|revers\w*|reject\w*|supersed\w*|cancel\w*|contingent|conditional\w*|'
    r'provisional\w*|pending|subject\s+to|unresolved|disput\w*|incomplete|blocked|'
    r'provided(?:\s+that)?|unless|only\s+if|on\s+condition|depending\s+on|assuming|as\s+long\s+as)\b', re.I)
_ADVERSE_REVISED = re.compile(r'\b(?:changed|amended|revisit\w*)\b', re.I)
# The complete adverse vocabulary: reversals, adverse phrases and conditions.
_ANY_ADVERSE = re.compile('(?:' + '|'.join(p.pattern for p in (_REVERSAL_ANYWHERE, _ADVERSE_PHRASE, _ADVERSE_WEAK))
                          + ')', re.I)
# Words that take any complement: "Subject to further checks.", "Conditional on ...".
_COMPLEMENT_TAKING = re.compile(
    r'(?:subject\s+to|conditional\w*|contingent|provided(?:\s+that)?|unless|only\s+if|on\s+condition|'
    r'depending\s+on|assuming|as\s+long\s+as)$', re.I)
_RESULT_SUBJECT = re.compile(
    r'\b(?:review\w*|result\w*|verdict|outcome|decision|pass(?:ed)?|acceptance|approval|sign-?off)\b', re.I)
_REFERENCE_SUBJECT = re.compile(
    r'\b(?:it|this|that|these|those|they)\s+(?:(?:since|now|later|then|also|already|subsequently|'
    r'eventually|finally)\s+)?(?:has|have|had|was|were|is|are|been|got|became|'
    r'will|would|must|should|may|might|can|could)\b|'
    r'\b(?:this|that|these|those|its)\s+(?:review\s+)?(?:results?|verdicts?|outcomes?|decisions?|pass)\b|'
    r'\b(?:above|earlier|previous|prior|preceding)\b', re.I)
# A milestone-level review subject, after task-level reviews are set aside.
_MILESTONE_REVIEW_SUBJECT = re.compile(
    r'\breviews?\b|\b(?:the|this|that|its)\s+(?:review\s+)?(?:results?|verdicts?|outcomes?|decisions?|pass)\b', re.I)
_TASK_REVIEW = re.compile(
    r'\b(?:[A-Z][0-9]{2,}(?:\.[0-9]+)+\s+(?:task[- ]?)?|task[- ]?)reviews?\b(?:\s+[0-9]+)?', re.I)
# A clause with no subject of its own: "Voided.", "Subsequently annulled.",
# "Annulled by the owner." The reversal is the whole predicate, not an
# adjective ("Revoked credentials are rejected.").
_BARE_VERDICT = re.compile(
    r'\W*(?:(?:later|subsequently|then|afterwards?|eventually|finally|since|now)\W+)*'
    r'(?:(?:was|were|is|are|(?:has|had)\s+been|been)\s+)?(?=\w)', re.I)
_NOUN_SUBJECT = re.compile(r'\b(?:results?|verdict|outcome|decision|acceptance|approval|sign-?off)\b', re.I)
_NEGATION = re.compile(r'\b(?:no|not(?!\s+(?:only|just|merely|simply|solely)\b)|never|without|zero|0|none|'
                       r'neither|nor)\s+(?:\w+\s+){0,3}$', re.I)
_CLAUSE_BREAK = re.compile(r'\b(?:and|but|however|yet|although|though|instead|rather)\b|[,:]', re.I)
_EARLIER_FAILURE = re.compile(
    r'\b(?:(?:review|iteration)\s+(?:iteration\s+)?([1-9][0-9]*)(?:\s*/\s*[1-9][0-9]*)?\s*(?:[:,—–-]\s*|(?:was|is)\s+)?'
    r'fail(?:ed|ure)?|fail(?:ed|ure)?\s+(?:in|at|on)\s+(?:review\s+)?iteration\s+([1-9][0-9]*))\b', re.I)
_BENIGN_FAILURE = re.compile(
    r'\b(?:(?:failed|failing|failure)\s+(?:\w+\s+)?(?:tests?|builds?|commands?|assertions?|fixtures?|jobs?)|'
    r'(?:tests?|builds?|commands?|assertions?|fixtures?|jobs?)\s+(?:\w+\s+)?(?:failed|fails|failure|failing))\b', re.I)

# Directly after a recorded pass, a sentence about the review must be one of
# these restatements, references or findings summaries; anything else about it
# blocks, because a vocabulary of adverse words cannot list every reversal.
# Counters in them are checked separately against the record.
_REVIEW = r'(?:the\s+)?(?:ordinary\s+)?(?:whole(?:[- ]milestone)?\s+|closing\s+|final\s+|deep\s+)?review'
_COUNT = r'(?:\s+(?:iteration\s+)?[1-9][0-9]*(?:\s*/\s*[1-9][0-9]*)?)'
_NO_FINDINGS_BODY = (r'no\s+(?:open\s+)?(?:P1/P2(?:/P3)?|blocking)'
                     r'(?:\s+(?:or\s+higher(?:-severity)?\s+)?(?:findings?|issues?))?')
_NO_FINDINGS = r'(?:\s+with\s+' + _NO_FINDINGS_BODY + r'|\s*\(\s*' + _NO_FINDINGS_BODY + r'\s*\))?'
# Complete clauses about the review that restate, locate or summarize a pass.
# Each is matched against a whole clause: there are no free-text tails, so a
# qualification such as "but was annulled" can never ride inside one. Counters
# are checked separately against the record.
RECOGNIZED_REVIEW_SENTENCES = (
    _REVIEW + _COUNT + r'?\s+(?:passed|PASS(?:ED)?)(?:\s+(?:(?:in|at)\s+)?iteration\s*[1-9][0-9]*)?'
    + _COUNT + r'?' + _NO_FINDINGS,
    _REVIEW + r'\s+passed\s+(?:all\s+)?[0-9]+(?:\s*/\s*[0-9]+)?\s+(?:checks?|tests?|cases?|assertions?)',
    r'no\s+(?:further\s+)?(?:code\s+)?changes?\s+(?:was|were)\s+(?:required|needed|made)\s+after\s+'
    + _REVIEW + _COUNT + r'?\s+passed',
    r'no\s+(?:retired|earlier|prior|completed)\s+reviews?\s+(?:is|was|were|are)\s+reopened',
    r'accepted\s+after\s+' + _REVIEW + _COUNT + r'?(?:\s+passed)?(?:\s+on\s+[0-9]{4}-[0-9]{2}-[0-9]{2})?',
    _REVIEW + _COUNT,
    r'(?:the\s+)?(?:review\s+)?(?:results?|verdicts?|outcomes?|decisions?|logs?|findings?|notes?|records?)'
    r'\s+(?:is|are)\s+recorded\s+(?:below|above|here)',
    r'see\s+(?:the\s+)?(?:review\s+(?:log|notes|record)|' + _REVIEW[len(r'(?:the\s+)?'):] + _COUNT + r')\s+for\s+details',
    _REVIEW + r'\s+(?:found|reported)\s+no\s+(?:open\s+)?(?:P1/P2(?:/P3)?|P1|P2|blocking|defects?|issues?|findings?)'
    r'(?:\s+(?:or\s+higher(?:-severity)?\s+)?(?:findings?|issues?|defects?))?(?:\s+remaining)?',
    r'(?:review\s+)?findings?\s*:\s*none',
    r'no\s+(?:further\s+|extra\s+|additional\s+)?(?:code|asset|code/asset|source|documentation|docs|test)?'
    r'(?:\s+(?:or|and)\s+[a-z/]+)*\s*changes?(?:\s+or\s+expensive\s+runs?)?\s+followed\s+(?:the\s+)?review',
)
_OWN_REFERENCE = r'\b(?:our|ours|this|own|we|here|it|its)\b'
_REVIEW_MENTION = re.compile(
    r'\b(?:reviews?|results?|verdicts?|outcomes?|decisions?|acceptance|approval|sign-?off)\b|\bthe\s+pass\b', re.I)


# A pronoun subject (followed by a verb, or set off by punctuation), or a
# generic phrase. A conjunction ("tests verify that the grant was revoked") is
# not a subject.
_GENERIC_SUBJECT = re.compile(
    r'\b(?:it|this|that|these|those|they)\b(?=\s*[,(\u2014\u2013-]|\s+(?:(?:since|now|later|then|also|already|'
    r'subsequently|eventually|finally)\s+)?(?:has|have|had|was|were|is|are|been|got|became|will|would|must|'
    r'should|may|might|can|could)\b)|\b(?:same|whole\s+thing|everything|all\s+of\s+(?:it|this|that))\b', re.I)


def _without_format_characters(text: str) -> str:
    """Drop invisible format characters (soft hyphen, zero-width space) before reading words."""
    return ''.join(ch for ch in text if unicodedata.category(ch) != 'Cf')


def _adverse_predicate(text: str, vocabulary: re.Pattern = _REVERSAL_ANYWHERE) -> str | None:
    """'object' for "annulled this", 'subject' for "was annulled" or a clause-final verdict, else None."""
    kind = None
    for found in vocabulary.finditer(text):
        if _negated(text[:found.start()]):
            continue
        if re.match(r'\s+(?:it|this|that|them|these|those)\b', text[found.end():], re.I):
            return 'object'
        if (re.search(r'\b(?:was|were|is|are|been|being|be|got|gets?)\s+(?:\w+\s+){0,2}$', text[:found.start()], re.I)
                or re.fullmatch(r'\W*(?:(?:later|subsequently|again)|(?:by|on|after|at|in|following|per)\b.*)?\W*',
                                text[found.end():], re.I)):
            kind = 'subject'
    return kind


# A pronoun or result noun that is the subject of an adverse predicate: "it
# was pending", "the review is conditional on ...", "this has since been
# rejected". Weak words ("fails", "cancellation") elsewhere in technical prose
# are not verdicts.
_GOVERNED_ADVERSE = re.compile(
    r'\b(?:it|this|that|these|those|they|reviews?|results?|verdicts?|outcomes?|decisions?|pass|acceptance|approval)'
    r'(?:\s*,[^,;]{1,80},)?\s+(?:(?:since|now|still|later|then|also|already|subsequently|eventually|finally)\s+)?'
    r'(?:is|was|were|are|remains?|remained|became|becomes|(?:has|had|have)\s+(?:since\s+)?been)(?:\s*,[^,;]{1,80},)?\s+'
    r'(?:(?:now|still|later|then|also|already|subsequently|eventually|finally|deemed|considered|marked|found)\s+)?'
    r'(?:' + _ANY_ADVERSE.pattern + r')', re.I)


# Short claim values that state a positive result.
_POSITIVE_CLAIM = (r'(?:(?:all\s+)?(?:tests?|checks?|gates?)\s+)?(?:passed|pass|PASS|complete[d]?|accepted|approved|clean|done|'
                   r'ok|green|succeeded|verified|retired|closed|merged|completed\s+and\s+retired)')
# A clause that opens with a noun phrase names its own subject.
_NOUN_PHRASE_LEAD = re.compile(r'\W*(?:(?:the|a|an|all|every|each|no(?!\s+longer\b)|[A-Z][0-9]{2,})\b|`)', re.I)


def _bare_verdict(clause: str) -> bool:
    """A clause with no subject of its own, such as "Voided." or "Conditional on further checks."."""
    found = re.match(_BARE_VERDICT.pattern + r'(' + _ANY_ADVERSE.pattern + r')', clause, re.I)
    if not found:
        return False
    rest = clause[found.end():]
    if re.fullmatch(r'\W*|\s+\w+\W*|\s+(?:later|subsequently|again)\W*', rest, re.I) or _COMPLEMENT_TAKING.search(found[1]):
        return True
    # Only a reversal takes a free prepositional tail ("Annulled by the owner on
    # 2026-10-01."); "Cancellation at Git staging ..." is not a verdict.
    return bool(_REVERSAL_ANYWHERE.fullmatch(found[1])
                and re.match(r'\s+(?:by|on|upon|after|at|in|following|per|for|because|due)\b', rest, re.I))


def _affirmed_reversal(text: str) -> bool:
    """True when any reversal word in `text` is outside its own negation scope."""
    return any(not _negated(text[:found.start()]) for found in _REVERSAL_ANYWHERE.finditer(text))


def _printable_excerpt(text: str, limit: int = 160) -> str:
    """Escape control and format characters from a record, then cap the length."""
    escaped = ''.join(ch if ch.isprintable() else ascii(ch)[1:-1] for ch in text)
    return escaped if len(escaped) <= limit else escaped[:limit - 3] + '...'


def _negated(before: str) -> bool:
    """A negation counts only inside the clause that holds the predicate."""
    return bool(_NEGATION.search(_CLAUSE_BREAK.split(before)[-1]))


def adverse_review_wording(text: str, final: int | None = None, context: bool = False,
                           pronouns_near: bool = False) -> bool:
    """True when `text` reverses, withdraws or conditions a recorded review result.

    `context` marks text that follows a recorded pass, so a leading pronoun is
    that pass. `pronouns_near` marks text in the pass's own continuation, where a
    pronoun next to the predicate is the pass too. Wrapped lines are joined
    first, so a sentence split by a line break keeps its subject.
    """
    inherited = 'strong' if context else None
    text = _without_format_characters(text)
    for sentence in re.split(r'(?<=[.!?])\s+', ' '.join(text.split())):
        if final is not None:
            # "Review 1/10 FAIL" is history; a failure at the final or a later
            # iteration is a verdict on its own terms, whatever else is said.
            if any(not _negated(sentence[:m.start()]) and int(m[1] or m[2]) >= final
                   for m in _EARLIER_FAILURE.finditer(sentence)):
                return True
            sentence = _EARLIER_FAILURE.sub('', sentence)
        sentence = _BENIGN_FAILURE.sub('', sentence)
        for clause in sentence.split(';'):
            words = clause.split()
            if not words:
                continue
            lead = ' '.join(words[:5])
            for pattern, subjects in ((_ADVERSE_PHRASE, (_RESULT_SUBJECT,)),
                                      (_ADVERSE_STRONG, (_RESULT_SUBJECT, _REFERENCE_SUBJECT)),
                                      (_ADVERSE_WEAK, (_RESULT_SUBJECT,)),
                                      (_ADVERSE_REVISED, (_NOUN_SUBJECT,))):
                for found in pattern.finditer(clause):
                    before = clause[:found.start()]
                    if pattern is not _ADVERSE_PHRASE and _negated(before):
                        continue
                    nearby = ' '.join(before.split()[-6:] + clause[found.start():found.end()].split()
                                      + clause[found.end():].split()[:4])
                    if (any(subject.search(nearby) or subject.search(lead) for subject in subjects)
                            or (context and pattern is not _ADVERSE_REVISED
                                and (_REFERENCE_SUBJECT.search(' '.join(words[:3]))
                                     or (pronouns_near and _REFERENCE_SUBJECT.search(nearby))))
                            or (inherited and len(words) <= 4
                                and (inherited == 'any' or pattern is _ADVERSE_STRONG))):
                        return True
            # Only a bare subject phrase hands its subject to the next clause:
            # "The review result; withdrawn.", not "review 2/10 passed; retirement pending."
            inherited = ('any' if _RESULT_SUBJECT.search(lead) and len(words) <= 5 and not re.search(
                r'\b(?:was|is|are|were|has|have|had|pass(?:ed)?|fail(?:ed)?|completed|accepted)\b', clause, re.I)
                else None)
    return False


def historical_record(text: str, name: str, correction: dict | None = None) -> dict:
    """Read frozen evidence; literal documents and interpreted task cells stay separate."""
    if not STATUS_NAME.fullmatch(name):
        raise ValueError('invalid retired status ID')
    identity = status_identity(name)
    lines = text.splitlines(keepends=True)
    operations = correction['corrections'] if correction else []
    if correction:
        history_corrections(json.dumps({'schema': HISTORY_CORRECTIONS_SCHEMA, 'records': [correction]}))
        if (correction['record_path'] != 'tabilet/docs/history/' + name
                or correction['milestone_id'] != identity
                or correction['record_sha256'] != hashlib.sha256(text.encode('utf-8')).hexdigest()):
            raise ValueError('stale history correction hash or mismatched ID')
        for operation in operations:
            for citation in operation.get('evidence', []):
                if 'content' in citation:
                    continue
                if (citation['end_line'] > len(lines) or citation['quote'] not in
                        ''.join(lines[citation['start_line'] - 1:citation['end_line']])):
                    raise ValueError('correction evidence does not match frozen source')
    headings = [(n, line[3:]) for n, line in unfenced_lines(text) if line.startswith('## ')]
    metadata_end = headings[0][0] - 1 if headings else len(lines)
    envelope_unfenced = list(unfenced_lines(''.join(lines[:metadata_end])))
    metadata = {}
    for _, line in envelope_unfenced:
        match = re.fullmatch(r'\*\*([\w ]+)\.\*\* (.+)', line)
        if match:
            if match[1] in metadata:
                raise ValueError('duplicate retirement field: ' + match[1])
            metadata[match[1]] = match[2]
    literal_metadata = dict(metadata)
    documents, offsets, sources = {}, {}, {}
    aliases = {'Milestone specification': 'specification', 'Status record': 'status', 'Status': 'status',
               'Status document': 'status', 'Full status document': 'status', 'Final status': 'status',
               'Source status ledger': 'status'}
    recovery = {op['document']: op for op in operations if op['kind'] == 'recover-document'}
    for index, (number, title) in enumerate(headings):
        key = aliases.get(title)
        if key is None:
            if title == 'Related approved correction context':
                continue
            if set(recovery) == {'specification', 'status'}:
                continue
            raise ValueError('unsupported historical section: ' + title)
        if key in recovery:
            continue
        if key in documents:
            raise ValueError('ambiguous historical document: ' + key)
        end = headings[index + 1][0] - 1 if index + 1 < len(headings) else len(lines)
        section_lines = lines[number:end]
        opening = next((i for i, line in enumerate(section_lines) if line.strip()), None)
        if opening is None:
            raise ValueError('missing literal historical document')
        adapted = list(section_lines)
        if re.fullmatch(r'`{3,}|~{3,}', adapted[opening].strip()):
            adapted[opening] = adapted[opening].rstrip('\r\n') + 'markdown\n'
        documents[key] = fenced_document(''.join(adapted))
        offsets[key] = number + opening + 1
    for key, operation in recovery.items():
        documents[key] = operation['content']
        source = operation['source']
        sources[key] = source
        offsets[key] = source['start_line'] - 1
        if source['path'] == 'tabilet/docs/history/' + name:
            if (source['source_sha256'] != hashlib.sha256(text.encode('utf-8')).hexdigest()
                    or operation['content'] != ''.join(lines[source['start_line'] - 1:source['end_line']])):
                raise ValueError('recovered record excerpt differs from literal source')
    if 'status' in recovery:
        original_status = None
        for index, (number, title) in enumerate(headings):
            if aliases.get(title) != 'status':
                continue
            end = headings[index + 1][0] - 1 if index + 1 < len(headings) else len(lines)
            section = ''.join(lines[number:end]).strip()
            section = re.sub(r'\A(`{3,}|~{3,})\r?\n', r'\1markdown\n', section)
            try:
                original_status = fenced_document(section)
            except ValueError:
                continue
        if original_status is not None:
            if documents['status'] != original_status:
                raise ValueError('status recovery cannot change or discard the retained task document')
        else:
            source = recovery['status']['source']
            status_starts = [n for n, line in enumerate(lines, 1)
                             if re.match(r'^# (?:Status )?' + re.escape(identity) + r'(?:\s|$)', line)]
            start = status_starts[0] if len(status_starts) == 1 else 1
            end = len(lines) - 1 if lines and re.fullmatch(r'`{3,}|~{3,}', lines[-1].strip()) else len(lines)
            if (source['path'] != 'tabilet/docs/history/' + name or source['start_line'] != start
                    or source['end_line'] not in {end, len(lines)}):
                raise ValueError('status recovery must retain the complete frozen status evidence')
    if set(documents) != {'specification', 'status'}:
        raise ValueError('missing historical specification or status document')

    # When a retained status explicitly names its milestone or task IDs, they
    # must agree with the record identity. A hash binds bytes, not their owner.
    # Only well-formed milestone IDs count: "# Q4 results" or a legacy "M1.1"
    # row is not a claim about which milestone this record belongs to.
    status_unfenced = list(unfenced_lines(documents['status']))
    status_task_rows = status_rows(documents['status'])
    declaration = re.compile(r'^(?:\*\*(?:Milestone|Status ID)\.\*\*|'
                             r'\*\*(?:Milestone|Status ID):\*\*|(?:Milestone|Status ID):)\s*'
                             r'`?([A-Z][0-9]+(?:-[0-9]+)?)`?(?=\s|$|[.,;—:–-])', re.I)

    def other_identity(found):
        return found.upper() != identity and bool(re.fullmatch(MILESTONE_ID, found.upper()))

    for _, line in status_unfenced:
        heading = (re.match(r'^#\s+Status\s+([A-Z][0-9]+(?:-[0-9]+)?)(?=\s|$|[—:–-])', line, re.I)
                   or re.match(r'^#\s+([A-Z][0-9]+(?:-[0-9]+)?)(?=\s*$|\s*[—:–-])', line, re.I))
        if heading and other_identity(heading[1]):
            raise ValueError('historical status identity does not match the record')
        declared = declaration.match(line)
        if declared and declared[1].upper() != identity:
            raise ValueError('historical status identity does not match the record')
    for row in status_task_rows:
        item = row['item'].lstrip('`*_ ')
        task = re.match(r'^([A-Z][0-9]+(?:-[0-9]+)?)\.[0-9]+(?=\b|\s|[:—–-])', item, re.I)
        if task and other_identity(task[1]):
            raise ValueError('historical status task identity does not match the record')

    # Track heading context in the literal retained status. Examples, templates
    # and prospective instructions cannot become review evidence, even when
    # they happen to contain a correctly spelled standalone result.
    status_lines = {}
    task_section_lines = set()
    status_context = []
    for number, line in status_unfenced:
        heading = re.fullmatch(r'(#{1,6})\s+(.+?)(?:\s+#+)?\s*', line)
        if heading:
            level, title = len(heading[1]), heading[2].strip()
            while status_context and status_context[-1][0] >= level:
                status_context.pop()
            status_context.append((level, title))
            continue
        sections = [title for level, title in status_context if level >= 2]
        example = any(re.search(r'\b(?:examples?|samples?|templates?|propos(?:ed|al)|'
                                r'plan(?:ned)?|instructions?|guidance|draft|simulation|'
                                r'hypothetical|illustration|fictional|unverified|pending)\b', title, re.I)
                      for title in sections)
        reviews = [i for i, title in enumerate(sections) if re.fullmatch(
            r'(?:(?:whole[- ]milestone|whole|milestone)\s+)?'
            r'review(?:\s+(?:notes|and\s+(?:closure|retirement)))?', title, re.I)]
        in_review = (len(reviews) == 1 and all(re.fullmatch(
            r'(?:milestone|closure|milestone closure|milestone status)', title, re.I)
            for title in sections[:reviews[0]]) and all(re.fullmatch(
            r'(?:(?:review\s+)?iteration\s+[1-9][0-9]*(?:\s*\([^)]*\))?|'
            r'(?:review\s+)?(?:results?|outcome|conclusion))', title, re.I)
            for title in sections[reviews[0] + 1:]))
        status_lines[number] = (line, not example, in_review, not sections)
        if not example and len(sections) == 1 and sections[0].lower() == 'tasks':
            task_section_lines.add(number)

    def recorded_zero_defect_retirement_task(citation):
        # Recognize only a complete, unqualified historical retirement row.
        # Neither a completed task marker nor a generic review description is
        # sufficient: the literal row must explicitly record zero defects.
        if 'content' in citation or citation['start_line'] != citation['end_line']:
            return False
        source = sources.get('status')
        if source and source['path'] != 'tabilet/docs/history/' + name:
            return False
        number = citation['start_line'] - offsets['status']
        item = status_lines.get(number)
        if (number not in task_section_lines or not item or not item[1]
                or citation['quote'].strip() != item[0].strip()
                or citation['quote'].strip() != lines[citation['start_line'] - 1].strip()):
            return False
        tasks = status_rows(documents['status'])
        rows = [row for row in tasks if row['line'] == number]
        if len(rows) != 1 or rows[0]['state'] != 'completed' or len(rows[0]['cells']) != 3:
            return False
        # This legacy form has no separate review narrative: the whole-review
        # retirement row is the last substantive retained status evidence.
        # Unknown later prose or another review section stays ambiguous.
        if (not tasks or tasks[-1]['line'] != number
                or any(n > number and line.strip() for n, (line, trusted, _, _) in status_lines.items() if trusted)
                or any(in_review and trusted and line.strip()
                       for line, trusted, in_review, _ in status_lines.values())):
            return False
        row = rows[0]
        label = (re.escape(identity) + r'\.[1-9][0-9]*:\s*'
                 r'Deep code review\s*&\s*milestone retirement')
        gates = [task for task in tasks if task['line'] in task_section_lines
                 and re.fullmatch(label, task['item'], re.I)]
        if len(gates) != 1 or gates[0]['line'] != number:
            return False
        notes = row['cells'][2]
        match = re.fullmatch(
            r'Ran full verification suite \(([^\n()]+)\); deep code review performed with '
            r'0 defects remaining; retired ' + re.escape(identity) +
            r' to `tabilet/docs/history/' + re.escape(name) + r'`\.', notes, re.I)
        if not match or re.search(r'\b(?:fail(?:ed|ure)?|pending|not|unverified|unknown|'
                                  r'skipped|cancelled|incomplete)\b', match[1], re.I):
            return False
        return True

    def recorded_review_citation(citation):
        # Bind the literal quote to the record's own unfenced metadata or
        # retained status, never to a specification or an external excerpt.
        if 'content' in citation or citation['start_line'] != citation['end_line']:
            return None
        number = citation['start_line']
        quote = citation['quote'].strip()
        if number <= metadata_end:
            envelope = envelope_unfenced
            if any(n < number and re.match(r'^#{2,6}\s', line) for n, line in envelope):
                return None
            return 'envelope' if any(n == number and line.strip() == quote
                                     for n, line in envelope) else None
        source = sources.get('status')
        if source and source['path'] != 'tabilet/docs/history/' + name:
            return None
        item = status_lines.get(number - offsets['status'])
        if not item or item[0].strip() != quote or not item[1]:
            return None
        if item[2]:
            return 'review'
        return 'preamble' if item[3] else None

    def literal_record_citation(citation):
        # Unlike a one-line review result, some provenance evidence is a
        # multi-line quotation. Every cited line must be outside an inner fence
        # and in this record's metadata or complete retained status.
        if 'content' in citation:
            return False
        start, end = citation['start_line'], citation['end_line']
        if end <= metadata_end:
            envelope = envelope_unfenced
            if any(n < start and re.match(r'^#{2,6}\s', line) for n, line in envelope):
                return False
            allowed = {n for n, _ in envelope}
            return all(n in allowed for n in range(start, end + 1))
        source = sources.get('status')
        if start <= metadata_end or (source and source['path'] != 'tabilet/docs/history/' + name):
            return False
        return all((item := status_lines.get(n - offsets['status'])) and item[1]
                   for n in range(start, end + 1))

    def provenance_citation(citation):
        if not literal_record_citation(citation):
            return False
        if citation['end_line'] <= metadata_end:
            return True
        return all((item := status_lines.get(n - offsets['status'])) and (item[2] or item[3])
                   and not item[0].lstrip().startswith('|')
                   for n in range(citation['start_line'], citation['end_line'] + 1))

    def cited_index_row(citation):
        # The embedded historical index is an interpretation source, never
        # authority; bind its identity, outcome, date and link together.
        if (citation.get('path') != 'tabilet/docs/history/index.md'
                or citation['start_line'] != citation['end_line']
                or citation['quote'].strip() != citation['content'].strip()):
            return None
        rows = table_rows(citation['content'])
        if len(rows) != 1:
            return None
        cells = historical_index_cells(rows[0]['cells'])
        if len(cells) < 5 or cells[0] != identity or cells[3] != f'[{identity}]({name})':
            return None
        return cells

    def status_identifies_record():
        for _, line in status_unfenced:
            if re.match(r'^#\s+(?:Status\s+)?' + re.escape(identity) + r'(?=\s|$|[—:–-])', line):
                return True
            found = declaration.match(line)
            if found and found[1].upper() == identity:
                return True
        return any(re.match(r'^(?:[`*_ ]*)' + re.escape(identity) + r'\.[0-9]+\b', row['item'])
                   for row in status_task_rows)

    def specification_anchor_recorded(value):
        anchor = re.fullmatch(r'(?:tabilet/)?memory-bank/milestone\.md#([^\s]+)', value)
        if not anchor:
            return False
        fragment = anchor[1]
        for line, trusted, _, preamble in status_lines.values():
            if trusted and preamble and re.match(r'^(?:\*\*Specification[.:]\*\*|Specification\s*:)', line, re.I):
                if 'milestone.md#' + fragment in line:
                    return True
        for _, line in unfenced_lines(documents['specification']):
            if re.search(r'<a\s+id=["\']' + re.escape(fragment) + r'["\']\s*>', line, re.I):
                return True
            heading = re.fullmatch(r'#{2,3}\s+(.+?)\s*', line)
            if heading:
                slug = re.sub(r'[^\w\s-]', '', heading[1].lower())
                if re.sub(r'\s+', '-', slug.strip()) == fragment.lower():
                    return True
        return False

    def approval_is_negated(text, *, source=False):
        # "No P1/P2" describes review findings, not a denial of authority.
        text = re.sub(r'\bno\s+P[0-9]+(?:\s*/\s*P[0-9]+)*\b', '', text, flags=re.I)
        denied = (r'\b(?:no|none|not|never|declined|denied|refused|unapproved|'
                  r'unauthorized|unauthorised|revoked|rescinded|withdrawn|reversed|'
                  r'retracted|overturned|without|unless|zero)\b')
        prospective = r'\b(?:pending|proposed|conditional|if|but)\b'
        return bool(re.search(denied, text, re.I) or (source and re.search(prospective, text, re.I)))

    def approval_statement(text, *, literal=False):
        if approval_is_negated(text, source=True):
            return False
        quote = ' '.join(text.split())
        actor = r'(?:the\s+)?(?:owner|user|operator|human)\s+(?:(?:subsequently|explicitly)\s+)*(?:(?:has|had)\s+)?'
        verb = r'(?:approved|authorized|authorised)\s+(?:(?:the|an)\s+)?'
        review = r'(?:whole(?:[- ]milestone)?\s+)?review(?:\s+limit)?'
        action = (r'(?:' + review + r'\s+(?:extension|increase|continuation)|'
                  r'(?:extension|increase|continuation)\s+of\s+(?:(?:the|an)\s+)?' + review + r')')
        # Recognize complete affirmative statements, not an affirmative
        # substring that later prose can qualify or reverse.
        direct = actor + verb + action + r'(?:\s+to\s+(?P<approved_limit>[1-9][0-9]*))?\.?'
        interactive = actor + verb + r'interactive\s+launch\s+ceiling\s+(?P<launch_limit>[1-9][0-9]*)\.?'
        answer = (actor + r'(?:answered|said|replied)\s+(?P<yes_quote>["\'])yes(?P=yes_quote)\s+to\s+'
                  r'continu(?:e|ing)\s+' + re.escape(identity) + r'\s+beyond\s+(?:ten|10)\s+'
                  r'(?:whole(?:[- ]milestone)?\s+)?reviews?' + RECOGNIZED_PROSE['continuation_clause'] + r'\.?')
        prefix = r'(?:whole[- ]milestone\s+review\s+[0-9]+/[0-9]+\s+FAIL\.\s+)?'
        suffix = (r'(?:\s+No\s+P[0-9]+(?:\s*/\s*P[0-9]+)*\.?)?'
                  r'(?:\s+This\s+explicit\s+continuation\s+applies\s+to\s+'
                  + re.escape(identity) + r"'s\s+whole-review\s+limit;\s+other\s+scope,\s+"
                  r'verification\s+boundaries\s+and\s+action\s+grants\s+remain\s+unchanged\.)?')
        match = re.fullmatch(prefix + '(?:' + direct + '|' + interactive + '|' + answer + ')' + suffix, quote, re.I)
        if not match:
            return False
        if match['launch_limit'] and not literal:
            return False
        limit = next((op['value'] for op in operations if op['kind'] == 'supply-metadata'
                      and op['field'] == 'Review limit'), metadata.get('Review limit', '10'))
        stated_limit = match['approved_limit'] or match['launch_limit']
        return not stated_limit or stated_limit == limit

    def later_approval_reference(after):
        # `after` is a line of this record. Status lines are keyed by their own
        # document; an excerpt recovered from another document has no line
        # correspondence with this record, so all of it counts as later than
        # the envelope instead of being matched against this record's numbers.
        status_source = sources.get('status')
        foreign = bool(status_source and status_source['path'] != 'tabilet/docs/history/' + name)
        for number, item in status_lines.items():
            position = metadata_end + number if foreign else number + offsets['status']
            if position <= after or not item[1] or not (item[2] or item[3]):
                continue
            later = item[0].strip()
            # A retained progress row and a later launch-reference note
            # explicitly restate, rather than qualify, the continuation.
            restatement = (re.fullmatch(RECOGNIZED_PROSE['progress_row'].format(id=re.escape(identity)), later, re.I)
                           or re.fullmatch(RECOGNIZED_PROSE['launch_refresh_note'].format(id=re.escape(identity)),
                                           later, re.I))
            reference = re.search(r'\b(?:approval|decision|authori[sz]ation|authority|permission|'
                                  r'consent|agreement|directive|direction|owner|user|human|operator|'
                                  r'withdrawn|revoked|rescinded|reversed|retracted|overturned)\b|'
                                  r'\breview\b.{0,40}\b(?:continuation|extension|limit)\b', later, re.I)
            if reference and not restatement:
                return True
        return False

    def recorded_extension_approval(citation):
        if not provenance_citation(citation):
            return False
        start, end = citation['start_line'], citation['end_line']
        if citation['quote'].strip() != ''.join(lines[start - 1:end]).strip():
            return False
        if start > metadata_end + 1 and lines[start - 2].strip():
            if (not re.match(r'^Whole[- ]milestone\s+review\s+[0-9]+/[0-9]+\s+FAIL\.',
                             citation['quote'], re.I)
                    or not lines[start - 2].rstrip().endswith('.')
                    or approval_is_negated(lines[start - 2], source=True)):
                return False
        # Include subsequent lines of the same paragraph, so a citation cannot
        # hide a qualification immediately following its selected range.
        context = citation['quote']
        if end > metadata_end:
            for line in lines[end:]:
                if not line.strip() or re.match(r'^\s*(?:#{1,6}\s|\||`{3,}|~{3,})', line):
                    break
                context += ' ' + line.strip()
            # Later free-form references to this decision are ambiguous unless
            # they are part of the recognized affirmative paragraph above.
            # Do not infer their meaning from a list of denial synonyms.
            after = end
            while after < len(lines) and lines[after].strip() and not re.match(
                    r'^\s*(?:#{1,6}\s|\||`{3,}|~{3,})', lines[after]):
                after += 1
            if later_approval_reference(after):
                return False
        elif later_approval_reference(metadata_end):
            return False
        return approval_statement(context)

    index_outcomes = []
    for op in operations:
        if op['kind'] != 'supply-metadata':
            continue
        field, value = op['field'], op['value']
        evidence = op['evidence']
        if field in {'Milestone', 'Source status', 'Source specification'}:
            if (not status_identifies_record() or not any(re.search(
                    r'(?<![A-Za-z0-9])' + re.escape(identity) + r'(?![A-Za-z0-9])', c['quote'])
                    for c in evidence)):
                raise ValueError('unsupported ' + field + ' correction: missing recorded identity')
            if field == 'Source specification' and not specification_anchor_recorded(value):
                raise ValueError('unsupported Source specification correction: unrecorded anchor')
        elif field in {'Outcome', 'Retired'}:
            index_rows = [row for c in evidence if (row := cited_index_row(c))]
            supporting = [row for row in index_rows if row[1 if field == 'Outcome' else 2] == value]
            if not supporting:
                label = r'(?:Outcome|Status|State)' if field == 'Outcome' else r'Retired'
                local = False
                for c in evidence:
                    location = recorded_review_citation(c)
                    if location not in {'envelope', 'preamble'}:
                        continue
                    pattern = (r'(?:\*\*' + label + r'\.\*\*|\*\*' + label + r':\*\*|'
                               + label + r'\s*:)\s*(.+?)\.?')
                    match = re.fullmatch(pattern, c['quote'].strip(), re.I)
                    if match and (match[1].lower() == value.lower() or
                                  (field == 'Outcome' and value == 'completed' and match[1].lower() == 'complete')):
                        local = True
                        break
                if not local:
                    raise ValueError('unsupported ' + field + ' correction: missing recorded evidence')
            index_outcomes.extend(row[1] for row in supporting)
        elif field == 'Review iterations':
            counter = (r'(?:\*\*(?:Review gate iterations|Review iterations)\.\*\*|'
                       r'(?:Review gate iterations|Review iterations)\s*:)\s*'
                       r'(not recorded|0|[1-9][0-9]*)(?:\s+\([^\n()]*\))?\.?')
            if not any(recorded_review_citation(c) and
                       (match := re.fullmatch(counter, c['quote'].strip(), re.I)) and match[1].lower() == value.lower()
                       for c in evidence):
                raise ValueError('unsupported review counter correction: missing recorded evidence')
        elif field == 'Review' and value in {'legacy', 'not applicable'}:
            if not any(recorded_review_citation(c) and re.fullmatch(
                    r'(?:\*\*Review\.\*\*|Review\s*:)\s*' + re.escape(value) + r'\.?',
                    c['quote'].strip(), re.I) for c in evidence):
                raise ValueError('unsupported Review correction: missing recorded disposition')
        elif field == 'Review limit':
            if not re.fullmatch(r'[1-9][0-9]*', value) or not any(
                    provenance_citation(c) and re.search(
                        r'(?:\bwhole(?:[- ]milestone)?\s+review\s+' + re.escape(value) +
                        r'\s+(?:PASS|FAIL)\b|'
                        r'\breview\s+gate\s+iterations?\s*:\s*' + re.escape(value) + r'\b|'
                        r'(?:\*\*review limit\.\*\*|\breview limit\s*:)\s*' + re.escape(value) + r'\b)',
                        c['quote'], re.I) for c in evidence):
                raise ValueError('unsupported review limit correction: missing recorded evidence')
        elif field == 'Review limit approval':
            interpretation = re.fullmatch(
                r'Historical owner continuation recorded at frozen lines ([1-9][0-9]*)-([1-9][0-9]*); '
                r'ceiling ([1-9][0-9]*) is a proposed interpretation for this closed record only\.', value)
            recorded_limit = next((item['value'] for item in operations if item['kind'] == 'supply-metadata'
                                   and item['field'] == 'Review limit'), metadata.get('Review limit', '10'))
            supported_value = approval_statement(value) or (interpretation and
                interpretation[3] == recorded_limit and int(interpretation[2]) <= len(lines) and any(
                    int(interpretation[1]) <= c['start_line'] <= c['end_line'] <= int(interpretation[2])
                    for c in evidence))
            if not supported_value or not any(recorded_extension_approval(c) for c in evidence):
                raise ValueError('unsupported review limit approval: missing recorded human approval')
        elif field == 'Evidence':
            def commit_support(citation):
                if not provenance_citation(citation):
                    return False
                quote = citation['quote']
                if value == 'unversioned':
                    return bool(re.fullmatch(r'(?:\*\*Evidence\.\*\*|Evidence\s*:)\s*unversioned\.?',
                                             quote.strip(), re.I))
                prefixes = re.findall(r'(?<![a-f0-9])([a-f0-9]{7,64})(?![a-f0-9])', quote)
                return (bool(re.search(r'\b(?:evidence|worktree|observed\s+(?:head|commit)|'
                                       r'reviewed\s+(?:commit|baseline|worktree))\b', quote, re.I))
                        and any(value.startswith(prefix) for prefix in prefixes))
            if not any(commit_support(c) for c in evidence):
                raise ValueError('unsupported Evidence correction: missing recorded commit provenance')
        elif field == 'Worktree':
            if not any(recorded_review_citation(c) and re.fullmatch(
                    r'(?:\*\*Worktree\.\*\*|Worktree\s*:)\s*' + re.escape(value) + r'\.?',
                    c['quote'].strip(), re.I) for c in evidence):
                raise ValueError('unsupported Worktree correction: missing recorded provenance')
        elif field == 'Verification':
            quotes = [c['quote'].strip() for c in evidence if literal_record_citation(c)]
            content = value.removeprefix('Recorded results: ').strip()
            def verification_source(quote):
                subject = re.search(r'\b(?:tests?|testing|checks?|build|vet|lint|audit|race|'
                                    r'typecheck|smoke|regression|replay|suite|go)\b', quote, re.I)
                result = re.search(r'\b(?:pass(?:ed|ing)?|succeed(?:ed|s)?|verified|clean)\b', quote, re.I)
                standalone = re.fullmatch(r'(?:\*\*Verification\.\*\*|Verification\s*:)\s*'
                                          r'(?:passed|pass)\.?', quote, re.I)
                return bool((subject and result) or standalone)
            direct = any(content == quote and verification_source(quote) for quote in quotes)
            clauses = [part.strip().rstrip('.') for part in content.split('; ')]
            excerpts = all(part and any(part in quote and verification_source(quote) for quote in quotes)
                           for part in clauses)
            negative = any(re.search(r'\b(?:fail(?:ed|ure|ures)?|not passed|not passing|not run|'
                                     r'not executed|not verified|unverified|did not|no tests|pending|'
                                     r'incomplete|in progress|unknown|cancelled|skipped|timed out)\b', quote, re.I)
                           for quote in quotes)
            if negative or not (direct or excerpts):
                raise ValueError('unsupported Verification correction: missing recorded results')
        elif field == 'Consolidated into':
            if not any(recorded_review_citation(c) and re.fullmatch(
                    r'(?:\*\*Consolidated into\.\*\*|Consolidated into\s*:)\s*' + re.escape(value) + r'\.?',
                    c['quote'].strip(), re.I) for c in evidence):
                raise ValueError('unsupported consolidation correction: missing recorded evidence')

    numbered_review_results = []
    zero_defect_task_pass = False
    corrected_pass = False
    for op in operations:
        if op['kind'] == 'supply-metadata':
            field, value = op['field'], op['value']
            old = metadata.get(field)
            if old and old != value and not (field == 'Review iterations' and re.match(re.escape(value) + r'\s+\(', old)):
                raise ValueError('conflicting metadata correction: ' + field)
            if field == 'Review' and value == 'passed':
                accepted = False
                for citation in op['evidence']:
                    quote = citation['quote'].strip()
                    if recorded_zero_defect_retirement_task(citation):
                        zero_defect_task_pass = True
                        accepted = True
                        break
                    location = recorded_review_citation(citation)
                    if not location or quote != lines[citation['start_line'] - 1].strip():
                        continue
                    if re.fullmatch(r'(?:\*\*Review\.\*\*\s*|Review\s*:\s*|Review\s+)passed\.?|'
