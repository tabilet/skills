            # is about that milestone, unless it also points back at this one.
            lead = re.match(r'\W*(?:the\s+)?(?:[A-Za-z][\w-]*:)?([A-Z][0-9]{2,})\b', clause)
            return bool(lead and lead[1].upper() != identity and re.fullmatch(MILESTONE_ID, lead[1].upper())
                        and not names_own_id(clause)
                        and not re.search(_OWN_REFERENCE, clause, re.I)
                        and not re.search(r'\b(?:compared|versus|vs|than|unlike)\b', clause, re.I))
        def counter_conflict(text):
            # Any review or iteration counter in the text, in either word order,
            # must agree with the record: a pass at another iteration or limit,
            # or an iteration beyond the final one, conflicts. An earlier
            # iteration may be cited or may have failed. A ratio that is not
            # attached to a review ("all 12/12 checks") is not a counter.
            for found in re.finditer(r'\b(review|iteration|passed|pass)\s+(?:(?:iteration|passed)\s+)?([1-9][0-9]*)'
                                     r'(?:\s*/\s*([1-9][0-9]*))?(?!\s*/|\d)\b' + unit_nouns, text, re.I):
                before = text[:found.start()]
