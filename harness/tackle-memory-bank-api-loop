                                                 current Claude models reject it.
              LLM_PROMPT_CACHE                   Claude cache markers: 'auto' (default; official
                                                 Anthropic host only), 'on', or 'off'. OpenAI and
                                                 DeepSeek cache automatically and need no marker.
              LLM_PROMPT_CACHE_TTL               Claude cache lifetime: '5m' (default) or '1h'.
              TOOL_ENV_ALLOW                     Comma-separated extra variables for shell tools.
              LLM_ENVIRONMENT                    Environment policy: 'dangerous', 'sandbox' (default), or 'least'.
              ALLOW_UNSANDBOXED_SHELL=1          Acknowledge model-controlled host shell access.
              ALLOW_DANGEROUS_COMMANDS=1         Disable the command guardrail.
              TABILET_AUDIT_CAPTURE             'metadata' (default) or 'relevant'.
              TABILET_AUDIT_ARCHIVES            Obsolete; new snapshot capture is deferred.
            """
        ),
    )
    parser.add_argument("repo", nargs="?", default=".", help="Repository path. Default: current directory.")
    parser.add_argument("--provider", default=os.environ.get("LLM_PROVIDER", "openai"), choices=["openai", "anthropic"])
    parser.add_argument("--model", default=os.environ.get("LLM_MODEL") or os.environ.get("OPENAI_MODEL"))
    parser.add_argument("--api-base", default=os.environ.get("LLM_API_BASE") or os.environ.get("OPENAI_BASE_URL") or "")
    parser.add_argument("--api-key", default="")
    parser.add_argument("--max-runs", type=positive_int, default=os.environ.get("MAX_RUNS", "20"))
    parser.add_argument("--max-turns", type=positive_int, default=os.environ.get("MAX_TURNS", "60"))
    parser.add_argument("--tool-timeout", type=positive_int, default=os.environ.get("TOOL_TIMEOUT", "300"))
    parser.add_argument("--max-tool-output", type=positive_int, default=os.environ.get("MAX_TOOL_OUTPUT", "24000"))
    parser.add_argument("--max-tokens", type=positive_int, default=os.environ.get("LLM_MAX_TOKENS", "16000"))
    parser.add_argument("--api-timeout", type=positive_int, default=os.environ.get("LLM_API_TIMEOUT", "600"))
    parser.add_argument("--max-retries", type=nonnegative_int, default=os.environ.get("LLM_MAX_RETRIES", "2"))
    parser.add_argument("--max-history-chars", type=positive_int, default=os.environ.get("MAX_HISTORY_CHARS", "500000"))
    env_temp = os.environ.get("LLM_TEMPERATURE")
    parser.add_argument("--temperature", type=temperature_value, default=env_temp)
    parser.add_argument("--tool-env-allow", type=environment_names, default=os.environ.get("TOOL_ENV_ALLOW", ""))
    parser.add_argument(
        "--allow-unsandboxed-shell",
        action="store_true",
        default=os.environ.get("ALLOW_UNSANDBOXED_SHELL") == "1",
    )
    parser.add_argument("--allow-dangerous", action="store_true", default=os.environ.get("ALLOW_DANGEROUS_COMMANDS") == "1")
    parser.add_argument(
        "--environment",
        choices=["dangerous", "sandbox", "least"],
        default=os.environ.get("LLM_ENVIRONMENT", "sandbox"),
        help="Execution environment policy: dangerous (auto-acknowledges host shell), sandbox (default), or least (strict sandboxing).",
    )
    parser.add_argument(
        "--audit-capture",
        choices=["metadata", "relevant"],
        default=os.environ.get("TABILET_AUDIT_CAPTURE", "metadata"),
        help="Message capture mode when auditing is enabled.",
    )
    parser.add_argument(
        "--audit-archives",
        action="store_true",
        default=os.environ.get("TABILET_AUDIT_ARCHIVES") == "1",
        help="Obsolete: use tabilet-audit index sync for current Markdown lookup.",
    )
    args = parser.parse_args(argv)
    if args.environment == "dangerous":
        args.allow_unsandboxed_shell = True
    if args.audit_archives:
        parser.error("New snapshot capture is deferred; use tabilet-audit index sync PROJECT.")
    if args.audit_capture not in {"metadata", "relevant"}:
        parser.error("TABILET_AUDIT_CAPTURE must be metadata or relevant")

    if args.provider not in {"openai", "anthropic"}:
        parser.error("LLM_PROVIDER must be 'openai' or 'anthropic'")
    try:
        prompt_cache_policy(args.provider, args.api_base or "")
    except ValueError as exc:
        parser.error(str(exc))

    if not args.api_base:
        args.api_base = (
            "https://api.anthropic.com/v1" if args.provider == "anthropic" else "https://api.openai.com/v1"
        )
    if not args.api_key:
        if args.provider == "anthropic":
            args.api_key = os.environ.get("LLM_API_KEY") or os.environ.get("ANTHROPIC_API_KEY") or ""
        else:
            args.api_key = os.environ.get("LLM_API_KEY") or os.environ.get("OPENAI_API_KEY") or ""
    args.tool_env = tool_environment(args.tool_env_allow)

    return args


def main() -> None:
    args = parse_args()
    if not args.model:
        fail("Set LLM_MODEL or pass --model.", 2)

    repo = pathlib.Path(args.repo).expanduser().resolve()
    legacy = any((repo / name).exists() or (repo / name).is_symlink() for name in
                 ("GOAL.md", "memory-bank", "evolution", "docs/history"))
    docs = repo / "docs"
    legacy = legacy or (docs.is_dir() and any(docs.glob("archive-[A-Z][0-9][0-9].md")))
    if legacy:
        fail("v1.5.0 or mixed project layout detected. Preview and apply the explicit migration with "
             "skills/memory-bank-upgrade/migrate-v1.5-to-v2.py PROJECT before running v2.", 11)
    if not (repo / "AGENTS.md").is_file():
        fail(f"AGENTS.md not found in {repo}", 10)
    if not (repo / "tabilet" / "memory-bank").is_dir():
        fail(f"tabilet/memory-bank/ not found in {repo}", 11)
    if not (repo / "tabilet" / "memory-bank" / "milestone.md").is_file():
        fail(f"tabilet/memory-bank/milestone.md not found in {repo}", 11)
    if not status_files(repo) and not (repo / "tabilet" / "docs" / "history" / "index.md").is_file():
        fail(
            f"No status lane files matching tabilet/memory-bank/{STATUS_GLOB} in {repo}.\n"
            "Status files are named tabilet/memory-bank/status-<LANE><NN>.md, such as\n"
            "status-M01.md or status-A02.md. See tabilet/memory-bank/milestone.md for the\n"
            "status ID pattern.",
            11,
        )
    root_proc = git_local(["rev-parse", "--show-toplevel"], repo)
    if root_proc.returncode != 0:
        fail(f"{repo} is not inside a git worktree.", 12)
    git_root = pathlib.Path(root_proc.stdout.strip()).resolve()
    if git_root != repo:
        fail(f"Target must be the git worktree root: got {repo}, expected {git_root}", 12)

    try:
        with project_lock(repo):
            run_locked_loop(args, repo)
    except ProjectLockUnavailable as exc:
        message = (
            "Another Tabilet launcher already holds the project lock; wait for it to "
            f"finish before starting a second run ({exc})."
        )
        fail(message, 19)
    except ProjectLockError as exc:
        fail(str(exc), 26)
    except UnsafeGitConfiguration as exc:
        fail(
            "Repository Git configuration is unsafe for host operations: "
            f"{exc}. Remove or disable the active local filter/attribute driver "
            "before running the harness.",
            27,
        )


def run_locked_loop(args: argparse.Namespace, repo: pathlib.Path) -> None:

    endpoint = "/messages" if args.provider == "anthropic" else "/chat/completions"
    print(f"Repo: {repo}")
    print(f"Provider: {args.provider}")
    print(f"Model: {args.model}")
    print(f"API: {args.api_base.rstrip('/')}{endpoint}")
    RUN_STATE.update(repo=repo, provider=args.provider, model=args.model)

    for run in range(1, args.max_runs + 1):
        try:
            before_rows = row_snapshot(repo)
        except (OSError, UnicodeError) as exc:
            fail(f"Unable to read required status/history state: {exc}", 11)
        state_problems = before_rows["history"]["problems"]
        if not before_rows["files"]:
            state_problems.append("no active status files or valid retired milestones")
        if state_problems:
            fail("Invalid memory-bank status/history state:\n  " + "\n  ".join(state_problems), 11)
        review_warnings = before_rows["history"]["warnings"]
        if run == 1 and review_warnings:
            records = len({warning.split(":", 1)[0] for warning in review_warnings})
            shown = review_warnings[:HISTORY_WARNINGS_SHOWN]
            more = len(review_warnings) - len(shown)
            print(f"Warning: {len(review_warnings)} review-wording warning(s) in {records} retired record(s) "
                  "need human review (not blocking):\n  " + "\n  ".join(shown)
                  + (f"\n  ... and {more} more; `tabilet-audit index status` and `tabilet status` list them all."
                     if more else ""), file=sys.stderr)
        summary = lane_summary(repo)
        in_progress_rows = rows_in_state(repo, "in_progress")
        if len(in_progress_rows) > 1:
            detail = ", ".join(
                f"tabilet/memory-bank/{row['file']}:{row['line']}" for row in in_progress_rows
            )
            fail(
                "More than one general memory-bank row is in progress. Retain exactly "
                f"one `[~]` row before launching: {detail}",
                15,
            )
        in_progress = in_progress_rows[0] if in_progress_rows else None
        if in_progress and in_progress['file'].startswith('option-'):
            fail("An option task already owns the ledger; resume its explicitly approved controller or Goal request.", 15)
        actionable = sum(lane["actionable"] for lane in summary)
        blocked = sum(lane["blocked"] for lane in summary)
        blocked_lanes = [lane for lane in summary if lane["blocked"]]

        if not actionable:
            if blocked:
                audit = AuditRun(
                    args,
                    repo,
                    "next",
                    None,
                    "clean" if git_clean(repo) else "dirty",
                )
                audit.emit(
                    "run_blocked",
                    details={"reason": "only blocked memory-bank rows remain", "blocked": blocked},
                )
                audit.finish("blocked")
                print("Only blocked memory-bank rows remain. Stopping for human review.", file=sys.stderr)
                for lane in blocked_lanes:
                    print(f"  tabilet/memory-bank/{lane['file']}: {lane['blocked']} blocked row(s)", file=sys.stderr)
                raise SystemExit(3)
            print("No actionable memory-bank rows remain.")
            return
        if blocked:
            print(f"Warning: {blocked} blocked row(s) remain; continuing with actionable lanes.", file=sys.stderr)
            for lane in blocked_lanes:
                print(f"  tabilet/memory-bank/{lane['file']}: {lane['blocked']} blocked row(s)", file=sys.stderr)
        if args.environment == "least" and not (
            os.path.exists("/.dockerenv")
            or os.environ.get("TABILET_CONTAINER")
            or os.environ.get("ALLOW_LEAST_UNSANDBOXED") == "1"
        ):
            fail(
                "Least-privilege environment disallows unsandboxed host shell access. "
                "Run inside an isolated container or switch --environment.",
                14,
            )
        if not args.allow_unsandboxed_shell:
            fail(
                "Actionable work requires model-controlled host shell access. "
                "Re-run with --allow-unsandboxed-shell or "
                "ALLOW_UNSANDBOXED_SHELL=1, preferably inside a disposable sandbox.",
                14,
            )
        if run == 1:
            print(
                "WARNING: model commands are not sandboxed and can access host files "
                "and the network. The command denylist is only a guardrail.",
                file=sys.stderr,
            )
        if not git_clean(repo):
            print("Worktree is dirty before run. Stopping.", file=sys.stderr)
            print(git_status_short(repo), file=sys.stderr)
            raise SystemExit(4)

        before = git_head(repo)
        before_branch = git_branch(repo)
        RUN_STATE["before"] = RUN_STATE["before"] or before
        RUN_STATE["runs"] += 1
        audit = AuditRun(
            args,
            repo,
            "next",
            before,
            "clean" if git_clean(repo) else "dirty",
        )
        with audit:
            observed_subject = {}
            if in_progress:
                observed_subject = {
                    "milestone_id": status_identity(in_progress["file"]),
                    "task_label": in_progress["item"],
                    "status_path": f"tabilet/memory-bank/{in_progress['file']}",
                    "old_state": "in_progress",
                }
            audit.emit(
                "task_observed",
                subject=observed_subject,
                details={"summary": summary, "in_progress": in_progress,
                         "explorer": {"schema": "tabilet.audit.explorer/v1", "phase": "request",
                                      "artifact_refs": ([{"namespace": "task", "identifier": in_progress["item"],
                                                          "relationship": "observed", "path": f"tabilet/memory-bank/{in_progress['file']}"}]
                                                         if in_progress else [])}},
            )
            print(f"Run {run}/{args.max_runs}: asking LLM to tackle one row.")
            started = time.time()

            def observe_usage(normalized):
                RUN_STATE["totals"].add(normalized)
                audit.add_usage(normalized)

            try:
                run_result = one_agent_run(
                    args, repo, run, summary, in_progress, after_model_response=observe_usage,
                )
            except KeyboardInterrupt:
                audit.emit("run_interrupted", details={"reason": "keyboard interrupt"})
                audit.finish("interrupted")
                raise
            except SystemExit as exc:
                audit.emit("run_failed", details={"exit_code": exc.code})
                audit.finish("failed")
                raise
            audit.observe_commits()
            if isinstance(run_result, dict) and isinstance(run_result.get("final"), str):
                audit.message("assistant", run_result["final"], source="host", fidelity="exact")
            print(f"Run duration: {time.time() - started:.1f}s")

            try:
                after_rows = row_snapshot(repo)
            except (OSError, UnicodeError) as exc:
                fail(f"Unable to read status/history after the run: {exc}", 8)
            candidate = next(
                (
                    (key, before_rows["states"][key], after_rows["states"][key])
                    for key in before_rows["states"]
                    if before_rows["states"][key] != after_rows["states"].get(key)
                ),
                None,
            )
            transition = candidate
            transition_recorded = False
            if transition:
                RUN_STATE["transition"] = {"item": transition[0][1], "from": transition[1], "to": transition[2]}

            def record_transition():
                nonlocal transition_recorded
                if not transition or transition_recorded:
                    return
                key, old_state, new_state = transition
                audit.emit(
                    "task_transition",
                    subject={
                        "milestone_id": status_identity(key[0]),
                        "task_label": key[1],
                        "status_path": f"tabilet/memory-bank/{key[0]}",
                        "old_state": old_state,
                        "new_state": new_state,
                    },
                    details={"schema": "tabilet.audit.details/v1",
                             "explorer": {"schema": "tabilet.audit.explorer/v1", "phase": "applied",
                                          "artifact_refs": [{"namespace": "task", "identifier": key[1],
                                                              "relationship": "changed", "path": f"tabilet/memory-bank/{key[0]}",
                                                              "old_state": old_state, "new_state": new_state}]}},
                )
                transition_recorded = True

            gates = post_run_gates(
                repo,
                before,
                before_branch,
                before_rows,
                after_rows,
                in_progress["key"] if in_progress else None,
            )
            if gates["exit_code"] == 5:
                record_transition()
                audit.emit("verification_observed", details={"checks": ["git_clean"], "success": False})
                audit.emit("run_failed", details={"reason": "uncommitted changes after model run"})
                audit.finish("failed")
                print("LLM left uncommitted changes. Stopping.", file=sys.stderr)
                print(git_status_short(repo), file=sys.stderr)
                raise SystemExit(5)
            after = gates.get("after")
            if gates["exit_code"] == 6:
                audit.emit("verification_observed", details={"checks": ["new_commit"], "success": False})
                audit.emit("run_failed", details={"reason": "model made no commit"})
                audit.finish("failed")
                print("LLM made no commit. Stopping to avoid a spin loop.", file=sys.stderr)
                raise SystemExit(6)
            if gates["exit_code"] == 9:
                record_transition()
                audit.emit("verification_observed", details={"checks": ["commit_ancestry"], "success": False})
                audit.emit("run_failed", details={"reason": "history rewrite or branch change"})
                audit.finish("failed")
                print("LLM rewrote history or moved to another branch. Stopping.", file=sys.stderr)
                raise SystemExit(9)
            row_problems = gates["row_problems"]
            if row_problems:
                audit.emit(
                    "verification_observed",
                    details={"checks": ["row_transition"], "success": False, "problems": row_problems},
                )
                audit.emit("run_failed", details={"reason": "invalid row transition", "problems": row_problems})
                audit.finish("failed")
                print("LLM violated the one-row transition contract. Stopping.", file=sys.stderr)
                for problem in row_problems:
                    print(f"  {problem}", file=sys.stderr)
                raise SystemExit(8)
            record_transition()
            audit.emit(
                "verification_observed",
                details={"checks": ["git_clean", "commit_ancestry", "row_transition"], "success": True},
            )
            outcome = {"completed": "completed", "blocked": "blocked", "cancelled": "cancelled"}.get(transition[2], "unknown") if transition else "unknown"
            if transition and transition[2] == "historical":
                audit.emit("superseded", details={"notes": after_rows["cells"].get(transition[0], [])})
            audit.finish(outcome)
            if not status_files(repo):
                print("All milestones are retired. No actionable memory-bank rows remain.")
                return

    print(f"Reached MAX_RUNS={args.max_runs}. Stopping.")
    raise SystemExit(7)


if __name__ == "__main__":
    exit_code = 0
    try:
        main()
    except SystemExit as exc:
        exit_code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
        raise
    except KeyboardInterrupt:
        exit_code = 130
        raise SystemExit(130)
    except Exception as exc:
        exit_code = 1
        fail(f"Unexpected harness failure: {type(exc).__name__}: {exc}", 1)
    finally:
        write_run_report(exit_code)
