                tail = re.split(r'[.;](?:\s|$)', text[found.end():], maxsplit=1)[0]
                if names_other_milestone(before, re.split(r'[.;]\s', before)[-1] + found[0] + tail):
                    continue
                count, limit = int(found[2]), found[3]
                # Without a ratio only "review N" or "iteration N" is a counter:
                # "passed 2026-09-29" and "passed 20 times" are not, and neither
                # is a task-level review ("W25.1 review 4", "task-review 3").
                if not limit and (found[1].lower() in {'passed', 'pass'}
                                  or re.match(r'[-\d]|\s*times\b', text[found.end():], re.I)):
                    continue
                if re.search(r'(?:\btask[- ]|\b[A-Z][0-9]+\.[0-9]+\s+(?:task\s+)?)$', before, re.I):
                    continue
                if (limit and limit != recorded_limit) or count > final_iteration:
                    return True
                if count < final_iteration and (
                        found[1].lower() in {'passed', 'pass'} or re.search(r'\bpass', found[0], re.I)
                        or re.match(r'\s*(?:[:,—–-]\s*)?(?:(?:was|is)\s+)?pass', text[found.end():], re.I)):
                    return True
            return False
        def unrecognized_review_sentence(text, context=False, warn=True, claim=False, strict=False):
            # Validator for a literal record's pass continuation and claim
            # fields. Every clause's counters are checked first, and a conflict
            # blocks. A clause about the review, or one that refers back to it,
            # should be a recognized complete form; one that is not is reported
            # as a warning for human review, because real history is phrased too
            # variously for exact forms to be a gate. A correction-backed pass
            # never reaches this function: it blocks on any unrecognized prose.
            # In a pass's continuation the recorded pass is the subject from
            # the start, so "Later it was annulled." refers to it; a mention
            # stays the subject across later neutral sentences and paragraphs.
            # A claim field states the milestone's result, so the pass is its
            # implied subject for verdicts and predicates; loose pronouns there
